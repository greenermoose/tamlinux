#!/bin/bash

# tamlinux:summary=Scale text everywhere — the shell, GTK apps, and terminals
# tamlinux:args=[size|reset]
# tamlinux:examples=tam-display-text-size | tam-display-text-size 16 | tam-display-text-size reset

