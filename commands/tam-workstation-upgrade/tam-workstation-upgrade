#!/usr/bin/env python3
"""Upgrade a Tamlinux workstation to a released assembly from text login."""
from __future__ import annotations

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
CANDIDATES = (
    HERE,
    HERE.parent / "libexec/tam-workstation-upgrade",
)
for path in CANDIDATES:
    if (path / "cli.py").is_file():
        if str(path) not in sys.path:
            sys.path.insert(0, str(path))
        break
else:
    sys.stderr.write("tam-workstation-upgrade: cannot find cli.py beside the command or under libexec\n")
    sys.exit(1)

from cli import main

if __name__ == "__main__":
    sys.exit(main())
