#!/bin/bash

# tam-toggle-hybrid-gpu — switch a hybrid GPU laptop between dedicated and
# integrated mode through supergfxd, then reboot. Needs sudo.
#
# Ported from omarchy 4.0.4 (omarchy-toggle-hybrid-gpu) for plan 18 R4.15e.
# It installs through tam-pkg-add, reboots through tam-system-reboot, and
# copies the startup delay and sleep hook from ~/.config/tamlinux/hybrid-gpu/
# (ported; the sleep hook's run marker is renamed) instead of Omarchy's
# default/ tree.
#
