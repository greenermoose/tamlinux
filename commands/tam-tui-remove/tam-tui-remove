# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

set -e

ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps"
OLD_ICON_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications/icons"
DESKTOP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/applications/"

if (( $# == 0 )); then
  # Find all TUIs
  while IFS= read -r -d '' file; do
    if grep -qE '^Exec=.*(\$TERMINAL|xdg-terminal-exec).*-e' "$file"; then
      TUIS+=("$(basename "${file%.desktop}")")
    fi
  done < <(find "$DESKTOP_DIR" -name '*.desktop' -print0)

  if ((${#TUIS[@]})); then
    mapfile -t SORTED_TUIS < <(printf '%s\n' "${TUIS[@]}" | sort)
    APP_NAME=$(tam-menu-select "Select TUI to remove" "${SORTED_TUIS[@]}" -- --width 520 --maxheight 520)
  else
    echo "No TUIs to remove."
    exit 1
  fi
else
  APP_NAME="$*"
fi

if [[ -z $APP_NAME ]]; then
  echo "You must select a TUI to remove."
  exit 1
fi

[[ $APP_NAME != */* && $APP_NAME != . && $APP_NAME != .. && ! $APP_NAME =~ [[:cntrl:]] ]] || { echo "Invalid launcher name" >&2; exit 2; }
icon_name=$(printf '%s\n' "$APP_NAME" | tr '[:upper:]' '[:lower:]' | sed 's/[^[:alnum:]]\+/-/g; s/^-//; s/-$//')
tam-settings-preserve launcher-remove --file "$DESKTOP_DIR/$APP_NAME.desktop" >/dev/null || exit 1
rm -f -- "$DESKTOP_DIR/$APP_NAME.desktop"
rm -f "$ICON_DIR/$icon_name.png" "$ICON_DIR/$APP_NAME.png" "$OLD_ICON_DIR/$APP_NAME.png"
if [[ ${TAMLINUX_REMOVE_NOTIFY:-true} != "false" ]]; then
  tam-notification-send -g  "TUI removed" "$APP_NAME"
fi
