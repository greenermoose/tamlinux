#!/usr/bin/env python3
"""Deploy a recorded Tamlinux package assembly through Home Manager.

Test and Run install the same package at the same locations. A deployment
is a tamlinux-packages revision: its lock file pins every component.

status:       show the pinned assembly, what is installed and the generation.
preflight:    verify baseline, build the target and run registered read-only checks.
conflicts:    list unmanaged home files that a generation would overwrite.
reconcile:    plan a profile-only correction; execute with --digest HASH.
init [rev] [--test]:
              first installation from a recorded main (or --test) assembly.
              Works from a text login without Home Manager installed. Does
              not enable a display manager or start a graphical session.
test [rev]:   pin a tamlinux-packages revision on `test` (default: its head)
              in the configuration lock, switch Home Manager, verify the
              installed paths and commit the pin.
run [revision] [--untested]
              make an assembly the daily one and move it onto `main`.
              Without a revision, promote what is installed: a Test moves to
              `main` (no rebuild); a `main` commit is reported as already
              running. With a revision (any commit in the tamlinux-packages
              history), install it if it is not installed, then
              fast-forward `main` (and `test` for an untested commit). A
              commit only on `develop` or another branch is untested and needs
              --untested. Older `main` commits run without moving branches.
back:         activate the previous generation and restore its pin.
follow <rev>: install an accepted Run / main assembly on a follower host and
              record stage label `follow` (plan 47), never rewriting Test.
              An upgrade caller binds --transaction ID --expect-baseline SHA256.
recover <ID>: recover only that current transaction to its recorded baseline,
              using cached endpoint identities; never guess a previous version.

A registered host that has hosts/<host>/state/assembly (one revision) follows
that pin instead of the shared flake.lock; the consumer flake reads the same
file, so hosts on different versions never rewrite a shared lock.
"""
from __future__ import annotations

