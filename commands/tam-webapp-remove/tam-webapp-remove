#!/bin/bash

# tam-webapp-remove — remove a web app desktop launcher.
#
#   tam-webapp-remove [name]
#
# Ported from Omarchy 4.0.4 (omarchy-webapp-remove) for plan 18 R4.15h.
# Changed: one shared WEBAPP_EXEC pattern recognizes tam-launch-webapp and the
# inherited launchers alike, the scan uses that pattern, the picker and the
# toast go through tam-menu-select and tam-notification-send, and the opt-out is
# TAMLINUX_REMOVE_NOTIFY.
#
# Copyright (c) David Heinemeier Hansson
#
