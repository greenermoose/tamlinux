#!/bin/bash

# tam-brightness-display — show or adjust brightness on the focused display.
#
#   tam-brightness-display [--no-osd] [--monitor name] [+N%|N%-|N%|off|on]
#
# Ported from omarchy 4.0.4 (omarchy-brightness-display) for plan 18 R4.2;
# it shows the OSD through tam-osd, also for Apple displays.
#
