#!/bin/bash

# tam-sudo-passwordless — toggle passwordless sudo for you, for a few minutes.
#
#   tam-sudo-passwordless [MINUTES]     (default 15)
#
# Ported from Omarchy 4.0.4 (omarchy-sudo-passwordless) for plan 18 R4.15g.
# Changed: the bounded expiry timer and native boot cleanup use the owned
# tamlinux-nopasswd name. Native cleanup installation is a provider requirement.
#
