# Product defaults; UWSM subsequently loads the user's env and env.d choices.
for tamlinux_inherited_variable in "${!OMARCHY_@}"; do
  unset "$tamlinux_inherited_variable"
done
unset tamlinux_inherited_variable
export TERMINAL="${TERMINAL:-xdg-terminal-exec}"
# Discard only the inherited distribution default; explicit user choices stay.
# UWSM loads the user's env/env.d after this product default.
case ${EDITOR:-} in
  ''|'omarchy-launch-editor --inline') EDITOR='tam-launch-editor --inline' ;;
esac
export EDITOR
export TAMLINUX_SESSION=1
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM='wayland;xcb'
export GDK_BACKEND='wayland,x11,*'
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=wayland
# Hyprland 0.57 asks rtkit for realtime scheduling and can be SIGKILL'd by the
# kernel RT watchdog under load (hyprwm/Hyprland#16648). Keep it off until that
# is fixed. Set HYPRLAND_NO_RT=0 to opt back in (K47 / Omarchy cf71857c).
export HYPRLAND_NO_RT="${HYPRLAND_NO_RT:-1}"
