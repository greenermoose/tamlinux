#!/bin/bash

# tam-menu-select — pick one option from the menu in the Tamlinux shell.
#
#   tam-menu-select <prompt> [option...] [-- --width <n> --maxheight <n>]
#
# Derived from Omarchy 4.0.4 (historical source attribution).
# Implementation and integration are maintained by Tamlinux.
