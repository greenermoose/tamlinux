  "trigger.toggle.idle-lock": {"icon":"󰅶","label":"Stay Awake","action":"tam-toggle-idle"},
  "trigger.toggle.notifications": {"icon":"󰂛","label":"Notifications","action":"tam-toggle-notification-silencing"},
  "trigger.toggle.crash-capture": {"icon":"󱚡","label":"Crash Capture","action":"tam-toggle-crash-capture"},
  "trigger.toggle.screensaver": {"icon":"󱄄","label":"Screensaver","action":"tam-toggle-screensaver"},
  "trigger.toggle.nightlight": {"icon":"󰔎","label":"Nightlight","action":"tam-toggle-nightlight"},
  "trigger.toggle.top-bar": {"icon":"󰍜","label":"Menu Bar","action":"tam-shell tamlinux-shell toggleBar"},
  "trigger.toggle.battery-percentage": {"icon":"󰁹","label":"Battery Percentage","when":"tam-hw-laptop","action":"tam-shell tamlinux-shell call tamlinux.power togglePercentage"},
