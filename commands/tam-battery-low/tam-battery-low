#!/bin/bash

# tam-battery-low — warn that the battery is low. The Tamlinux shell's battery
# service runs it once each time a draining battery reaches 10%.
#
# Usage: tam-battery-low <percentage>
#
# Ported from omarchy 4.0.4 (omarchy-battery-low) for plan 18 R4.12. The
# battery-low hook call was dropped in R4.15f (D69).
