#!/bin/bash

# tamlinux:summary=Show or set the location used for weather reports
# tamlinux:args=[--set <name> [lat,lon]|--clear]

# Ported from Omarchy 4.0.4 (omarchy-weather-location) for plan 18 0.3.0.
