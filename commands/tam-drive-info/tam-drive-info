#!/bin/bash

# tam-drive-info — print drive information such as size, model, and mount
# details.
#
#   tam-drive-info [/dev/drive]
#
# Ported from Omarchy 4.0.4 (omarchy-drive-info) for plan 18 R4.15i.
# Changed: the usage message names tam-drive-info.

