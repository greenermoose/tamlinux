#!/bin/bash

# tam-tui-install — create a desktop launcher for a terminal UI app.
#
#   tam-tui-install [name command window-style icon-url-or-name]
#
# Ported from Omarchy 4.0.4 (omarchy-tui-install) for plan 18 R4.15h.
# Changed: a bare icon name reads as one from the installed icon themes.
