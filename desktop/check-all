#!/usr/bin/python3 -I
"""Run the whole tamlinux test suite from a clean clone and report what it found.

    desktop/check-all [--rev REVISION] [--proofs] [--report FILE]

Each unit runs alone with a time limit: every file in desktop/tests, make check
in every command, and the headless check-panels and check-theme. Uncommitted
edits are not tested, and session variables are removed, so a result does not
depend on the checkout or on running inside a desktop session.

It runs only when asked. Exit status: 0 passed, 1 a unit failed or a test left
a core dump, 2 the run itself could not start.

--proofs also enables the opt-in proofs. They start real programs under private
headless compositors, and a program may crash and leave a core dump, so warn
whoever is at the machine first. check-live is never run here: it drives the
real screens.
"""

from __future__ import annotations

import argparse
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import time

UNIT_LIMIT_SECONDS = 300
TAIL_LINES = 12
COREDUMP_MESSAGE_ID = "fc2e22bc6ee647b6b90729ab34a250b1"
COREDUMP_SETTLE_SECONDS = 2
SESSION_PREFIXES = ("TAMLINUX_", "HYPRLAND_", "WAYLAND_", "QT_", "QML", "SWAY", "WLR_", "XDG_SESSION_")
SESSION_NAMES = {"DISPLAY", "XAUTHORITY", "XDG_CURRENT_DESKTOP", "XDG_SEAT", "XDG_VTNR", "I3SOCK"}
PROOF_FLAGS = {"TAMLINUX_GTK_PROOF": "1", "TAMLINUX_DCONF_PROOF": "1"}
SKIP_LINE = re.compile(r"\.\.\. skipped (['\"])(?P<reason>.*)\1$")
SKIP_COUNT = re.compile(r"^(?:OK|FAILED) \(.*skipped=(?P<count>\d+)")


def clean_environment(environ, proofs=False):
    """Copy the environment without anything that belongs to a desktop session."""
    env = {name: value for name, value in environ.items()
           if name not in SESSION_NAMES and not name.startswith(SESSION_PREFIXES)}
    if proofs:
        env.update(PROOF_FLAGS)
    return env


def discover_units(clone):
    """Return (kind, name, directory, argv) for every unit in a checkout."""
    clone = Path(clone)
    units = []
    for path in sorted((clone / "desktop/tests").glob("test_*.py")):
        units.append(("desktop", path.stem, clone,
                      [sys.executable, "-B", "-m", "unittest", "discover", "-v",
                       "-s", "desktop/tests", "-p", path.name]))
    for script in ("check-panels", "check-theme"):
        if (clone / "desktop" / script).is_file():
            units.append(("check", script, clone, [f"desktop/{script}"]))
    for path in sorted((clone / "commands").glob("*/Makefile")):
        units.append(("command", path.parent.name, path.parent, ["make", "check"]))
    return units


def parse_skips(output):
    """Return skip reasons, naming any that the runner's output did not show."""
    reasons = [match["reason"] for match in map(SKIP_LINE.search, output.splitlines()) if match]
    counted = sum(int(match["count"]) for match in map(SKIP_COUNT.match, output.splitlines()) if match)
    reasons.extend(["reason not shown"] * max(0, counted - len(reasons)))
    return reasons


def run_unit(unit, env, limit=UNIT_LIMIT_SECONDS):
    kind, name, directory, argv = unit
    started = time.monotonic()
    try:
        done = subprocess.run(argv, cwd=directory, env=env, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              text=True, errors="replace", timeout=limit)
        code, output = done.returncode, done.stdout
    except subprocess.TimeoutExpired as expired:
        partial = expired.stdout or ""
        if isinstance(partial, bytes):
            partial = partial.decode(errors="replace")
        code, output = "timeout", partial + f"\nstopped after {limit} seconds\n"
    return {"kind": kind, "name": name, "result": code,
            "seconds": round(time.monotonic() - started, 1),
            "skips": parse_skips(output),
            "tail": output.splitlines()[-TAIL_LINES:] if code != 0 else []}


def own_cgroup():
    try:
        return Path("/proc/self/cgroup").read_text().strip().rpartition("::")[2]
    except OSError:
        return None


def core_dumps_since(epoch, cgroup):
    """Return (ours, elsewhere) from the journal, or (None, None) if it cannot be read."""
    time.sleep(COREDUMP_SETTLE_SECONDS)
    try:
        done = subprocess.run(["journalctl", "--no-pager", "-o", "json", f"--since=@{int(epoch)}",
                               f"MESSAGE_ID={COREDUMP_MESSAGE_ID}"],
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    if done.returncode != 0:
        return None, None
    ours, elsewhere = [], []
    for line in done.stdout.splitlines():
        entry = json.loads(line)
        record = {"pid": entry.get("COREDUMP_PID"), "exe": entry.get("COREDUMP_EXE"),
                  "signal": entry.get("COREDUMP_SIGNAL_NAME")}
        (ours if entry.get("COREDUMP_CGROUP") == cgroup else elsewhere).append(record)
    return ours, elsewhere


def clean_clone(repo, revision, parent):
    """Make a private checkout of one revision and return (path, full revision)."""
    git = ["git", "-c", "advice.detachedHead=false"]
    full = subprocess.run(git + ["-C", str(repo), "rev-parse", "--verify", f"{revision}^{{commit}}"],
                          capture_output=True, text=True, check=True).stdout.strip()
    clone = Path(parent) / "tamlinux"
    subprocess.run(git + ["clone", "-q", "--shared", "--no-checkout", str(repo), str(clone)], check=True)
    subprocess.run(git + ["-C", str(clone), "checkout", "-q", full], check=True)
    return clone, full


def summarize(report, stream=sys.stdout):
    failed = [unit for unit in report["units"] if unit["result"] != 0]
    print(f"\nrevision {report['revision']}", file=stream)
    print(f"{len(report['units'])} units, {len(failed)} failed, "
          f"{report['seconds']:.0f} seconds", file=stream)
    for unit in failed:
        print(f"\nFAILED {unit['kind']} {unit['name']} ({unit['result']})", file=stream)
        for line in unit["tail"]:
            print(f"  {line}", file=stream)
    skips = {}
    for unit in report["units"]:
        for reason in unit["skips"]:
            skips.setdefault((unit["name"], reason), 0)
            skips[(unit["name"], reason)] += 1
    if skips:
        print(f"\nskipped {sum(skips.values())}:", file=stream)
        for (name, reason), count in sorted(skips.items()):
            print(f"  {count} in {name}: {reason}", file=stream)
    if report["coreDumps"] is None:
        print("\ncore dumps: unknown, the journal could not be read", file=stream)
    else:
        print(f"\ncore dumps left by this run: {len(report['coreDumps'])}", file=stream)
        for core in report["coreDumps"]:
            print(f"  {core['signal']} {core['exe']} (PID {core['pid']})", file=stream)
        if report["coreDumpsElsewhere"]:
            print(f"core dumps elsewhere on this machine meanwhile: {len(report['coreDumpsElsewhere'])}",
                  file=stream)
    print("PASSED" if report["passed"] else "NOT PASSED", file=stream)


def main(argv=None):
    parser = argparse.ArgumentParser(description="Run the whole tamlinux test suite from a clean clone.")
    parser.add_argument("--rev", default="HEAD", help="revision to test (default: HEAD)")
    parser.add_argument("--proofs", action="store_true", help="also enable the opt-in proofs")
    parser.add_argument("--report", type=Path, help="write the results to this JSON file")
    args = parser.parse_args(argv)
    repo = Path(__file__).resolve().parents[1]
    started, epoch = time.monotonic(), time.time()
    with tempfile.TemporaryDirectory(prefix="tamlinux-check-all-") as parent:
        try:
            clone, revision = clean_clone(repo, args.rev, parent)
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"check-all: cannot check out {args.rev}: {error}", file=sys.stderr)
            return 2
        env = clean_environment(os.environ, args.proofs)
        env.pop("PWD", None)
        units = discover_units(clone)
        results = []
        for number, unit in enumerate(units, 1):
            result = run_unit(unit, env)
            results.append(result)
            if result["result"] != 0:
                print(f"[{number}/{len(units)}] FAILED {unit[0]} {unit[1]}", flush=True)
    ours, elsewhere = core_dumps_since(epoch, own_cgroup())
    report = {"revision": revision, "proofs": args.proofs, "units": results,
              "seconds": time.monotonic() - started, "coreDumps": ours,
              "coreDumpsElsewhere": elsewhere,
              "passed": bool(results) and all(unit["result"] == 0 for unit in results) and not ours}
    summarize(report)
    if args.report:
        args.report.write_text(json.dumps(report, indent=1) + "\n", encoding="utf-8")
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    sys.exit(main())
