{
  "schema": 1,
  "scope": "Finite user-state conversion; native/boot/GTK/device effects require their separate recovery owners.",
  "paths": [
    {
      "id": "imv-escape",
      "root": "config",
      "source": "imv/config",
      "target": "imv/config",
      "conversion": "imv-escape"
    },
    {
      "id": "foot-theme",
      "root": "config",
      "source": "foot/foot.ini",
      "target": "foot/foot.ini",
      "conversion": "foot"
    },
    {
      "id": "micro-bindings",
      "root": "config",
      "source": "micro/bindings.json",
      "target": "micro/bindings.json",
      "conversion": "micro-bindings"
    },
    {
      "id": "micro-theme",
      "root": "config",
      "source": "micro/settings.json",
      "target": "micro/settings.json",
      "conversion": "micro-theme"
    },
    {
      "id": "kitty-theme",
      "root": "config",
      "source": "kitty/kitty.conf",
      "target": "kitty/kitty.conf",
      "conversion": "terminal-theme"
    },
    {
      "id": "ghostty-theme",
      "root": "config",
      "source": "ghostty/config",
      "target": "ghostty/config",
      "conversion": "terminal-theme"
    },
    {
      "id": "alacritty-theme",
      "root": "config",
      "source": "alacritty/alacritty.toml",
      "target": "alacritty/alacritty.toml",
      "conversion": "terminal-theme"
    },
    {
      "id": "btop-theme",
      "root": "config",
      "source": "btop/themes/current.theme",
      "target": "btop/themes/current.theme",
      "conversion": "theme-leaf",
      "leaf": "btop.theme"
    },
    {
      "id": "nvim-theme",
      "root": "config",
      "source": "nvim/lua/plugins/theme.lua",
      "target": "nvim/lua/plugins/theme.lua",
      "conversion": "theme-leaf",
      "leaf": "neovim.lua"
    },
    {
      "id": "share-picker-theme",
      "root": "config",
      "source": "hyprland-preview-share-picker/config.yaml",
      "target": "hyprland-preview-share-picker/config.yaml",
      "conversion": "theme-leaf",
      "leaf": "hyprland-preview-share-picker.css"
    },
    {
      "id": "desktop-mode",
      "root": "state",
      "source": "tamlinux/desktop-mode",
      "target": "tamlinux/desktop-mode",
      "conversion": "desktop-mode"
    },
    {
      "id": "bar-layout",
      "root": "config",
      "source": "omarchy/shell.json",
      "target": "tamlinux/shell/layout.json",
      "conversion": "bar-layout"
    },
    {
      "id": "retire-hey",
      "root": "data",
      "source": "applications/HEY.desktop",
      "target": "applications/HEY.desktop",
      "conversion": "retire-hey"
    },
    {
      "id": "retire-hey-mime-config-default",
      "root": "config",
      "source": "mimeapps.list",
      "target": "mimeapps.list",
      "conversion": "retire-hey-mime"
    },
    {
      "id": "retire-hey-mime-config-desktop",
      "root": "config",
      "source": "*-mimeapps.list",
      "target": "*-mimeapps.list",
      "conversion": "retire-hey-mime"
    },
    {
      "id": "retire-hey-mime-data-default",
      "root": "data",
      "source": "applications/mimeapps.list",
      "target": "applications/mimeapps.list",
      "conversion": "retire-hey-mime"
    },
    {
      "id": "retire-hey-mime-data-desktop",
      "root": "data",
      "source": "applications/*-mimeapps.list",
      "target": "applications/*-mimeapps.list",
      "conversion": "retire-hey-mime"
    },
    {
      "id": "webapps",
      "root": "data",
      "source": "applications/*.desktop",
      "target": "applications/*.desktop",
      "conversion": "webapp"
    },
    {
      "id": "hypr-monitors",
      "root": "config",
      "source": "hypr/monitors.lua",
      "target": "tamlinux/hypr/monitors.lua",
      "conversion": "hypr"
    },
    {
      "id": "hypr-input",
      "root": "config",
      "source": "hypr/input.lua",
      "target": "tamlinux/hypr/input.lua",
      "conversion": "hypr"
    },
    {
      "id": "hypr-bindings",
      "root": "config",
      "source": "hypr/bindings.lua",
      "target": "tamlinux/hypr/bindings.lua",
      "conversion": "hypr"
    },
    {
      "id": "hypr-looknfeel",
      "root": "config",
