PREFIX ?= /usr/local

.PHONY: check install

check:
	bash -n tam-hyprland-window-single-square-aspect-toggle

install:
	install -Dm755 tam-hyprland-window-single-square-aspect-toggle $(DESTDIR)$(PREFIX)/bin/tam-hyprland-window-single-square-aspect-toggle
	install -Dm644 LICENSE $(DESTDIR)$(PREFIX)/share/licenses/tam-hyprland-window-single-square-aspect-toggle/LICENSE
