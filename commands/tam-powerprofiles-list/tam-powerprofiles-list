#!/bin/bash

# tam-powerprofiles-list — list the power profiles this machine offers, one
# per line, lowest power first. With --active-state, each line also has a tab
# and 1 for the active profile or 0 for the others.
#
# Usage: tam-powerprofiles-list [--active-state]
#
# Ported from omarchy 4.0.4 (omarchy-powerprofiles-list) for plan 18 R4.12.
