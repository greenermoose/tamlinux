#!/bin/bash

# tam-hyprland-workspace-layout-toggle — switch the active workspace between
# the dwindle and scrolling layouts, and remember the choice.
#
# Ported from omarchy 4.0.4 (omarchy-hyprland-workspace-layout-toggle) for
# plan 18 R4.15e; it notifies through tam-notification-send. The saved layouts
# keep their path, which config/hypr/tamlinux/workspace-layouts.lua reads.
# Hyprland-specific (R6).
