  "remove.webapp": {"icon":"","label":"Web App","when":"grep -qE '^Exec=.*(tam-launch-webapp|omarchy-(launch-webapp|webapp-handler))' $HOME/.local/share/applications/*.desktop","action":"tam-webapp-remove"},
  "remove.tui": {"icon":"","label":"TUI","when":"grep -qE '^Exec=.*(\\$TERMINAL|xdg-terminal-exec).*-e' $HOME/.local/share/applications/*.desktop","action":"tam-tui-remove"},
