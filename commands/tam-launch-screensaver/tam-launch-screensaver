if [[ -f ${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/toggles/screensaver-off && ${1:-} != force ]]; then exit 1; fi

if ! command -v ttfx >/dev/null; then
  tam-notification-send -g ✋ "ttfx is not installed"
  exit 1
fi

# Exit early if screensaver is already running
pgrep -f '[o]rg.tamlinux.screensaver' && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/toggles/screensaver-off && ${1:-} != "force" ]]; then
  exit 1
fi

data_dir="$(dirname "$(readlink -f "$0")")/../share/tamlinux"
settings="${XDG_CONFIG_HOME:-$HOME/.config}/tamlinux/screensaver"
settings_file() {
  if [[ -f $settings/$1 ]]; then printf "%s\n" "$settings/$1";
  else printf "%s\n" "$data_dir/screensaver/$1"; fi
}
focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
terminal=$(xdg-terminal-exec --print-id)

case $terminal in
*Alacritty* | *alacritty* | *ghostty* | *foot* | *kitty*) ;;
*)
  tam-notification-send -g ✋ "Screensaver only runs in Alacritty, Foot, Ghostty, or Kitty"
  exit 1
  ;;
esac

hypr_focus_monitor() {
  [[ $1 =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"

  local equals=""
  while [[ $command == *"]${equals}]"* ]]; do equals+="="; done
  hyprctl dispatch "hl.dsp.exec_cmd([$equals[$command]$equals])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# Open Hyprland's event stream before spawning anything, so a terminal that maps
# quickly can't emit its openwindow event before we are listening for it.
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET")

# hypr_exec is async and a new window maps on whatever monitor is focused at that
# moment. Block until this monitor's screensaver actually opens before moving
# focus on -- otherwise slow-starting terminals all pile onto the last monitor.
# The deadline is a safety net in case the window never appears.
wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.tamlinux.screensaver,* ]] && return 0
  done
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m" || exit 1

  case $terminal in
  *Alacritty* | *alacritty*)
    hypr_exec alacritty --class=org.tamlinux.screensaver --config-file "$(settings_file alacritty.toml)" -e "$(dirname "$(readlink -f "$0")")/tam-screensaver"
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.tamlinux.screensaver --config-file="$(settings_file ghostty)" --font-size=18 -e "$(dirname "$(readlink -f "$0")")/tam-screensaver"
    ;;
  *foot*)
    hypr_exec foot --app-id=org.tamlinux.screensaver --config="$(settings_file foot.ini)" -e "$(dirname "$(readlink -f "$0")")/tam-screensaver"
    ;;
  *kitty*)
    hypr_exec kitty --class=org.tamlinux.screensaver --override font_size=18 --override window_padding_width=0 -e "$(dirname "$(readlink -f "$0")")/tam-screensaver"
    ;;
  esac

  wait_for_screensaver_window
done

hypr_focus_monitor "$focused"
