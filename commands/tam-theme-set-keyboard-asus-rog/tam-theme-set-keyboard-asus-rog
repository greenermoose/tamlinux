# tamlinux:summary=Apply the current theme keyboard color to ASUS ROG keyboards
# tamlinux:hidden=true

ASUSCTL_THEME=${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/current/theme/keyboard.rgb

if tam-cmd-present asusctl && [[ -f $ASUSCTL_THEME ]]; then
  color=$(sed 's/^#//' "$ASUSCTL_THEME")
  [[ $color =~ ^[0-9A-Fa-f]{6}$ ]] || exit 0
  asusctl aura effect static -c "$color"
fi
