def is_installed(check_cmd: str) -> bool:
    """Check if the given command executable is available on PATH."""
    return shutil.which(check_cmd) is not None


def render_menu(activities=None) -> str:
    """Format the activities menu into readable text."""
    if activities is None:
        activities = ACTIVITIES

    lines = [banner(), "Choose an activity to explore from your terminal:\n"]

    current_category = None
    item_num = 1
    num_map = {}

    for item in activities:
        cat = item["category"]
        if cat != current_category:
            current_category = cat
            lines.append(f"  {bold(cyan('── ' + cat + ' ──'))}")

        installed = is_installed(item["check_cmd"])
        status = "" if installed else dim(" [not installed]")

        if item["id"] == "desktop":
            key_label = bold(green(" d"))
            num_map["d"] = item
        else:
            key_label = f"{item_num:2d}"
            num_map[str(item_num)] = item
            item_num += 1

        label_colored = item["label"] if installed else dim(item["label"])
        lines.append(f"  [{key_label}] {label_colored}{status}")
        lines.append(f"       {dim(item['description'])}")

    lines.append(f"\n  {bold(cyan('── Actions ──'))}")
    lines.append(f"  [{bold(' q')}] Return to shell prompt")
    lines.append("")

    return "\n".join(lines), num_map


def run_activity(item: dict) -> int:
    """Run the selected activity."""
    cmd = item["command"]
    if not is_installed(item["check_cmd"]):
        print(f"\n{bold(yellow('Notice:'))} '{item['check_cmd']}' is not currently installed.")
        if item["category"] == "Curated Games & Simulations":
            print("To include the curated games/simulations set in your Tamlinux profile,")
            print("enable the package set in your configuration:")
            print(f"  {bold('tamlinux.terminalGames.enable = true;')}")
            print(f"or install the package via Arch/Nix.")
        print("\nPress Enter to return to menu...")
        try:
            input()
        except (EOFError, KeyboardInterrupt):
            pass
        return 1

    try:
        # Run foreground job with terminal attached
        res = subprocess.run(cmd)
        return res.returncode
    except FileNotFoundError:
        print(f"Error: Command '{cmd[0]}' not found.", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 0


def interactive_loop() -> int:
    """Main interactive menu loop."""
    while True:
        menu_text, num_map = render_menu()
        print(menu_text)

        try:
            choice = input(bold("Choice: ")).strip().lower()
        except (EOFError, KeyboardInterrupt):
            print("\nExiting to shell prompt.")
            return 0

        if not choice:
            continue

        if choice in ("q", "quit", "exit", "0"):
            return 0

        if choice in num_map:
            item = num_map[choice]
            run_activity(item)
            if item["id"] == "desktop":
                # When desktop session finishes or exits, return to prompt
                return 0
        else:
            print(f"Invalid selection: '{choice}'. Enter a number, 'd' for desktop, or 'q' to quit.")


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog="start",
        description="First text-login orientation, activities, and desktop launcher (D215)."
    )
    parser.add_argument(
        "--version", "-V", action="version", version=f"start (Tamlinux) {VERSION}"
    )
    parser.add_argument(
        "--list", action="store_true", help="List available activities and commands"
    )
    parser.add_argument(
        "--check", action="store_true", help="Check which activities are installed on this system"
    )
    return parser.parse_args(argv)


def main(argv=None) -> int:
    args = parse_args(argv)

    if args.list:
        print(f"{'ID':<16} {'Command':<25} {'Installed':<10} {'Description'}")
        print("─" * 80)
        for act in ACTIVITIES:
            inst = "yes" if is_installed(act["check_cmd"]) else "no"
            cmd_str = " ".join(act["command"])
            print(f"{act['id']:<16} {cmd_str:<25} {inst:<10} {act['description']}")
        return 0

    if args.check:
        installed_count = 0
        total = len(ACTIVITIES)
        for act in ACTIVITIES:
            inst = is_installed(act["check_cmd"])
            if inst:
                installed_count += 1
            mark = green("✓") if inst else dim("✗")
            print(f" {mark} {act['label']} ({act['check_cmd']})")
        print(f"\n{installed_count}/{total} activities installed on this system.")
        return 0

    return interactive_loop()


if __name__ == "__main__":
    sys.exit(main())
