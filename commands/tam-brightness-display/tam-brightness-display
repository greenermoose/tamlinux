# EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF
# MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND
# NONINFRINGEMENT. IN NO EVENT SHALL THE AUTHORS OR COPYRIGHT HOLDERS BE
# LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION
# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.
set -o pipefail
no_osd=0
monitor=""

while (( $# > 0 )); do
  case "$1" in
  --no-osd)
    no_osd=1
    shift
    ;;
  --monitor)
    (( $# >= 2 )) || exit 1
    monitor="$2"
    shift 2
    ;;
  *)
    break
    ;;
  esac
done

# Get the brightness of the passed display
backlight_brightness() {
  brightnessctl -d "$1" -m 2>/dev/null | awk -F, '{ gsub("%", "", $4); print $4; found=1 } END{ exit !found }'
}

[[ -n $monitor ]] || monitor="$(tam-hyprland-monitor-focused 2>/dev/null || true)"

monitor_is_internal() {
  [[ $monitor =~ ^(eDP|LVDS|DSI)- ]]
}

use_apple_display() {
  tam-hyprland-monitor-focused-apple "$monitor"
}

use_ddc_display() {
  [[ -n $monitor ]] && ! monitor_is_internal
}

if (( $# == 0 )); then
  if use_apple_display; then
    tam-brightness-display-apple
    exit
  elif use_ddc_display; then
    tam-brightness-display-ddc "$monitor"
    exit
  fi

  device="$(tam-hw-display)" || exit 1
  backlight_brightness "$device"
  exit
fi

step="$1"

if [[ $step == "off" ]]; then
  hyprctl dispatch 'hl.dsp.dpms({ action = "disable" })' >/dev/null 2>&1
  exit $?
elif [[ $step == "on" ]]; then
  # Skip the dispatch when every active display is already lit: a redundant
  # DPMS enable right after system resume forces another modeset, which blanks
  # the panel for a beat (visible flash at the unlock screen).
  hyprctl monitors -j 2>/dev/null | jq -e '[.[] | select(.disabled == false)] | length > 0 and all(.dpmsStatus)' >/dev/null 2>&1 && exit 0
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1
  exit $?
fi

[[ $step =~ ^(\+?[0-9]+%|[0-9]+%-)$ ]] || exit 2

# Drop overlapping brightness key events so concurrent invocations do not race.
# Hardware key repeat present on some devices can otherwise glitch OSD rendering.
[[ -d ${XDG_RUNTIME_DIR:-} ]] || { echo "A private XDG_RUNTIME_DIR is required" >&2; exit 1; }
exec {lock_fd}>"$XDG_RUNTIME_DIR/tam-brightness-display.lock" || exit 1
flock -n "$lock_fd" || exit 0

if use_apple_display; then
  tam-brightness-display-apple --no-osd "$step" || exit 1
  (( no_osd )) || tam-osd -i brightness -p "$(tam-brightness-display-apple)"
elif use_ddc_display; then
  brightness="$(tam-brightness-display-ddc "$monitor" "$step")" || exit 1
  (( no_osd )) || tam-osd -i brightness -p "$brightness"
else
  # Current device highlighted
  device="$(tam-hw-display)" || exit 1

  # Current brightness percentage
  current=$(backlight_brightness "$device") || exit 1

  # Apply non-uniform step size: 1% steps if at or below 5%, otherwise set an
  # absolute target percentage to avoid raw backlight rounding causing uneven OSD steps.
  if [[ $step == "+5%" ]]; then
    if (( current < 5 )); then
      (( target = current + 1 ))
    else
      (( target = current + 5 ))
    fi

    (( target > 100 )) && target=100
    step="$target%"
  elif [[ $step == "5%-" ]]; then
    if (( current <= 5 )); then
      (( target = current - 1 ))
    else
      (( target = current - 5 ))
    fi

    (( target < 1 )) && target=1
    step="$target%"
  fi

  # Set brightness of the display device.
  brightnessctl -d "$device" set "$step" >/dev/null || exit 1

  # Show the new brightness in OSD
  (( no_osd )) || tam-osd -i brightness -p "$(backlight_brightness "$device")"
fi

exit 0
