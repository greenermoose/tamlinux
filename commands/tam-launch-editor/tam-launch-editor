default_editor="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="nvim"
fi

tam-cmd-present "$editor" || editor="nvim"

case "${editor##*/}" in
nvim | vim | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" "$@"
  else
    exec tam-launch-tui "$editor" "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" "$@"
  ;;
esac
