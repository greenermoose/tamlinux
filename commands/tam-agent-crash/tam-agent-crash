set -euo pipefail

pid=${1:?usage: tam-agent-crash <pid> [comm] [exe] [signal]}

if [[ ! $pid =~ ^[0-9]+$ ]]; then
  echo "Not a PID: $pid" >&2
  echo "Usage: tam-agent-crash <pid>   (see: coredumpctl list)" >&2
  exit 1
fi

comm=${2:-unknown}
exe=${3:-unknown}
signal=${4:-unknown}

skill="${XDG_DATA_HOME:-$HOME/.local/share}/tamlinux/skills/diagnose-crash/SKILL.md"
[[ -f $skill ]] || { echo "Install the selected crash-diagnosis skill before launching an agent." >&2; exit 1; }

# Looked up live so a hand-run PID still gets a timestamp. A rotated-away core
# only costs the timestamp, so failure is tolerated.
when=$(coredumpctl list "$pid" --no-pager --no-legend 2>/dev/null | tail -1 | cut -d' ' -f1-4) || true
when=${when:-unknown}

prompt=$(
  cat <<PROMPT
A process crashed on this workstation and I want to know why.

What systemd-coredump recorded:
  process:  $comm
  PID:      $pid
  binary:   $exe
  signal:   $signal
  time:     $when

Use the diagnose-crash skill: it covers how to investigate, what to report, and
when a crash is worth reporting upstream. If your harness has no skill
mechanism, read the skill files directly and follow them instead:

  $skill
PROMPT
)

exec tam-agent --prompt "$prompt"
