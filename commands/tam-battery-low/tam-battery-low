# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

set -euo pipefail

if (($# != 1)) || [[ ! $1 =~ ^[0-9]{1,3}$ ]]; then
  echo "Usage: tam-battery-low <percentage>" >&2
  exit 1
fi

level=$1

if command -v tam-notification-send >/dev/null; then
  tam-notification-send -g 󱐋 -u critical "Time to recharge!" "Battery is down to ${level}%" -i battery-caution -t 30000
else
  notify-send -u critical -i battery-caution -t 30000 "Time to recharge!" "Battery is down to ${level}%"
fi
