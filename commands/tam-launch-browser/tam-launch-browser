default_browser=$(env -u BROWSER xdg-settings get default-web-browser)
if [[ -z $default_browser ]]; then
  default_browser=$(xdg-mime query default x-scheme-handler/https)
fi
browser_json=$(tam-browser-command "$default_browser") || exit 1
mapfile -d '' -t browser_command < <(printf '%s' "$browser_json" | jq -j '.[] | . + "\u0000"')
((${#browser_command[@]})) || exit 1
browser_exec=${browser_command[0]}

if "${browser_command[@]}" --help 2>/dev/null | grep -q MOZ_LOG; then
  private_flag="--private-window"
elif [[ $browser_exec =~ edge ]]; then
  private_flag="--inprivate"
else
  private_flag="--incognito"
fi
arguments=()
url=""
for argument in "$@"; do
  if [[ $argument == --private ]]; then
    arguments+=("$private_flag")
  else
    arguments+=("$argument")
    [[ -n $url ]] || url=$argument
  fi
done

systemd-run --user --quiet --collect --unit="tamlinux-browser-$(date +%s%N)" \
  --property=StandardOutput=null --property=StandardError=null \
  uwsm-app -- "${browser_command[@]}" "${arguments[@]}" || exit 1

if [[ -n $url && -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  tam-hyprland-focus-app "^$(basename "$browser_exec" -stable).*$" || true
fi
