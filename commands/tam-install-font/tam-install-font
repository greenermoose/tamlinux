# OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION
# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

name="${1-}"
package="${2-}"
family="${3-}"

if [[ -z $name || -z $package || -z $family ]]; then
  echo "Usage: tam-install-font <display-name> <package> <family>" >&2
  exit 1
fi

if [[ ! $package =~ ^[a-zA-Z0-9][a-zA-Z0-9@._+-]*$ ]]; then
  echo "Invalid font package" >&2
  exit 1
fi
printf -v install_message '%q' "Installing ${name}..."
printf -v package_arg '%q' "$package"
printf -v family_arg '%q' "$family"

exec tam-launch-floating-terminal-with-presentation \
  "echo ${install_message}; tam-pkg-add ${package_arg} && sleep 2 && tam-font-set ${family_arg}"
