ACTIVE_WORKSPACE=$(hyprctl activeworkspace -j | jq -r '.id')
[[ $ACTIVE_WORKSPACE =~ ^-?[0-9]+$ ]] || exit 1
CURRENT_LAYOUT=$(hyprctl activeworkspace -j | jq -r '.tiledLayout')
LAYOUTS_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/workspace-layouts"
LAYOUT_FILE="$LAYOUTS_DIR/$ACTIVE_WORKSPACE.lua"

case "$CURRENT_LAYOUT" in
  dwindle) NEW_LAYOUT=scrolling ;;
  *) NEW_LAYOUT=dwindle ;;
esac

tam-settings-preserve workspace-layout --file "$LAYOUT_FILE" >/dev/null || exit 1
mkdir -p "$LAYOUTS_DIR" || exit 1
stage=$(mktemp "$LAYOUTS_DIR/.layout.XXXXXX") || exit 1
trap 'rm -f -- "$stage"' EXIT
printf 'hl.workspace_rule({ workspace = "%s", layout = "%s" })\n' "$ACTIVE_WORKSPACE" "$NEW_LAYOUT" >"$stage" || exit 1
mv -- "$stage" "$LAYOUT_FILE" || exit 1

hyprctl eval "hl.workspace_rule({ workspace = \"$ACTIVE_WORKSPACE\", layout = \"$NEW_LAYOUT\" })" >/dev/null 2>&1 || \
  hyprctl keyword workspace "$ACTIVE_WORKSPACE, layout:$NEW_LAYOUT"
tam-notification-send -g 󱂬 "Workspace layout set to $NEW_LAYOUT"
