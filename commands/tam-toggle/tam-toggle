# WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE SOFTWARE.

if (($# < 1)); then
  echo "Usage: tam-toggle <flag-name> [toggle|on|off]" >&2
  exit 1
fi

FLAG_NAME="$1"
[[ $FLAG_NAME =~ ^[A-Za-z0-9_-]+$ ]] || exit 2
ACTION="${2:-toggle}"
FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/toggles/$FLAG_NAME"

enable() {
  tam-settings-preserve toggles --file "$FLAG" >/dev/null || exit 1
  mkdir -p "$(dirname "$FLAG")"
  touch "$FLAG"
}

disable() {
  tam-settings-preserve toggles --file "$FLAG" >/dev/null || exit 1
  rm -f "$FLAG"
}

case "$ACTION" in
  toggle|"")
    if [[ -f $FLAG ]]; then
      disable
    else
      enable
    fi
    ;;
  on)
    enable
    ;;
  off)
    disable
    ;;
  *)
    echo "Usage: tam-toggle <flag-name> [toggle|on|off]" >&2
    exit 1
    ;;
esac
