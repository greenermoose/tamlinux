def drive_layout(env: dict, process: subprocess.Popen) -> None:
    def lines() -> list[str]:
        return evidence_lines(read_log(process))

    def failed() -> bool:
        return any(line.startswith(("bar-entry-unknown", "bar-entry-failed", "bar-layout-unreadable")) for line in lines())

    def registered() -> bool:
        text = lines()
        return all(any(line.startswith(f"widget-registered {entry_id} ") for line in text) for entry_id in layout_ids())

    if not wait_for(lambda: failed() or registered(), 25):
        raise SystemExit("the layout's widgets did not register:\n" + read_log(process)[-4000:])
    if failed():
        raise SystemExit("a layout entry failed:\n" + read_log(process)[-4000:])
    # The rightmost plugin's tooltip must stay on screen (it once ran off).
    ipc(env, "tamlinux-shell", "tooltipProbeFor", ["fred.sysinfo"])

    def placed() -> str | None:
        return next((line for line in lines() if line.startswith("tooltip ") and "probe fred.sysinfo" in line), None)

    line = wait_for(placed, 10)
    if not line:
        raise SystemExit("the tooltip probe did not land:\n" + read_log(process)[-4000:])
    fields = dict(part.split("=", 1) for part in line.split(" text=")[0].split()[1:])
    right = int(fields["x"]) + int(fields["width"])
    if int(fields["x"]) < 0 or right > int(fields["barWidth"]):
        raise SystemExit(f"tooltip off screen: {line}")
    expected = env.get("TAMLINUX_PROOF_POSITION", "top")
    side = "above" if expected == "bottom" else "below"
    if fields.get("side") != side:
        raise SystemExit(f"tooltip on the wrong side of a {expected} bar: {line}")
    created = [line for line in lines() if line.startswith("bar-created host=")]
    if not created or any(not line.endswith(f" position={expected}") for line in created):
        raise SystemExit(f"bars not at the {expected}:\n" + "\n".join(created))
    if expected == "top":
        drive_routes(env, process)
        drive_bar_controls(env, process)


# The focused-screen routes (plan 18 0.3.2 item 2) and the overlay-only panel
# host (item 3), on every screen the proof draws a bar on.
def drive_routes(env: dict, process: subprocess.Popen) -> None:
    def lines() -> list[str]:
        return evidence_lines(read_log(process))

    def require(predicate, message: str) -> None:
        if not wait_for(predicate, 5):
            raise SystemExit(message + "\n" + read_log(process)[-4000:])

    def count(text: str) -> int:
        return sum(1 for line in lines() if line == text)

    require(lambda: "panels wifiqr,speedtest,disk-speedtest" in lines(), "the panel host did not keep to the overlays:")
    ipc(env, "tamlinux-shell", "probePanels", ["right"])
    listed = wait_for(lambda: next((line for line in lines() if line.startswith("panels right ")), None), 5)
    if not listed:
        raise SystemExit("no right-section panel census:\n" + read_log(process)[-4000:])
    order = listed.split(" ", 2)[2].split(",")
    builtin = [entry for entry in order if entry.startswith("tamlinux.")]
    if builtin != ["tamlinux.bluetooth", "tamlinux.network", "tamlinux.audio"] or "tamlinux.tray" in order:
        raise SystemExit(f"right-section panels out of layout order: {order}")
    for number, panel_id in enumerate(order, start=1):
        result = ipc(env, "tamlinux-shell", "togglePanelAt", ["right", str(number)])
        if result.stdout.strip() != panel_id:
            raise SystemExit(f"togglePanelAt right {number} answered {result.stdout.strip()!r}, not {panel_id}")
        require(lambda panel_id=panel_id: f"toggled {panel_id}" in lines(), f"togglePanelAt did not toggle {panel_id}:")
        ipc(env, "tamlinux-shell", "hide", [panel_id])
    missing = ipc(env, "tamlinux-shell", "togglePanelAt", ["right", str(len(order) + 1)])
    if missing.stdout.strip() != "unknown":
        raise SystemExit("togglePanelAt past the last panel was not refused")
    screens = []
    for key in host_keys(lines()):
        name = key.split("#", 1)[0]
        if name not in screens:
            screens.append(name)
    for name in screens:
        ipc(env, "tamlinux-shell", "setRouteFocus", [name])
        require(lambda name=name: f"route-focus {name}" in lines(), "route focus was not set:")
        for panel_id in ("tamlinux.audio", "fred.monitor"):
            opened = f"summoned {panel_id} screen={name}"
            closed = f"hidden {panel_id}"
            before_open, before_close = count(opened), count(closed)
            ipc(env, "tamlinux-shell", "toggle", [panel_id])
            require(lambda: count(opened) > before_open, f"{panel_id} did not open on {name}:")
            ipc(env, "tamlinux-shell", "toggle", [panel_id])
            require(lambda: count(closed) > before_close, f"{panel_id} did not close on {name}:")
    ipc(env, "tamlinux-shell", "setRouteFocus", [""])
    called = ipc(env, "tamlinux-shell", "call", ["tamlinux.bluetooth", "toggle"])
    if called.stdout.strip() != "ok":
        raise SystemExit(f"call tamlinux.bluetooth toggle answered {called.stdout.strip()!r}")
    ipc(env, "tamlinux-shell", "hide", ["tamlinux.bluetooth"])
    refused = ipc(env, "tamlinux-shell", "call", ["tamlinux.network", "no such"])
    if refused.stdout.strip() != "unknown":
        raise SystemExit("a malformed call was not refused")
    absent = ipc(env, "tamlinux-shell", "call", ["tamlinux.network", "notAMethod"])
    if absent.stdout.strip() != "unknown":
        raise SystemExit("a call to a missing method was not refused")
    print(f"routes checked on {len(screens)} screen(s): {','.join(screens)}")


def bar_layers() -> dict[str, dict]:
    """Each tamlinux-bar-* layer: its monitor's and its own geometry."""
    try:
        layers = json.loads(subprocess.run(
            ["/usr/bin/hyprctl", "-j", "layers"], capture_output=True, text=True, timeout=3, check=True,
        ).stdout)
        monitors = json.loads(subprocess.run(
            ["/usr/bin/hyprctl", "-j", "monitors"], capture_output=True, text=True, timeout=3, check=True,
        ).stdout)
    except (OSError, subprocess.SubprocessError, json.JSONDecodeError) as exc:
        raise SystemExit(f"hyprctl layers failed: {exc}") from exc
    tops = {}
    for monitor in monitors:
        scale = float(monitor.get("scale") or 1)
        tops[monitor["name"]] = (int(monitor["y"]), int(round(int(monitor["height"]) / scale)))
    found = {}
    for name, data in layers.items():
        for level in data.get("levels", {}).values():
            for layer in level:
                if layer.get("namespace", "").startswith("tamlinux-bar-"):
                    top, height = tops[name]
                    found[layer["namespace"]] = {"y": layer["y"] - top, "h": layer["h"], "screen": height}
    return found


# Hide and show, top and bottom, transparency, and the indicator refresh
# (plan 18 0.3.2 items 4 and 5), checked on the compositor's own geometry.
def drive_bar_controls(env: dict, process: subprocess.Popen) -> None:
    def lines() -> list[str]:
        return evidence_lines(read_log(process))

    def answer(function: str, args: list[str] | None = None) -> str:
        return ipc(env, "tamlinux-shell", function, args).stdout.strip()

    def placed(where: str) -> bool:
        layers = bar_layers()
        if not layers:
            return False
        for layer in layers.values():
            if where == "top" and layer["y"] != 0:
                return False
            if where == "bottom" and layer["y"] + layer["h"] != layer["screen"]:
                return False
            if where == "hidden" and 0 <= layer["y"] < layer["screen"] and layer["y"] + layer["h"] > 0:
                return False
        return True

    def require(predicate, message: str) -> None:
        if not wait_for(predicate, 5):
            raise SystemExit(message + "\n" + json.dumps(bar_layers()) + "\n" + read_log(process)[-3000:])

    home = Path(env["HOME"])
    flag = home / ".local" / "state" / "tamlinux" / "toggles" / "bar-off"
    document = Path(env["TAMLINUX_BAR_LAYOUT"])
    screens = len(host_keys(lines()))
    require(lambda: placed("top"), "the bars are not at the top:")
    count = answer("refreshIndicators")
    if count != str(screens):
        raise SystemExit(f"refreshIndicators reached {count!r} copies, not {screens}")
    ipc(env, "tamlinux.indicators", "refresh")
    if "TypeError" in read_log(process):
        raise SystemExit("the per-widget indicator refresh threw:\n" + read_log(process)[-3000:])
    if answer("setBarPosition", ["bottom"]) != "bottom":
        raise SystemExit("setBarPosition bottom was refused")
    require(lambda: placed("bottom"), "the bars did not move to the bottom:")
    if json.loads(document.read_text(encoding="utf-8")).get("position") != "bottom":
        raise SystemExit("the bottom position was not saved")
    if answer("setBarPosition", ["left"]) != "unknown":
        raise SystemExit("setBarPosition left was not refused")
    answer("setBarPosition", ["top"])
    require(lambda: placed("top"), "the bars did not return to the top:")
    if answer("toggleBarTransparency") != "transparent" or json.loads(document.read_text(encoding="utf-8")).get("transparent") is not True:
        raise SystemExit("transparency was not turned on and saved")
    if answer("toggleBarTransparency") != "opaque":
        raise SystemExit("transparency was not turned off")
    if answer("setBar", ["off"]) != "hidden":
        raise SystemExit("setBar off did not hide the bar")
    require(lambda: placed("hidden") and flag.exists(), "the hidden bars stayed on screen, or no flag was written:")
    if answer("toggleBar") != "shown":
        raise SystemExit("toggleBar did not show the bar")
    require(lambda: placed("top") and not flag.exists(), "the bar did not come back, or the flag stayed:")
    if answer("setBar", ["sideways"]) != "unknown":
        raise SystemExit("setBar sideways was not refused")
    answer("setBar", ["off"])
    require(lambda: flag.exists(), "the flag was not written for the restart check:")
    print("bar controls checked")


def sway_process_lines() -> list[str]:
    try:
        listing = subprocess.run(
            ["ps", "-u", str(os.getuid()), "-o", "args="],
            capture_output=True, text=True, check=False,
        )
    except OSError:
        return []
    return [line.strip() for line in listing.stdout.splitlines() if "swaymsg" in line]


def drive_sway(env: dict, process: subprocess.Popen) -> None:
    snapshot = snapshot_from_directory(SWAY_FIXTURE)

    def lines() -> list[str]:
        return evidence_lines(read_log(process))

    def require(predicate, message: str) -> None:
        if not wait_for(predicate, 8):
            raise SystemExit(message + "\n" + read_log(process)[-2500:])

    def matched() -> bool:
        text = lines()
        outputs = last_suffix(text, "compositor-outputs ")
        focused = last_suffix(text, "compositor-focused-output ")
        workspaces = last_suffix(text, "compositor-active-workspaces ")
        keymap = last_suffix(text, "compositor-keymap ")
        bindings = last_suffix(text, "compositor-bindings-bytes ")
        windows = last_suffix(text, "compositor-windows ")
        expected_names = [item["name"] for item in snapshot["outputs"]]
        expected_active = sorted(
            {int(item["activeWorkspaceId"]) for item in snapshot["outputs"] if int(item["activeWorkspaceId"]) > 0}
        )
        expected_windows = sum(len(space["windows"]) for space in snapshot["workspaces"])
        return (
            outputs == ",".join(expected_names)
            and focused == snapshot["focusedOutputName"]
            and workspaces == ",".join(str(item) for item in expected_active)
            and keymap == snapshot["activeKeymap"]
            and bindings == str(len(snapshot["bindingsText"]))
            and windows == str(expected_windows)
        )

    require(lambda: "compositor-backend sway" in lines(), "sway adapter did not load:")
    if any(line.startswith("compositor-backend hyprland") for line in lines()):
        raise SystemExit("hyprland adapter loaded during the sway proof")
    require(matched, "sway fixture snapshot did not match:")
    name = next(item["name"] for item in snapshot["outputs"] if item["name"])
    ipc(env, "tamlinux-shell", "compositorFocusWorkspace", ["1"])
    ipc(env, "tamlinux-shell", "compositorFocusOutput", [name])
    ipc(env, "tamlinux-shell", "compositorSetDpms", [name, "off"])
    ipc(env, "tamlinux-shell", "compositorFocusWorkspace", ["99"])
    ipc(env, "tamlinux-shell", "compositorFocusOutput", ["../x"])
    ipc(env, "tamlinux-shell", "compositorSetDpms", [name, "maybe"])
    require(lambda: "compositor-action recorded focus-workspace 1" in lines(), "workspace focus was not recorded:")
    require(lambda: f"compositor-action recorded focus-output {name}" in lines(), "output focus was not recorded:")
    require(lambda: f"compositor-action recorded set-dpms {name} off" in lines(), "dpms was not recorded:")
    require(lambda: "compositor-action rejected focus-workspace" in lines(), "bad workspace id was not rejected:")
    require(lambda: "compositor-action rejected focus-output" in lines(), "bad output name was not rejected:")
    require(lambda: "compositor-action rejected set-dpms" in lines(), "bad dpms action was not rejected:")
    if any(line.startswith("compositor-action live ") for line in lines()):
        raise SystemExit("live compositor action ran during the sway proof")
    log = read_log(process)
    if "swaymsg" in log or "hyprctl" in log:
        raise SystemExit("sway proof started a compositor command")
    if sway_process_lines():
        raise SystemExit("swaymsg is running")


