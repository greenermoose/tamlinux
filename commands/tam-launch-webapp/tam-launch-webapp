if (($# == 0)); then
  echo "Usage: tam-launch-webapp <url> [flags...]" >&2
  exit 1
fi
browser=$(env -u BROWSER xdg-settings get default-web-browser)
case $browser in
google-chrome* | brave* | microsoft-edge* | opera* | vivaldi* | helium* | chromium*) ;;
*) browser="chromium.desktop" ;;
esac
browser_json=$(tam-browser-command "$browser") || exit 1
mapfile -d '' -t browser_command < <(printf '%s' "$browser_json" | jq -j '.[] | . + "\u0000"')
((${#browser_command[@]})) || exit 1
exec setsid uwsm-app -- "${browser_command[@]}" --app="$1" "${@:2}"
