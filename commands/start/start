def read_version() -> str:
    """Return start's own semver from VERSION beside the script or under share/."""
    here = Path(__file__).resolve()
    candidates = [
        here.parent / "VERSION",
        here.parents[1] / "share" / "start" / "VERSION",
    ]
    for path in candidates:
        try:
            if path.is_file():
                val = path.read_text(encoding="utf-8").strip()
                if val:
                    return val
        except OSError:
            continue
    return os.environ.get("START_VERSION") or "0.1.2"


VERSION = read_version()

USE_COLOR = (
    sys.stdout.isatty()
    and "NO_COLOR" not in os.environ
    and os.environ.get("TERM", "") not in ("", "dumb")
)

_ANSI_RE = re.compile(r"\033\[[0-9;]*m")
FOOTER_HINTS = "Down/Up Arrow scroll  Home top  End bottom  Backspace quit"


def _c(seq: str, text: str) -> str:
    return f"\033[{seq}m{text}\033[0m" if USE_COLOR else text


def bold(text: str) -> str:
    return _c("1", text)


def dim(text: str) -> str:
    return _c("2", text)


def green(text: str) -> str:
    return _c("32", text)


def yellow(text: str) -> str:
    return _c("33", text)


def cyan(text: str) -> str:
    return _c("36", text)


def attention_on() -> str:
    """Match tam pager attention: charcoal bg 236 + pale fg 15, else reverse."""
    if not USE_COLOR:
        return ""
    term = os.environ.get("TERM", "")
    colorterm = os.environ.get("COLORTERM", "")
    if "256color" in term or colorterm in ("truecolor", "24bit"):
        return "\033[38;5;15m\033[48;5;236m"
    return "\033[7m"


def attention_off() -> str:
    return "\033[0m" if USE_COLOR else ""


def visible_len(text: str) -> int:
    return len(_ANSI_RE.sub("", text))


def banner_lines() -> list[str]:
    return [
        "       /\\",
        "      /\\/\\",
        "     ///\\\\\\       " + bold("Tamlinux Start"),
        "       ||",
    ]


