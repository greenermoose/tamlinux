        "-" * 88,
    ]
    for s in sessions:
        st = s.get("stages_ms") or {}
        state = "FAILED" if s.get("failed") else ("ACTIVE" if s.get("active") else ("done" if s.get("completed") else "?"))
        lines.append(
            f"{s.get('started_utc', '')[:19]:<21} "
            f"{s.get('compositor', ''):<11} "
            f"{_fmt_ms(st.get('env_preload_ms')):>8} "
            f"{_fmt_ms(st.get('compositor_ms')):>9} "
            f"{_fmt_ms(st.get('session_target_ms')):>8} "
