# tamlinux:summary=Reload compositor configuration (used by Tamlinux theme switching).

if [[ -n ${TAM_PANE_SOCKET:-} && -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
  tam-pane msg reload >/dev/null
else
  hyprctl reload >/dev/null
fi
