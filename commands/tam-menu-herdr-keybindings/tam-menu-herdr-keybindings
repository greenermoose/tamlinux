#!/bin/bash

# tam-menu-herdr-keybindings — list the Herdr keybindings in a searchable menu
# (Menu → Learn → Herdr, SUPER + CTRL + K).
#
#   tam-menu-herdr-keybindings [--print|-p] [--config <path>]
#
# --print writes the list to stdout instead of opening the menu.
#
# Ported from Omarchy 4.0.4 (omarchy-menu-herdr-keybindings) for plan 18
# R4.15h. Changed: the menu is tam-menu-select.
