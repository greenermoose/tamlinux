{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "operation",
    "ready",
    "recoveryArtifacts"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "operation": {
      "enum": [
        "native-update",
        "firmware-update"
      ]
    },
    "ready": {
      "const": true
    },
    "recoveryArtifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "approvedProviderVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "description": "Produced by the separate boot/native recovery owner as a root-owned 0644 record under /var/lib/tamlinux/recovery; consumers rehash artifacts before allowing interactive updates."
}
