installed=()
declare -A installed_exact=()
declare -A selected=()

while IFS= read -r package_name; do
  installed_exact[$package_name]=1
done < <(pacman -Qq)

for pkg in "$@"; do
  [[ $pkg =~ ^[a-zA-Z0-9@_+][a-zA-Z0-9@._+-]*$ ]] || { echo "Invalid package name: $pkg" >&2; exit 2; }
  if [[ -n ${installed_exact[$pkg]} && -z ${selected[$pkg]} ]]; then
    installed+=("$pkg")
    selected[$pkg]=1
  fi
done

if (( ${#installed[@]} > 0 )); then
  sudo /usr/bin/pacman -Rns "${installed[@]}"
fi
