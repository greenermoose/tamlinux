#!/bin/bash

# tam-toggle-idle — switch Stay Awake on or off. While it is on, the Tamlinux
# host's idle service runs no idle cycle and suspend-unless-stay-awake (the
# hypridle suspend) does not suspend.
#
#   tam-toggle-idle [toggle|stay-awake|allow-idle|status]
#
# The state is one file, TAMLINUX_STAY_AWAKE_FILE, by default
# ${XDG_STATE_HOME:-~/.local/state}/tamlinux/stay-awake; the shell uses
# the same path. Native suspend integration must share that selection.
#
# Ported from omarchy 4.0.4 (omarchy-toggle-idle) for plan 18 R4.12; it
# reads the state file from TAMLINUX_STAY_AWAKE_FILE.
