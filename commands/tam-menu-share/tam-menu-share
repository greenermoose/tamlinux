#!/bin/bash

# tam-menu-share — share the clipboard, files, or a folder with LocalSend.
#
#   tam-menu-share <clipboard|file|folder> [path...]
#
# Ported from omarchy 4.0.4 (omarchy-menu-share) for plan 18 R4.15e; it picks
# through tam-file-select and notifies through tam-notification-send.
