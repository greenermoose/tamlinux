#!/bin/bash

# tam-audio-output-volume — adjust output volume and show the OSD.
#
#   tam-audio-output-volume <raise|lower|mute-toggle|+N|-N>
#
# Ported from omarchy 4.0.4 (omarchy-audio-output-volume) for plan 18 R4.2;
# it shows the OSD through tam-osd.
#
# Copyright (c) David Heinemeier Hansson
#
