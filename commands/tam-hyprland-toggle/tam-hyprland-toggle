usage() {
  echo "Usage: tam-hyprland-toggle <flag-name> [on|off|toggle]" >&2
}

if (($# < 1)); then
  usage
  exit 1
fi

FLAG_NAME="$1"
[[ $FLAG_NAME =~ ^[A-Za-z0-9_-]+$ ]] || exit 2
ACTION="${2:-toggle}"
FLAG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/toggles/hypr/$FLAG_NAME.lua"
FLAG_SOURCE="${XDG_CONFIG_HOME:-$HOME/.config}/tamlinux/hyprland/toggles/$FLAG_NAME.lua"

on() {
  if [[ -f $FLAG_SOURCE ]]; then
    tam-settings-preserve monitor --file "$FLAG_FILE" >/dev/null || exit 1
    mkdir -p "$(dirname "$FLAG_FILE")"
    cp "$FLAG_SOURCE" "$FLAG_FILE" || exit 1
  else
    echo "Flag not found: $FLAG_NAME" >&2
    exit 1
  fi
}

off() {
  [[ -e $FLAG_FILE || -L $FLAG_FILE ]] || return 0
  tam-settings-preserve monitor --file "$FLAG_FILE" >/dev/null || exit 1
  rm -f "$FLAG_FILE" || exit 1
}

toggle() {
  if [[ -f $FLAG_FILE ]]; then
    off
    echo "off"
  else
    on
    echo "on"
  fi
}

case $ACTION in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  *)
    usage
    exit 1
    ;;
esac

hyprctl reload >/dev/null
