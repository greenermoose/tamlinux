#!/bin/bash

# tam-brightness-keyboard — adjust keyboard backlight brightness.
#
#   tam-brightness-keyboard [--no-osd] <up|down|cycle|off|restore>
#
# Ported from omarchy 4.0.4 (omarchy-brightness-keyboard) for plan 18 R4.2;
# it shows the OSD through tam-osd.
#
