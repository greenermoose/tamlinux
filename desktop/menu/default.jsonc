  "remove.security.fido2": {"icon":"","label":"Fido2","when":"tam-pkg-present pam-u2f","action":"tam-launch-floating-terminal-with-presentation tam-remove-security-fido2"},
  "remove.security.sshd": {"icon":"󰣀","label":"SSHD","when":"systemctl is-enabled --quiet sshd","action":"tam-launch-floating-terminal-with-presentation tam-remove-security-sshd"},
  "remove.security.sudoless-docker": {"icon":"󰡨","label":"Sudoless Docker","when":"! tam-sudo-docker --configured","action":"tam-launch-floating-terminal-with-presentation tam-remove-security-sudoless-docker"},
