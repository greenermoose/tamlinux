PREFIX ?= /usr/local
.PHONY: check install
check:
	bash -n tam-theme-set-keyboard-asus-rog
install:
	install -Dm755 tam-theme-set-keyboard-asus-rog $(DESTDIR)$(PREFIX)/bin/tam-theme-set-keyboard-asus-rog
	install -Dm644 LICENSE $(DESTDIR)$(PREFIX)/share/licenses/tam-theme-set-keyboard-asus-rog/LICENSE
