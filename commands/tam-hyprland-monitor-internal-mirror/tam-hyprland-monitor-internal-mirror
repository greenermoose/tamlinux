TOGGLE="internal-monitor-mirror"
TOGGLE_FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/toggles/hypr/$TOGGLE.lua"
DISABLE_TOGGLE="internal-monitor-disable"

INTERNAL=$(tam-hyprland-monitor-laptop)
# The first active external monitor
EXTERNAL=$(hyprctl monitors -j | jq -r '.[] | select(.name | test("^(eDP|LVDS|DSI)-") | not).name' | head -n 1)

on() {
  if [[ -z $EXTERNAL ]]; then
    tam-notification-send -g 󰍹 "No external monitors found for mirror"
    exit 1
  fi

  if [[ -z $INTERNAL ]]; then
    tam-notification-send -g 󰍹 "No laptop monitor found to mirror"
    exit 1
  fi

  # Both names are written into generated Lua below, so only plain connector
  # names may pass; a user-created headless output can carry any name.
  for output in "$INTERNAL" "$EXTERNAL"; do
    if [[ ! $output =~ ^[A-Za-z0-9._-]+$ ]]; then
      tam-notification-send -g 󰍹 "Refusing unsafe monitor name"
      exit 1
    fi
  done

  tam-hyprland-toggle $DISABLE_TOGGLE off || exit 1

  if tam-hyprland-toggle-disabled $TOGGLE; then
    tam-settings-preserve monitor --file "$TOGGLE_FLAG" >/dev/null || exit 1
    mkdir -p "${TOGGLE_FLAG%/*}" || exit 1
    printf 'hl.monitor({ output = "%s", mode = "preferred", position = "auto", scale = 1, mirror = "%s" })\n' "$EXTERNAL" "$INTERNAL" >"$TOGGLE_FLAG" || exit 1
    tam-notification-send -g 󰍹 "Mirroring enabled ($EXTERNAL)"
    hyprctl reload
  fi
}

off() {
  if tam-hyprland-toggle-enabled $TOGGLE; then
    tam-hyprland-toggle $TOGGLE off || exit 1
    tam-notification-send -g 󰍹 "Extended mode restored"
  fi
}

toggle() {
  if tam-hyprland-toggle-enabled $TOGGLE; then
    off
  else
    on
  fi
}

recover() {
  if ! tam-hyprland-monitor-external-active && tam-hyprland-toggle-enabled $TOGGLE; then
    tam-hyprland-toggle $TOGGLE off || exit 1
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
