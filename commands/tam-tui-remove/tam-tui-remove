#!/bin/bash

# tam-tui-remove — remove a terminal UI desktop launcher.
#
#   tam-tui-remove [name]
#
# Ported from Omarchy 4.0.4 (omarchy-tui-remove) for plan 18 R4.15h.
# Changed: the picker and the toast go through tam-menu-select and
# tam-notification-send, and the opt-out is TAMLINUX_REMOVE_NOTIFY.
