#!/usr/bin/env python3
"""Launch the isolated Tamlinux clock proof and, with --selftest, check it."""

from __future__ import annotations

import argparse
import json
import os
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

HOST = Path(__file__).resolve().parent / "shell" / "host"
sys.path.insert(0, str(HOST))

from compositor_commands import (  # noqa: E402
    BINDS_LIMIT,
    KEYMAP_LIMIT,
    CompositorCommandError,
    snapshot_from_monitors,
)
from registry import RegistryError, validate_directories  # noqa: E402
from settings_store import SettingsError, read_settings, write_settings  # noqa: E402

PINNED_REVISION = "ed5140ccefc83c0a2fdd5f899bbd290acc35d88a"
SHELL_DIR = Path(__file__).resolve().parent / "shell"
PATCH = Path(__file__).resolve().parent / "adapters" / "clock-step1.patch"
FIXTURE = Path(__file__).resolve().parent / "fixtures" / "panel"
COMPOSITOR = Path(__file__).resolve().parent / "fixtures" / "compositor"
ALLOWED = {"fred.clock", "tamlinux.fixture"}


def clock_repo() -> Path:
    override = os.environ.get("TAMLINUX_CLOCK_SOURCE")
    if override:
        return Path(override)
    return Path(__file__).resolve().parents[1].parent / "clock-fred-tamlinux"


def evidence_lines(text: str) -> list[str]:
    return [line.split("TAMLINUX_EVIDENCE ", 1)[1] for line in text.splitlines() if "TAMLINUX_EVIDENCE " in line]


def wait_for(predicate, timeout: float, interval: float = 0.1):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(interval)
    return None


def _private(path: Path) -> None:
    path.mkdir(parents=True, exist_ok=True)
    os.chmod(path, 0o700)


def _seed(home: Path, config: Path, plugin: Path) -> None:
    _private(config / "fred.clock")
    _private(config / "tamlinux-shell")
    _private(home / ".cache" / "fred.clock")
    _private(home)
    archive = subprocess.run(
        ["git", "-C", str(clock_repo()), "archive", PINNED_REVISION],
        check=True,
        capture_output=True,
    )
    plugin.mkdir()
    subprocess.run(["tar", "-x", "-C", str(plugin)], input=archive.stdout, check=True)
    applied = subprocess.run(
        ["patch", "-p1", "--forward", "--input", str(PATCH)],
        cwd=plugin,
        capture_output=True,
        text=True,
    )
    if applied.returncode != 0:
        raise SystemExit(applied.stderr or applied.stdout)
    now = int(time.time())
    later = now + 30 * 60
    day = time.strftime("%Y-%m-%d", time.localtime(now))
    hour = time.strftime("%H:%M", time.localtime(later))
    events = {
        "updatedAt": now,
        "events": [{
            "summary": "Fixture standup",
            "dateKey": day,
            "endDateKey": day,
            "startTs": later,
            "endTs": later + 1800,
            "allDay": False,
            "color": "#4285f4",
            "account": "Fixture",
                "timeStr": hour,
                "isLocal": False,
                "meetingUrl": "",
                "location": "",
        }],
    }
    cache = home / ".cache" / "fred.clock" / "events.json"
    cache.write_text(json.dumps(events, indent=2) + "\n", encoding="utf-8")
    os.chmod(cache, 0o600)
    calendars = [{
        "enabled": True,
        "account": "Fixture",
        "name": "Local",
        "path": str(config / "fred.clock" / "local.ics"),
    }]
    (config / "fred.clock" / "calendars.json").write_text(json.dumps(calendars, indent=2) + "\n", encoding="utf-8")
    (config / "fred.clock" / "local.ics").write_text(
        "BEGIN:VCALENDAR\nVERSION:2.0\nBEGIN:VEVENT\n"
        f"UID:fixture-standup\nDTSTART:{time.strftime('%Y%m%dT%H%M%S', time.localtime(later))}\n"
        "SUMMARY:Fixture standup\nEND:VEVENT\nEND:VCALENDAR\n",
        encoding="utf-8",
    )
    write_settings(config / "tamlinux-shell", {
        "version": 1,
        "entries": {
            "fred.clock": {
                "id": "fred.clock",
                "format": "dddd HH:mm",
                "formatAlt": "d MMMM 'W'ww yyyy",
                "verticalFormat": "HH\n—\nmm",
                "verticalFormatAlt": "dd\nMMM\n'W'ww\n''yy",
                "badgeMinutes": 60,
            },
            "tamlinux.fixture": {"id": "tamlinux.fixture", "marker": "ready"},
        },
    }, ALLOWED)


def prepare(state: Path, scale: str, output: str, reset: bool = True, copies: str = "1") -> dict:
    home = state / "home"
    config = home / ".config"
    plugin = state / "plugin"
    if reset and state.exists():
        shutil.rmtree(state)
    if reset or not plugin.exists():
        _seed(home, config, plugin)
    if not os.environ.get("XDG_RUNTIME_DIR"):
        raise SystemExit("XDG_RUNTIME_DIR is required; the proof does not use /tmp")
    try:
        records = validate_directories([plugin, FIXTURE, COMPOSITOR])
    except RegistryError as exc:
        raise SystemExit(f"registry rejected a staged plugin: {exc}") from exc
    by_id = {record["id"]: record for record in records}
    env = os.environ.copy()
    env.pop("OMARCHY_PATH", None)
    env.pop("TAMLINUX_COMPOSITOR_LIVE_ACTIONS", None)
    env.update({
        "HOME": str(home),
        "XDG_CONFIG_HOME": str(config),
        "XDG_CACHE_HOME": str(home / ".cache"),
        "XDG_DATA_HOME": str(home / ".local" / "share"),
        "PATH": "/usr/bin",
        "QML_IMPORT_PATH": str(SHELL_DIR / "modules"),
        "TAMLINUX_CLOCK_OFFLINE": "1",
        "TAMLINUX_CLOCK_ENTRY": by_id["fred.clock"]["entry"],
        "TAMLINUX_PANEL_ENTRY": by_id["tamlinux.fixture"]["entry"],
        "TAMLINUX_COMPOSITOR_ENTRY": by_id["tamlinux.compositor"]["entry"],
        "TAMLINUX_PLUGIN_IDS": "fred.clock,tamlinux.fixture",
        "TAMLINUX_HOST_COPIES": copies,
        "TAMLINUX_UI_SCALE": scale,
        "TAMLINUX_OUTPUT": output,
        "QT_QPA_PLATFORM": "wayland",
    })
    return {"env": env, "home": home, "plugin": plugin, "record": records[0]}


def spawn(env: dict) -> subprocess.Popen:
    log = Path(env["HOME"]).parent / "quickshell.log"
    handle = log.open("w", encoding="utf-8")
    process = subprocess.Popen(
        ["/usr/bin/quickshell", "-p", str(SHELL_DIR)],
        env=env,
        stdout=handle,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    process._log_handle = handle  # type: ignore[attr-defined]
    process._log_path = log  # type: ignore[attr-defined]
    return process


def read_log(process: subprocess.Popen) -> str:
    path = process._log_path  # type: ignore[attr-defined]
    try:
        return path.read_text(encoding="utf-8", errors="replace")
    except OSError:
        return ""


def ipc(env: dict, target: str, function: str, args: list[str] | None = None) -> subprocess.CompletedProcess:
    command = ["/usr/bin/quickshell", "ipc", "-p", str(SHELL_DIR), "call", target, function]
    if args:
        command.extend(args)
    return subprocess.run(command, env=env, capture_output=True, text=True, timeout=10)


def stop(process: subprocess.Popen) -> None:
    if process.poll() is None:
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=3)
        except subprocess.TimeoutExpired:
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=3)
    handle = getattr(process, "_log_handle", None)
    if handle:
        handle.close()


def helper_leaks(plugin: Path) -> list[str]:
    try:
        listing = subprocess.run(
            ["ps", "-u", str(os.getuid()), "-o", "pid=,args="],
            capture_output=True, text=True, check=False,
        )
    except OSError:
        return []
    needle = str(plugin)
    return [
        line.strip() for line in listing.stdout.splitlines()
        if ("fetch-events.py" in line or "manage-event.py" in line) and needle in line
    ]


def run_session(state: Path, scale: str, output: str, drive, reset: bool = True, copies: str = "1") -> str:
    prepared = prepare(state, scale, output, reset=reset, copies=copies)
    process = spawn(prepared["env"])
    try:
        ready = wait_for(
            lambda: next((line for line in evidence_lines(read_log(process)) if line.startswith("ready ")), None),
            15,
        )
        if not ready:
            raise SystemExit("clock proof did not become ready:\n" + read_log(process)[-4000:])
        if drive:
            drive(prepared["env"], process)
        log = read_log(process)
    finally:
        stop(process)
    leaks = helper_leaks(prepared["plugin"])
    if leaks:
        raise SystemExit("helper processes still running:\n" + "\n".join(leaks))
    if process.poll() is None:
        raise SystemExit("quickshell did not exit")
    return log


def host_keys(lines: list[str]) -> list[str]:
    keys = []
    for line in lines:
        if line.startswith("bar-created host="):
            key = line.split(" host=", 1)[1].split(" ", 1)[0]
            if key not in keys:
                keys.append(key)
    return keys


def fixture_open(lines: list[str]) -> dict[str, bool]:
    state: dict[str, bool] = {}
    for line in lines:
        if not line.startswith("fixture host=") or " opened=" not in line:
            continue
        key, rest = line.split(" host=", 1)[1].split(" opened=", 1)
        state[key.strip()] = rest.startswith("true")
    return state


def drive_primary(env: dict, process: subprocess.Popen) -> None:
    def lines() -> list[str]:
        return evidence_lines(read_log(process))

    def has(prefix: str) -> bool:
        return any(line.startswith(prefix) for line in lines())

    def contains(text: str) -> bool:
        return any(text in line for line in lines())

    def live_hosts() -> int:
        count = -1
        for line in lines():
            if line.startswith("hosts-live "):
                count = int(line.split()[1])
        return count

    def require(predicate, message: str) -> None:
        if not wait_for(predicate, 5):
            raise SystemExit(message + "\n" + read_log(process)[-2500:])

    opened = ipc(env, "tamlinux.clock", "open")
    if opened.returncode != 0:
        raise SystemExit(opened.stderr or opened.stdout or "open ipc failed")
    require(lambda: has("popup-open=true"), "calendar did not open:")
    require(lambda: has("panel-focus ondemand"), "calendar did not take panel focus:")
    ipc(env, "tamlinux.clock", "close")
    require(lambda: has("popup-open=false"), "calendar did not close:")
    ipc(env, "tamlinux.clock", "cycleFormat")
    require(lambda: has("settings-wrote dddd h:mm AP"), "format cycle did not persist:")
    ipc(env, "tamlinux.clock", "createEvent", ["Fixture", "2026-10-03", "true", "", "", ""])
    require(lambda: "unsupported event-edit" in lines(), "event edit IPC was not refused:")
    ipc(env, "tamlinux-shell", "tooltipProbe")
    require(lambda: has("tooltip "), "tooltip probe produced no evidence:")
    require(lambda: has("hosts-live 2"), "two host instances were not created:")
    require(lambda: sum(1 for line in lines() if line.startswith("clock-loaded host=")) == 1, "clock was not loaded once:")
    require(
        lambda: sum(1 for line in lines() if line.startswith("fixture host=") and line.endswith(" loaded")) >= 2,
        "fixture did not load on both hosts:",
    )
    ipc(env, "tamlinux-shell", "probeWidgets")
    require(lambda: "widgets fred.clock=1 tamlinux.fixture=2" in lines(), "widget census was wrong:")
    ipc(env, "tamlinux-shell", "probeSwitch")
    require(lambda: "switch-result true" in lines(), "panel switch did not move:")
    require(lambda: contains("panel-focus none"), "fixture did not record a non-focus panel:")
    keys = host_keys(lines())
    if len(keys) < 2:
        raise SystemExit(f"expected two host keys, got {keys}")
    ipc(env, "tamlinux-shell", "openOn", [keys[0], "tamlinux.fixture"])
    ipc(env, "tamlinux-shell", "openOn", [keys[1], "tamlinux.fixture"])
    require(lambda: fixture_open(lines()).get(keys[0]) and fixture_open(lines()).get(keys[1]), "both fixtures did not open:")
    ipc(env, "tamlinux.clock", "open")
    require(
        lambda: fixture_open(lines()).get(keys[0]) is False and fixture_open(lines()).get(keys[1]) is True,
        "popout exclusivity did not stay on one host:",
    )
    ipc(env, "tamlinux-shell", "probeClick")
    require(lambda: "click-same true click-other false" in lines(), "click ownership was wrong:")
    ipc(env, "tamlinux-shell", "summon", ["omarchy.osd"])
    require(lambda: "unsupported summon omarchy.osd" in lines(), "osd summon was not refused:")
    ipc(env, "tamlinux-shell", "hide", ["fred.clock"])
    require(lambda: "hidden fred.clock" in lines(), "clock hide did not run:")
    ipc(env, "tamlinux-shell", "toggle", ["tamlinux.fixture"])
    require(lambda: "toggled tamlinux.fixture" in lines(), "fixture toggle did not run:")
    ipc(env, "tamlinux-shell", "writeFixture")
    require(lambda: "settings-wrote tamlinux.fixture marker=step2" in lines(), "fixture setting was not written:")
    ipc(env, "tamlinux-shell", "rejectSettings")
    require(lambda: "settings-rejected omarchy.osd" in lines(), "unknown settings id was not rejected:")
    drive_compositor(env, process, lines, require)
    ipc(env, "tamlinux-shell", "dropHost", [keys[1]])
    require(lambda: contains(f"bar-destroyed host={keys[1]}"), "dropped host was not destroyed:")
    require(lambda: live_hosts() == 1, "surviving host was not kept:")
    if contains(f"bar-destroyed host={keys[0]}"):
        raise SystemExit("dropping one host destroyed the other")
    ipc(env, "tamlinux-shell", "dropOutput")
    require(lambda: has("bar-destroyed "), "output drop did not destroy the bar:")


def last_suffix(lines: list[str], prefix: str) -> str | None:
    found = None
    for line in lines:
        if line.startswith(prefix):
            found = line[len(prefix):]
    return found


def fetch_monitors() -> dict:
    try:
        completed = subprocess.run(
            ["/usr/bin/hyprctl", "-j", "monitors"],
            capture_output=True, text=True, timeout=3, check=False,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        raise SystemExit(f"hyprctl monitors failed: {exc}") from exc
    if completed.returncode != 0:
        raise SystemExit(completed.stderr or "hyprctl monitors failed")
    try:
        data = json.loads(completed.stdout)
    except json.JSONDecodeError as exc:
        raise SystemExit("hyprctl monitors was not json") from exc
    try:
        return snapshot_from_monitors(data)
    except CompositorCommandError as exc:
        raise SystemExit(f"hyprctl monitors snapshot: {exc}") from exc


def compositor_mismatch(lines: list[str], snapshot: dict) -> str:
    outputs = last_suffix(lines, "compositor-outputs ")
    focused = last_suffix(lines, "compositor-focused-output ")
    workspaces = last_suffix(lines, "compositor-active-workspaces ")
    if outputs is None or focused is None or workspaces is None:
        return "compositor snapshot evidence is missing"
    seen = [name for name in outputs.split(",") if name]
    active = [int(item) for item in workspaces.split(",") if item]
    if seen != snapshot["names"]:
        return f"outputs {seen} != {snapshot['names']}"
    if focused != snapshot["focused"]:
        return f"focused {focused!r} != {snapshot['focused']!r}"
    if active != snapshot["workspaces"]:
        return f"workspaces {active} != {snapshot['workspaces']}"
    return ""


def proof_log_is_adapter_only(log: str) -> str:
    for line in log.splitlines():
        if "Quickshell.Hyprland" in line:
            return line
        if "hyprctl" not in line:
            continue
        if "compositor-adapter hyprctl binds " in line:
            continue
        if "compositor-adapter hyprctl devices " in line:
            continue
        if "compositor-adapter hyprctl monitors " in line:
            continue
        return line
    return ""


def drive_compositor(env: dict, process: subprocess.Popen, lines, require) -> None:
    require(lambda: last_suffix(lines(), "compositor-screen-match ") == "true", "screen did not match an output:")
    require(lambda: _bounded_int(last_suffix(lines(), "compositor-bindings-bytes "), 1, BINDS_LIMIT), "bindings text was empty or unbounded:")
    require(lambda: _keymap_ok(last_suffix(lines(), "compositor-keymap ")), "keymap was empty or unbounded:")
    require(lambda: last_suffix(lines(), "compositor-windows ") is not None, "window summary was not published:")
    for label in ("binds", "devices", "monitors"):
        require(lambda label=label: any(line.startswith(f"compositor-adapter hyprctl {label} ") for line in lines()), f"{label} read did not finish:")
    outputs = last_suffix(lines(), "compositor-outputs ") or ""
    name = next((item for item in outputs.split(",") if item), "")
    if not name:
        raise SystemExit("compositor published no output name")
    ipc(env, "tamlinux-shell", "compositorFocusWorkspace", ["1"])
    ipc(env, "tamlinux-shell", "compositorFocusOutput", [name])
    ipc(env, "tamlinux-shell", "compositorSetDpms", [name, "off"])
    ipc(env, "tamlinux-shell", "compositorFocusWorkspace", ["99"])
    ipc(env, "tamlinux-shell", "compositorFocusWorkspace", ["2abc"])
    ipc(env, "tamlinux-shell", "compositorFocusOutput", ["../x"])
    ipc(env, "tamlinux-shell", "compositorSetDpms", [name, "maybe"])
    require(lambda: "compositor-action recorded focus-workspace 1" in lines(), "workspace focus was not recorded:")
    require(lambda: f"compositor-action recorded focus-output {name}" in lines(), "output focus was not recorded:")
    require(lambda: f"compositor-action recorded set-dpms {name} off" in lines(), "dpms was not recorded:")
    require(lambda: lines().count("compositor-action rejected focus-workspace") >= 2, "bad workspace ids were not rejected:")
    require(lambda: "compositor-action rejected focus-output" in lines(), "bad output name was not rejected:")
    require(lambda: "compositor-action rejected set-dpms" in lines(), "bad dpms action was not rejected:")
    if any(line.startswith("compositor-action live ") for line in lines()):
        raise SystemExit("live compositor action ran during the proof")
    leaked = proof_log_is_adapter_only(read_log(process))
    if leaked:
        raise SystemExit("compositor detail escaped the adapter:\n" + leaked)

    last = {"error": "compositor snapshot was not compared"}

    def matched() -> bool:
        try:
            last["error"] = compositor_mismatch(lines(), fetch_monitors())
        except SystemExit as exc:
            last["error"] = str(exc)
            return False
        return last["error"] == ""

    if not wait_for(matched, 8, 0.4):
        raise SystemExit(last["error"] + "\n" + read_log(process)[-2500:])


def _keymap_ok(text: str | None) -> bool:
    return text is not None and text != "" and "\n" not in text and len(text) <= KEYMAP_LIMIT


def _bounded_int(text: str | None, low: int, high: int) -> bool:
    if text is None or not text.isdigit():
        return False
    value = int(text)
    return low <= value <= high


def expect(lines: list[str], text: str) -> None:
    if not any(text in line for line in lines):
        raise SystemExit(f"missing evidence: {text}")


def expect_prefix(lines: list[str], prefix: str) -> None:
    if not any(line.startswith(prefix) for line in lines):
        raise SystemExit(f"missing evidence prefix: {prefix}")


def monitor_names() -> list[str]:
    try:
        completed = subprocess.run(
            ["hyprctl", "monitors", "-j"],
            capture_output=True, text=True, timeout=3, check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return []
    if completed.returncode != 0:
        return []
    try:
        data = json.loads(completed.stdout)
    except json.JSONDecodeError:
        return []
    if not isinstance(data, list):
        return []
    return [str(item.get("name")) for item in data if isinstance(item, dict) and item.get("name")]


def drive_outputs(env: dict, process: subprocess.Popen) -> None:
    def lines() -> list[str]:
        return evidence_lines(read_log(process))

    def live_hosts() -> int:
        count = -1
        for line in lines():
            if line.startswith("hosts-live "):
                count = int(line.split()[1])
        return count

    def screen_count() -> int:
        for line in reversed(lines()):
            if line.startswith("screens "):
                return int(line.split()[1])
        return 0

    if not wait_for(lambda: screen_count() >= 2 and live_hosts() >= screen_count() and len(host_keys(lines())) >= screen_count(), 8):
        return
    keys = host_keys(lines())
    before = live_hosts()
    ipc(env, "tamlinux-shell", "dropHost", [keys[-1]])
    if not wait_for(
        lambda: any(f"bar-destroyed host={keys[-1]}" in line for line in lines()) and live_hosts() == before - 1,
        5,
    ):
        raise SystemExit("dropping one physical output did not leave the others:\n" + read_log(process)[-2500:])
    if any(f"bar-destroyed host={keys[0]}" in line for line in lines()):
        raise SystemExit("dropping one physical output destroyed the other")


def selftest(scale: str, output: str, state_root: Path) -> None:
    primary = state_root / "primary"
    log = run_session(primary, scale, output, drive_primary, copies="2")
    lines = evidence_lines(log)
    expect(lines, "omarchy unset")
    expect(lines, "fetch-suppressed")
    expect_prefix(lines, "popup-open=true")
    expect_prefix(lines, "popup-open=false")
    expect(lines, "unsupported event-edit")
    expect_prefix(lines, "settings-wrote dddd h:mm AP")
    expect_prefix(lines, "tooltip ")
    expect(lines, "output-dropped")
    expect_prefix(lines, "bar-destroyed ")
    expect_prefix(lines, "popup-destroyed")
    expect(lines, "compositor-screen-match true")
    expect(lines, "compositor-action recorded focus-workspace 1")
    expect_prefix(lines, "compositor-action recorded focus-output ")
    expect_prefix(lines, "compositor-action recorded set-dpms ")
    expect(lines, "compositor-action rejected focus-workspace")
    expect(lines, "compositor-adapter hyprctl binds ")
    expect(lines, "compositor-adapter hyprctl devices ")
    expect(lines, "compositor-adapter hyprctl monitors ")
    if any(line.startswith("compositor-action live ") for line in lines):
        raise SystemExit("live compositor action ran during the proof")
    leaked = proof_log_is_adapter_only(log)
    if leaked:
        raise SystemExit("compositor detail escaped the adapter:\n" + leaked)
    if "/usr/share/omarchy" in log:
        raise SystemExit("proof log references the Omarchy shell tree")
    settings = read_settings(primary / "home" / ".config" / "tamlinux-shell" / "settings.json", ALLOWED)
    if settings["entries"]["fred.clock"]["format"] != "dddd h:mm AP":
        raise SystemExit("format was not persisted")
    restarted = run_session(primary, scale, output, None, reset=False, copies="2")
    ready = next(line for line in evidence_lines(restarted) if line.startswith("ready "))
    if "format=dddd h:mm AP" not in ready:
        raise SystemExit(f"restart did not keep the format: {ready}")
    names = monitor_names()
    if len(names) >= 2 and output in ("", "all"):
        output_log = run_session(state_root / "outputs", scale, "all", drive_outputs, copies="1")
        output_lines = evidence_lines(output_log)
        created = host_keys(output_lines)
        destroyed = [line for line in output_lines if line.startswith("bar-destroyed host=")]
        kept = len(created) >= 2 and any(created[-1] in line for line in destroyed) and not any(created[0] in line for line in destroyed)
        if kept:
            print("physical outputs checked")
        else:
            print("physical second output not checked")
    else:
        print("physical second output not checked")
    print("selftest ok")
    print(f"scale {scale}")
    print(f"pinned {PINNED_REVISION}")
    for line in lines:
        if line.startswith(("ready ", "tooltip ", "settings-wrote ", "shell-id ")):
            print(line)


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the isolated Tamlinux clock proof")
    parser.add_argument("--selftest", action="store_true")
    parser.add_argument("--scale", default="1")
    parser.add_argument("--output", default="")
    parser.add_argument("--timeout", type=int, default=120)
    args = parser.parse_args()
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        raise SystemExit("XDG_RUNTIME_DIR is required")
    state_root = Path(runtime) / "tamlinux-clock-proof"
    state_root.mkdir(mode=0o700, exist_ok=True)
    os.chmod(state_root, 0o700)
    if args.selftest:
        try:
            selftest(args.scale, args.output, state_root / f"selftest-{args.scale}")
        except SettingsError as exc:
            raise SystemExit(str(exc)) from exc
        return
    state = state_root / "interactive"
    prepared = prepare(state, args.scale, args.output)
    process = spawn(prepared["env"])
    print(f"proof pid {process.pid}")
    print(f"state {state}")
    print("stop with Ctrl-C; the next launch replaces this isolated state")
    try:
        process.wait(timeout=args.timeout)
    except KeyboardInterrupt:
        stop(process)
    except subprocess.TimeoutExpired:
        stop(process)
        print("proof timed out and was stopped")


if __name__ == "__main__":
    main()
