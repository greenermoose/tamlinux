#!/bin/bash

# tam-audio-source-switch — cycle the media keys to the next (or previous)
# MPRIS player in the Tamlinux shell, moving playback over when the current
# player is playing.
#
#   tam-audio-source-switch [next|previous]
#
# Ported from omarchy 4.0.4 (omarchy-audio-source-switch) for plan 18
# R4.12; it calls tam-shell instead of omarchy-shell.
