state_file="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/defaults/editor"
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

normalize_editor() {
  case "${1:-}" in
    micro) echo "micro" ;;
    nano) echo "nano" ;;
    code) echo "code" ;;
    cursor) echo "cursor" ;;
    zed|zeditor) echo "zeditor" ;;
    sublime_text|sublime) echo "sublime_text" ;;
    helix|hx) echo "helix" ;;
    vim) echo "vim" ;;
    emacs) echo "emacs" ;;
    *) return 1 ;;
  esac
}

if (( $# > 1 )); then
  echo "Usage: tam-default-editor [micro|nano|code|cursor|zed|sublime_text|helix|vim|emacs]" >&2
  exit 1
fi

if (( $# == 0 )); then
  if [[ -r $state_file ]]; then
    IFS= read -r value <"$state_file" || true
    if normalized=$(normalize_editor "$value"); then
      printf '%s\n' "$normalized"
      exit 0
    fi
  fi
  echo "micro"
  exit 0
fi

normalized=$(normalize_editor "$1") || {
  echo "Unsupported default editor: $1" >&2
  exit 1
}

"$script_dir/tam-settings-preserve" default-editor --file "$state_file" >/dev/null || exit 1
mkdir -p "$(dirname "$state_file")"
tmp_file=$(mktemp "$(dirname "$state_file")/.editor.XXXXXX")
printf '%s\n' "$normalized" >"$tmp_file"
mv -f "$tmp_file" "$state_file"
exit 0