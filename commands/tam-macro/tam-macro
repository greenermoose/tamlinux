#!/usr/bin/env python3
"""tam-macro — Tamlinux text-expansion macro CLI and injection engine.

Subcommands:
  run <KEY>                          Injects the text macro for KEY into the active window.
  sync                               Generates ~/.config/tamlinux/hypr/macros.lua and reloads Hyprland.
  list [--json]                      Lists all configured macros.
  add <KEY> <TEXT> [--desc <DESC>]   Adds or updates a macro.
  remove <KEY>                       Removes a macro by key.
"""

from __future__ import annotations

import argparse
import json
import os
import pwd
import subprocess
import sys
import tempfile
import time
from pathlib import Path

VERSION = "0.5.0"
MAX_MACRO_TEXT = 10000

KEY_TO_XKB: dict[str, str] = {
    "/": "slash",
    ".": "period",
    ",": "comma",
    "-": "minus",
    "=": "equal",
    ";": "semicolon",
    "'": "apostrophe",
    "[": "bracketleft",
    "]": "bracketright",
    "\\": "backslash",
    "`": "grave",
    " ": "space",
    "+": "plus",
    "*": "asterisk",
    ":": "colon",
    "<": "less",
    ">": "greater",
    "?": "question",
    "!": "exclam",
    "@": "at",
    "#": "numbersign",
    "$": "dollar",
    "%": "percent",
    "^": "asciicircum",
    "&": "ampersand",
    "(": "parenleft",
    ")": "parenright",
    "_": "underscore",
    "{": "braceleft",
    "}": "braceright",
    "|": "bar",
    "~": "asciitilde",
    '"': "quotedbl",
}


def to_xkb_keysym(key: str) -> str:
    key_clean = key.strip()
    return KEY_TO_XKB.get(key_clean, key_clean)


def get_config_dir() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME")
    if xdg:
        base = Path(xdg)
    else:
        home = os.environ.get("HOME") or pwd.getpwuid(os.getuid()).pw_dir
        base = Path(home) / ".config"
    return base / "tamlinux"


def get_macros_file() -> Path:
    override = os.environ.get("TAMLINUX_MACROS_FILE")
    if override:
        return Path(override)
    return get_config_dir() / "macros.json"


def get_hypr_macros_file() -> Path:
    override = os.environ.get("TAMLINUX_HYPR_MACROS_FILE")
    if override:
        return Path(override)
    return get_config_dir() / "hypr" / "macros.lua"


def load_macros(path: Path) -> list[dict]:
    if not path.is_file():
        return []
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
        if not isinstance(data, list):
            return []
        out = []
        for item in data:
            if not isinstance(item, dict):
                continue
            key = str(item.get("key", "")).strip().upper()
            text = str(item.get("text", ""))
            desc = str(item.get("description", "")).strip()
            if key and text:
                out.append({"key": key, "description": desc, "text": text})
        return out
    except Exception:
        return []


def save_macros(path: Path, macros: list[dict]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = tempfile.NamedTemporaryFile("w", dir=path.parent, delete=False, encoding="utf-8")
    try:
        json.dump(macros, temp, indent=2)
        temp.write("\n")
        temp.flush()
        os.fsync(temp.fileno())
        temp.close()
        os.replace(temp.name, path)
    except Exception:
        if os.path.exists(temp.name):
            os.unlink(temp.name)
        raise


def run_sync() -> None:
    macros_file = get_macros_file()
    lua_file = get_hypr_macros_file()
    lua_file.parent.mkdir(parents=True, exist_ok=True)

    macros = load_macros(macros_file)
    lines = [
        "-- Generated by tam-macro. Do not edit manually.",
        "local bind = (o and o.bind) or (hl and hl.bind) or function(...) end",
        "",
    ]

    for m in macros:
        key = m["key"]
        desc = m.get("description") or f"Macro {key}"
        safe_desc = desc.replace("\\", "\\\\").replace('"', '\\"')
        safe_key = key.replace("\\", "\\\\").replace('"', '\\"')
        xkb_key = to_xkb_keysym(key)
        safe_xkb_key = xkb_key.replace("\\", "\\\\").replace('"', '\\"')
        lines.append(f'bind("SUPER + ALT + {safe_xkb_key}", "Macro: {safe_desc}", "tam-macro run {safe_key}", {{ release = true }})')

    lines.append("")
    temp = tempfile.NamedTemporaryFile("w", dir=lua_file.parent, delete=False, encoding="utf-8")
    try:
        temp.write("\n".join(lines))
        temp.flush()
        os.fsync(temp.fileno())
        temp.close()
        os.replace(temp.name, lua_file)
    except Exception:
        if os.path.exists(temp.name):
            os.unlink(temp.name)
        raise

    # Reload Hyprland if available and not skipped in test
    if not os.environ.get("TAMLINUX_MACRO_SKIP_RELOAD"):
        try:
            subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=5)
        except Exception:
            pass


def active_window_is_terminal() -> bool:
    try:
        res = subprocess.run(
            ["hyprctl", "activewindow", "-j"],
            capture_output=True,
            text=True,
            timeout=2,
            check=True,
        )
        data = json.loads(res.stdout)
        tags = [str(t).rstrip("*") for t in data.get("tags", [])]
        if "terminal" in tags:
            return True
        cls = str(data.get("class", "")).lower()
        if cls in ("foot", "kitty", "alacritty", "wezterm"):
            return True
    except Exception:
        pass
    return False


def inject_text(text: str) -> None:
    # Brief pause to ensure physical modifier release events have been processed
    time.sleep(0.05)

    # Copy text to clipboard via stdin (clean, non-blocking, handles special characters)
    try:
        subprocess.run(["wl-copy"], input=text.encode("utf-8"), check=True, timeout=2)
    except Exception as e:
        sys.stderr.write(f"tam-macro: error copying text to clipboard: {e}\n")
        sys.exit(1)

    time.sleep(0.05)

    is_term = active_window_is_terminal()
    mods = "SHIFT" if is_term else "CTRL"
    key = "Insert" if is_term else "V"

    # Dispatch paste keystroke via Hyprland Lua dispatcher
    # Using separate down and up state to prevent synthetic key sticking
    # (matching desktop/session/hypr/tamlinux/bindings/clipboard.lua)
    dispatched = False
    try:
        r1 = subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.send_key_state({{ mods = "{mods}", key = "{key}", state = "down" }})'],
            capture_output=True,
            text=True,
            timeout=2,
        )
        time.sleep(0.05)
        r2 = subprocess.run(
            ["hyprctl", "dispatch", f'hl.dsp.send_key_state({{ mods = "{mods}", key = "{key}", state = "up" }})'],
            capture_output=True,
            text=True,
            timeout=2,
        )
        if r1.returncode == 0 and r2.returncode == 0:
            dispatched = True
    except Exception:
        pass

    if not dispatched:
        # Fallback to wtype
        try:
            if is_term:
                subprocess.run(
                    ["wtype", "-M", "shift", "-k", "Insert", "-m", "shift"],
                    capture_output=True,
                    timeout=2,
                )
            else:
                subprocess.run(
                    ["wtype", "-M", "ctrl", "-k", "v", "-m", "ctrl"],
                    capture_output=True,
                    timeout=2,
                )
        except Exception as e:
            sys.stderr.write(f"tam-macro: error sending paste shortcut: {e}\n")
            sys.exit(1)


def main():
    parser = argparse.ArgumentParser(
        prog="tam-macro",
        description="Tamlinux text-expansion macro CLI and injection engine.",
    )
    parser.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")

    subparsers = parser.add_subparsers(dest="subcommand", help="Subcommand to execute")

    run_parser = subparsers.add_parser("run", help="Inject macro text for key")
    run_parser.add_argument("key", help="Key name (e.g. M, RETURN, F1)")

    subparsers.add_parser("sync", help="Generate Hyprland macros.lua and reload config")

    list_parser = subparsers.add_parser("list", help="List macros")
    list_parser.add_argument("--json", action="store_true", help="Output JSON format")

    add_parser = subparsers.add_parser("add", help="Add or update a macro")
    add_parser.add_argument("key", help="Key name (e.g. M, 1, RETURN)")
    add_parser.add_argument("text", help="Text phrase to inject")
    add_parser.add_argument("--desc", default="", help="Optional description")

    remove_parser = subparsers.add_parser("remove", help="Remove a macro")
    remove_parser.add_argument("key", help="Key name to remove")

    args = parser.parse_args()

    if not args.subcommand:
        parser.print_help(sys.stderr)
        sys.exit(1)

    macros_file = get_macros_file()

    if args.subcommand == "run":
        target_key = args.key.strip()
        macros = load_macros(macros_file)
        macro = next((m for m in macros if m["key"] == target_key or m["key"].upper() == target_key.upper()), None)
        if not macro:
            macro = next((m for m in macros if to_xkb_keysym(m["key"]).upper() == target_key.upper()), None)
        if not macro:
            sys.stderr.write(f"tam-macro: no macro found for key '{args.key}'\n")
            sys.exit(1)
        inject_text(macro["text"])

    elif args.subcommand == "sync":
        run_sync()

    elif args.subcommand == "list":
        macros = load_macros(macros_file)
        if args.json:
            print(json.dumps(macros, indent=2))
        else:
            if not macros:
                print("No macros configured.")
            else:
                for m in macros:
                    desc = f" ({m['description']})" if m.get("description") else ""
                    preview = m["text"].replace("\n", "\\n")
                    if len(preview) > 50:
                        preview = preview[:47] + "..."
                    print(f"Meta + Alt + {m['key']}{desc}: \"{preview}\"")

    elif args.subcommand == "add":
        key = args.key.strip().upper()
        text = args.text
        desc = args.desc.strip()
        if not key:
            sys.stderr.write("tam-macro: key cannot be empty\n")
            sys.exit(1)
        if not text:
            sys.stderr.write("tam-macro: text cannot be empty\n")
            sys.exit(1)
        if len(text) > MAX_MACRO_TEXT:
            sys.stderr.write(f"tam-macro: text exceeds maximum length of {MAX_MACRO_TEXT}\n")
            sys.exit(1)

        macros = load_macros(macros_file)
        existing = next((m for m in macros if m["key"] == key), None)
        if existing:
            existing["text"] = text
            if desc:
                existing["description"] = desc
        else:
            macros.append({"key": key, "description": desc, "text": text})

        save_macros(macros_file, macros)
        run_sync()

    elif args.subcommand == "remove":
        key = args.key.strip().upper()
        macros = load_macros(macros_file)
        new_macros = [m for m in macros if m["key"] != key]
        if len(new_macros) == len(macros):
            sys.stderr.write(f"tam-macro: no macro found for key '{args.key}'\n")
            sys.exit(1)
        save_macros(macros_file, new_macros)
        run_sync()


if __name__ == "__main__":
    main()
