#!/bin/bash

# tam-sudo-keepalive — ask for the sudo password once and keep it fresh while
# the calling script runs. Source it; do not run it.
#
#   source tam-sudo-keepalive
#
# Ported from Omarchy 4.0.4 (omarchy-sudo-keepalive) for plan 18 R4.15h.
# Changed: the background loop no longer holds the caller's stdin or stdout.
