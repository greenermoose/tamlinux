#!/bin/bash

# tam-launch-or-focus-tui — focus the terminal for a TUI, or launch it.
#
#   tam-launch-or-focus-tui [--app-id=<app-id>] <command> [args...]
#
# The default app-id is org.tamlinux.<command>, which tam-launch-tui uses too,
# so the same window is focused the next time.
#
# Derived from Omarchy 4.0.4 (historical source attribution).
# Implementation and integration are maintained by Tamlinux.
