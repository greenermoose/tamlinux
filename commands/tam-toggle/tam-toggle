#!/bin/bash

# tam-toggle — turn a Tamlinux feature flag on or off.
#
#   tam-toggle <flag-name> [toggle|on|off]
#
# Ported from Omarchy 4.0.4 (omarchy-toggle) for plan 18 R4.15d. Flags live
# in ~/.local/state/tamlinux/toggles/ instead of Omarchy's state directory.
