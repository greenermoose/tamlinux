#!/usr/bin/env python3
"""Deploy committed Tamlinux main revisions through Home Manager generations.

status: show deployed, locked and main revisions; fail on stale Test metadata.
test <commit>: deploy an ancestor of main without changing flake.lock.
run: pin the tested revision (or main), switch, record and commit the pin.
back: activate the previous generation and restart the services.
"""
from __future__ import annotations

import getpass
import json
import os
import subprocess
import sys
import time
from pathlib import Path


class DeploymentError(Exception):
    pass


def command(*args: str, capture: bool = False, quiet: bool = False) -> str:
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.PIPE if quiet else None, check=True)
    return result.stdout.strip() if capture else ""


def find_config_repo(home: Path) -> Path:
    """TAMLINUX_CONFIG_REPO, else the one ~/Code/tamlinux/* checkout that holds
    config/tamlinux/plugins (the same rule tam-plugin uses)."""
    if os.environ.get("TAMLINUX_CONFIG_REPO"):
        return Path(os.environ["TAMLINUX_CONFIG_REPO"])
    root = home / "Code/tamlinux"
    matches = sorted(d for d in root.glob("*/") if (d / "config/tamlinux/plugins").is_dir()) if root.is_dir() else []
    if len(matches) != 1:
        raise DeploymentError("set TAMLINUX_CONFIG_REPO to the Home Manager configuration checkout")
    return matches[0]


class Deployment:
    def __init__(self):
        self.home = Path.home()
        self.config = find_config_repo(self.home)
        self.home_configuration = os.environ.get("TAMLINUX_HOME_CONFIGURATION") or getpass.getuser()
        self.source = Path(os.environ.get("TAMLINUX_SOURCE_REPO", self.home / "Code/tamlinux/tamlinux"))
        data = Path(os.environ.get("XDG_DATA_HOME", self.home / ".local/share"))
        state = Path(os.environ.get("XDG_STATE_HOME", self.home / ".local/state"))
        self.revision_file = data / "tamlinux/shell-revision"
        self.state_file = state / "tamlinux/shell-deploy.json"
        self.profile = state / "nix/profiles/home-manager"
        self.lock = self.config / "flake.lock"

    def read_state(self) -> dict:
        return json.loads(self.state_file.read_text()) if self.state_file.exists() else {}

    def save_state(self, state: dict) -> None:
        self.state_file.parent.mkdir(parents=True, exist_ok=True)
        temp = self.state_file.with_suffix(".tmp")
        temp.write_text(json.dumps(state, indent=2) + "\n")
        temp.replace(self.state_file)

    def deployed(self) -> str:
        return self.revision_file.read_text().strip() if self.revision_file.exists() else "checkout (not deployed)"

    def locked(self) -> str:
        document = json.loads(self.lock.read_text())
        node = document["nodes"]["root"]["inputs"].get("tamlinux")
        return document["nodes"][node]["locked"]["rev"] if node else "not pinned"

    def commit(self, ref: str) -> str:
        revision = command("git", "-C", str(self.source), "rev-parse", "--verify", "--end-of-options",
                           ref + "^{commit}", capture=True)
        command("git", "-C", str(self.source), "merge-base", "--is-ancestor", revision, "main")
        return revision

    def generation(self) -> str:
        if not self.profile.is_symlink():
            raise DeploymentError(f"Home Manager profile not found: {self.profile}")
        return str(self.profile.resolve(strict=True))

    def status(self) -> None:
        deployed, locked = self.deployed(), self.locked()
        tested = self.read_state().get("testedCommit")
        print(f"deployed: {deployed}\nlocked:   {locked}\nmain:     {self.commit('main')}")
        print("test override: " + ("active" if deployed != locked else "off"))
        print("saved Test candidate: " + (tested or "none"))
        print(f"generation: {self.generation()}")
        if tested and tested != deployed:
            raise DeploymentError("saved Test candidate is not deployed; restore Test before acceptance or Run")

    def url(self, revision: str) -> str:
        return f"git+{self.source.as_uri()}?ref=main&rev={revision}"

    def preflight(self) -> None:
        # Reject dirty deployment inputs so a generation has an identifiable
        # config commit. Run records may be accumulated after activation.
        dirty = command("git", "-C", str(self.config), "status", "--porcelain", "--untracked-files=all",
                        "--", ".", ":(exclude)system/bom.json", ":(exclude)system/plugin-runs",
                        capture=True)
        if dirty:
            raise DeploymentError("commit config changes before deploying:\n" + dirty)
        command("systemctl", "--user", "is-active", "graphical-session.target", capture=True)
        session = os.environ.get("XDG_SESSION_ID")
        if session and command("loginctl", "show-session", session, "-p", "LockedHint", "--value", capture=True) == "yes":
            raise DeploymentError("unlock the session before deploying")

    def switch(self, revision: str, test: bool) -> None:
        args = ["home-manager", "switch", "--flake", f"{self.config}#{self.home_configuration}"]
        if test:
            args += ["--override-input", "tamlinux", self.url(revision), "--no-write-lock-file"]
        command(*args)
        command("tam-restart-shell")
        if self.deployed() != revision:
            raise DeploymentError("active shell revision does not match requested commit")
        self.wait_ready()

    def wait_ready(self) -> None:
        for _ in range(40):
            try:
                if command("tam-shell", "reminders", "ping", capture=True, quiet=True) == "pong":
                    return
            except subprocess.CalledProcessError:
                pass
            time.sleep(0.2)
        raise DeploymentError("deployed shell did not become reachable through tam-shell")

    def test(self, ref: str) -> None:
        revision = self.commit(ref)
        self.preflight()
        previous = self.generation()
        self.save_state({"previousGeneration": previous})
        self.switch(revision, test=True)
        self.save_state({"previousGeneration": previous, "testedCommit": revision})
        self.status()

    def run(self) -> None:
        state = self.read_state()
        # An ordinary Home Manager switch can replace Test without clearing
        # its metadata. Never turn that mismatch into promotion of main.
        tested = state.get("testedCommit")
        if tested and tested != self.deployed():
            raise DeploymentError("saved Test candidate is not deployed; restore Test before Run")
        revision = self.commit(tested or "main")
        self.preflight()
        previous = self.generation()
        self.save_state({"previousGeneration": previous})
        before = self.lock.read_bytes()
        try:
            command("nix", "flake", "lock", "--update-input", "tamlinux", "--override-input",
                    "tamlinux", self.url(revision), str(self.config))
            # The pin is exact, but its declared source remains main, matching
            # flake.nix. An explicit later run can select a newer main head.
            lock = json.loads(self.lock.read_text())
            node = lock["nodes"]["root"]["inputs"]["tamlinux"]
            lock["nodes"][node]["original"] = {"type": "git", "url": self.source.as_uri(), "ref": "main"}
            self.lock.write_text(json.dumps(lock, indent=2) + "\n")
            self.switch(revision, test=False)
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError):
            self.lock.write_bytes(before)
            raise
        bom_path = self.config / "system/bom.json"
        bom = json.loads(bom_path.read_text())
        bom["components"]["shell"] = {"commit": revision, "generation": self.generation()}
        bom_path.write_text(json.dumps(bom, indent=2) + "\n")
        trailers = ""
        if os.environ.get("CODEX_THREAD_ID") or os.environ.get("CLAUDECODE"):
            detector = self.home / ".agents/skills/ai-provenance/scripts/detect-runtime.sh"
            trailers = "\n\n" + command(str(detector), "--trailers", capture=True)
        command("git", "-C", str(self.config), "add", "--", "flake.lock", "system/bom.json")
        changed = subprocess.run(["git", "-C", str(self.config), "diff", "--cached", "--quiet",
                                  "--", "flake.lock", "system/bom.json"]).returncode
        if changed:
            command("git", "-C", str(self.config), "commit", "--only", "-m",
                    f"shell: run deployed Tamlinux {revision[:12]}" + trailers,
                    "--", "flake.lock", "system/bom.json")
        self.save_state({"previousGeneration": previous})
        self.status()

    def back(self) -> None:
        state = self.read_state()
        previous = state.get("previousGeneration")
        if not previous:
            # Also support the first deployment before this command existed.
            current = self.profile.readlink().name
            number = int(current.removeprefix("home-manager-").removesuffix("-link"))
            older = [p for p in self.profile.parent.glob("home-manager-*-link")
                     if int(p.name.removeprefix("home-manager-").removesuffix("-link")) < number]
            if not older:
                raise DeploymentError("no previous Home Manager generation")
            previous = str(max(older, key=lambda p: int(p.name.split("-")[-2])).resolve())
        target = Path(previous)
        if not str(target).startswith("/nix/store/") or not (target / "activate").is_file():
            raise DeploymentError("previous generation was removed or is invalid")
        current = self.generation()
        command(str(target / "activate"))
        command("tam-restart-shell")
        self.save_state({"previousGeneration": current})
        self.wait_ready()
        self.status()


def main(argv: list[str]) -> int:
    if argv in (["--help"], ["-h"]):
        print(__doc__)
        return 0
    if argv not in (["status"], ["run"], ["back"]) and not (len(argv) == 2 and argv[0] == "test"):
        print("usage: tam-shell-deploy status | test <commit> | run | back", file=sys.stderr)
        return 2
    try:
        deployment = Deployment()
        getattr(deployment, argv[0])(*argv[1:])
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as exc:
        print(f"tam-shell-deploy: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
