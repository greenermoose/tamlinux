agent_file="${XDG_CONFIG_HOME:-$HOME/.config}/tamlinux/defaults/agent"

usage() {
  echo "Usage: tam-default-agent [--installed|--install] <pi|omp|opencode|claude|codex|grok|gemini|copilot|crush|cursor-agent|muse>" >&2
  exit 1
}

if (($# == 0)); then
  exec tam-agent --current
fi

mode=select
case "$1" in
--installed) mode=installed; shift ;;
--install) mode=install; shift ;;
esac
(($# == 1)) || usage

case "$1" in
pi) agent=pi; name=Pi ;;
omp | oh-my-pi) agent=omp; name="Oh My Pi"; agent_package="github:can1357/oh-my-pi" ;;
opencode | open-code) agent=opencode; name=OpenCode ;;
claude | claude-code) agent=claude; name="Claude Code" ;;
codex) agent=codex; name=Codex ;;
crush) agent=crush; name=Crush ;;
grok) agent=grok; name=Grok; agent_package="npm:@xai-official/grok" ;;
gemini | gemini-cli) agent=gemini; name=Gemini ;;
copilot | github-copilot) agent=copilot; name="GitHub Copilot" ;;
muse | muse-code | musecode)
  agent=muse; name="Muse Code"
  agent_package="http:muse[url=https://api.meta.ai/muse-launcher.sh,bin=muse,version_list_url=https://api.meta.ai/muse-code/channels/muse-stable,version_json_path=.version]"
  ;;
cursor | cursor-agent) agent=cursor-agent; name="Cursor CLI" ;;
*) usage ;;
esac
agent_package=${agent_package:-$agent}

if [[ $mode == installed ]]; then
  exec tam-cmd-present "$agent"
fi

# Preserve the user's own executable or symlink instead of shadowing it with
# a Mise install. Read a Mise bootstrap stub without executing it.
user_install() {
  [[ -x $HOME/.local/bin/$agent ]] &&
    { [[ -L $HOME/.local/bin/$agent ]] || ! grep -q '^mise use -g' "$HOME/.local/bin/$agent"; }
}
agent_present() { user_install || mise where "$agent_package" &>/dev/null; }

if [[ $mode == select ]] && ! agent_present; then
  exec tam-launch-floating-terminal-with-presentation tam-default-agent --install "$agent"
fi

if ! user_install && ! mise use -g "$agent_package"; then
  echo "Could not install $name with mise; the default agent is unchanged" >&2
  exit 1
fi

# Commit the new choice only after installation succeeds. An interrupted or
# failed write must not truncate the previous selection.
mkdir -p "$(dirname "$agent_file")" || exit 1
selection=$(mktemp "$agent_file.XXXXXX") || exit 1
trap 'rm -f "$selection"' EXIT
printf '%s\n' "$agent" >"$selection" || exit 1
mv -f -- "$selection" "$agent_file" || exit 1
trap - EXIT

if [[ $mode == install ]]; then
  printf '\033[2J\033[3J\033[H'
  exec tam-agent --inline
else
  exec tam-agent
fi
