#!/bin/bash

# tam-menu-file — pick a file from the Tamlinux menu, newest first.
#
#   tam-menu-file <label> <paths> <formats> [menu args...]
#
# Ported from omarchy 4.0.4 (omarchy-menu-file) for plan 18 R4.15e; it opens
# tam-menu-select.
