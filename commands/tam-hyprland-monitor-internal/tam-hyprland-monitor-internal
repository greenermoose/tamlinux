TOGGLE="internal-monitor-disable"
TOGGLE_FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/toggles/hypr/$TOGGLE.lua"
MIRROR_TOGGLE="internal-monitor-mirror"

INTERNAL=$(tam-hyprland-monitor-laptop)

wake() {
  hyprctl dispatch 'hl.dsp.dpms({ action = "enable" })' >/dev/null 2>&1 || true
}

on() {
  if tam-hyprland-toggle-enabled $TOGGLE; then
    tam-hyprland-toggle $TOGGLE off || exit 1
    tam-notification-send -g 󰍹 "Laptop display enabled"
  fi

  wake
}

off() {
  if [[ -z $INTERNAL ]]; then
    tam-notification-send -g 󰍹 "No laptop display found"
    exit 1
  fi

  # The name is written into generated Lua below, so only a plain connector
  # name may pass; anything else could execute on the next reload.
  if [[ ! $INTERNAL =~ ^[A-Za-z0-9._-]+$ ]]; then
    tam-notification-send -g 󰍹 "Refusing unsafe monitor name"
    exit 1
  fi

  if ! tam-hyprland-monitor-external-active; then
    tam-notification-send -g 󰍹 "Can't disable the only active display"
    exit 1
  fi

  if tam-hyprland-toggle-disabled $TOGGLE && tam-hyprland-toggle-disabled $MIRROR_TOGGLE; then
    tam-settings-preserve monitor --file "$TOGGLE_FLAG" >/dev/null || exit 1
    mkdir -p "${TOGGLE_FLAG%/*}" || exit 1
    printf 'hl.monitor({ output = "%s", disabled = true })\n' "$INTERNAL" >"$TOGGLE_FLAG" || exit 1
    tam-notification-send -g 󰍹 "Laptop display disabled"
    hyprctl reload
  fi
}

recover() {
  # Runs from the clamshell watcher every few seconds, so it must be a no-op
  # unless it actually re-enables a display: an unconditional wake here undoes
  # lock-screen blanking and races the resume modeset into a visible flash.
  tam-hyprland-monitor-external-active && return 0
  tam-hyprland-toggle-enabled $TOGGLE || return 0

  tam-hyprland-toggle $TOGGLE off || exit 1
  wake
}

toggle() {
  if tam-hyprland-toggle-enabled $TOGGLE; then
    on
  else
    off
  fi
}

case "$1" in
  on) on ;;
  off) off ;;
  toggle) toggle ;;
  recover) recover ;;
  *)
    echo "Usage: $(basename "$0") {on|off|toggle|recover}" >&2
    exit 1
    ;;
esac
