#!/bin/bash

# tam-remove-security-fingerprint — take fingerprint authentication out of sudo
# and polkit and remove its packages.
#
# Ported from Omarchy 4.0.4 (omarchy-remove-security-fingerprint) for plan
# 18 R4.15g. Changed: it removes both forms of the clamshell gate (the shell
# test tam-setup-security-fingerprint writes, and the packaged helper the
# inherited setup wrote). It leaves the inherited lock-screen PAM file alone;
# nothing reads it since the lock moved to hyprlock.
