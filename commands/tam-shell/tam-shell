#!/bin/bash

# tam-shell — send an IPC call to the running Tamlinux shell
# (tamlinux/desktop/shell). It does not start the host.
#
#   tam-shell [-q] <target> <method> [args...]
#   tam-shell notifications dismissOne
#
# -q: quiet best-effort mode; succeed even when the host, target, or method
# is missing.
#
# Derived from Omarchy 4.0.4 (historical source attribution).
# Implementation and integration are maintained by Tamlinux.
#
