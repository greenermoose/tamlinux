#!/bin/bash

# tam-dns — show or set the system DNS provider.
#
#   tam-dns [Cloudflare|Google|DHCP|Custom]
#
# Ported from Omarchy 4.0.4 (omarchy-dns) for plan 18 R4.15g. Changed: root
# comes from pkexec on this script's own Nix-store copy, so the session's
# polkit agent asks for a password on every change (D68). There is no sudoers
# rule, and a copy outside the store (a checkout under test) refuses to
# elevate. The NetworkManager drop-in is 20-tamlinux-dns.conf.
#
