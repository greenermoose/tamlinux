def format_compare_human(agg: dict[str, Any]) -> str:
    comps = agg.get("compositors") or {}
    saved = agg.get("saved_samples") or {}
    if not comps and not saved:
        return "No completed or active graphical sessions found to compare.\n"

    names = sorted(comps.keys() | saved.keys(), key=lambda x: (x != "Hyprland", x != "tam-pane", x))
    c_left = "Hyprland"
    c_right = "tam-pane"
    if not any(name in names for name in (c_left, c_right)):
        c_left, c_right = names[0], names[1] if len(names) > 1 else None

    def cell(comp_name: str | None, metric_key: str, unit: str) -> str:
        if not comp_name or comp_name not in comps:
            return "-"
        m = comps[comp_name].get(metric_key)
        if not m:
            return "-"
        if unit == "ms":
            return f"{m['median']:.0f} ms [{m['min']:.0f}–{m['max']:.0f}] n={m['n']}"
        if unit == "MiB":
            return f"{m['median']:.1f} MiB (n={m['n']})"
        if unit == "%":
            return f"{m['median']:.2f}% (n={m['n']})"
        return f"{m['median']:.2f} (n={m['n']})"

    def med(comp_name: str | None, metric_key: str) -> float | None:
        if not comp_name or comp_name not in comps:
            return None
        m = comps[comp_name].get(metric_key)
        return float(m["median"]) if m else None

    right_hdr = c_right or "(none)"
    lines = [
        f"Session Comparison (median across {agg.get('session_count', 0)} sessions)",
        "",
        f"{'Metric':<26} {c_left:>18} {right_hdr:>18} {'Delta (' + right_hdr + ' vs ' + c_left + ')':>26}",
        "-" * 92,
    ]
    rows = [
        ("Startup: Env Preload", "env_preload_ms", "ms"),
        ("Startup: Compositor Ready", "compositor_ms", "ms"),
        ("Startup: Session Target", "session_target_ms", "ms"),
        ("Startup: Shell Ready", "shell_ready_ms", "ms"),
        ("Startup: Total to Desktop", "total_ms", "ms"),
        ("Compositor: Memory Peak", "wm_mem_peak_mib", "MiB"),
        ("Compositor: Swap Peak", "wm_swap_peak_mib", "MiB"),
        ("Compositor: Avg CPU", "wm_avg_cpu_pct", "%"),
        ("Shell: Memory Peak", "shell_mem_peak_mib", "MiB"),
        ("Shell: Avg CPU", "shell_avg_cpu_pct", "%"),
    ]
    for label, key, unit in rows:
        lines.append(
            f"{label:<26} "
            f"{cell(c_left, key, unit):>18} "
            f"{cell(c_right, key, unit):>18} "
            f"{_fmt_delta(med(c_left, key), med(c_right, key), unit):>26}"
        )

    if saved:
        lines.append("")
        lines.append(f"Saved Timed Samples (median across {agg.get('saved_sample_count', 0)} runs)")
        lines.append(
            f"{'Metric':<26} {c_left:>18} {right_hdr:>18} {'Delta (' + right_hdr + ' vs ' + c_left + ')':>26}"
        )
        lines.append("-" * 92)
        s_rows = [
            ("Compositor: Delta CPU", "wm_cpu_pct", "%"),
            ("Compositor: GPU GFX", "wm_gpu_gfx_pct", "%"),
            ("Compositor: PSS", "wm_pss_mib", "MiB"),
            ("Compositor: VRAM", "wm_vram_mib", "MiB"),
            ("Shell: Delta CPU", "shell_cpu_pct", "%"),
            ("Shell: PSS", "shell_pss_mib", "MiB"),
            ("System: APU Power", "power_w", "W"),
        ]
        for label, key, unit in s_rows:
            lv = (saved.get(c_left) or {}).get(key)
            rv = (saved.get(c_right) or {}).get(key) if c_right else None
            def sample_cell(metric):
                if not metric:
                    return "-"
                return (f"{metric['median']:.2f} {unit} "
                        f"[{metric['min']:.2f}–{metric['max']:.2f}] n={metric['n']}")
            ltxt, rtxt = sample_cell(lv), sample_cell(rv)
            lines.append(
                f"{label:<26} {ltxt:>18} {rtxt:>18} "
                f"{_fmt_delta(lv['median'] if lv else None, rv['median'] if rv else None, unit):>26}"
            )

    return "\n".join(lines) + "\n"


def comparison_time(value: str) -> datetime:
    try:
        result = datetime.fromisoformat(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("expected an ISO 8601 timestamp with timezone") from exc
    if result.tzinfo is None:
        raise argparse.ArgumentTypeError("expected an ISO 8601 timestamp with timezone")
    return result


def at_or_after(value: str, since: datetime) -> bool:
    try:
        return comparison_time(value) >= since
    except (argparse.ArgumentTypeError, TypeError):
        return False


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tam-session-bench",
        description="Measure and compare graphical session startup time and resource usage (Hyprland vs tam-pane).",
    )
    parser.add_argument("-v", "--version", action="version", version=f"tam-session-bench {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p_start = sub.add_parser("startup", help="Show startup stage timings from the user journal")
    p_start.add_argument("--boot", default="0", help="Boot selector passed to journalctl -b (default: 0)")
    p_start.add_argument("--boots", type=int, default=None, help="Inspect the last N boots")
    p_start.add_argument("--all-boots", action="store_true", help="Inspect all boots in the user journal")
    p_start.add_argument("--json", action="store_true", help="Output structured JSON")

    p_now = sub.add_parser("now", help="Show live resource snapshot of the active graphical session")
    p_now.add_argument("--json", action="store_true", help="Output structured JSON")

    p_samp = sub.add_parser("sample", help="Sample compositor, shell, and system power over a timed window")
    p_samp.add_argument("--seconds", type=float, default=30.0, help="Measurement window in seconds (default: 30)")
    p_samp.add_argument("--minutes", type=float, default=None, help="Measurement window in minutes (overrides --seconds)")
    p_samp.add_argument("--interval", type=float, default=2.0, help="Sample interval in seconds (default: 2)")
    p_samp.add_argument("--settle", type=float, default=0.0, help="Settle delay before sampling in seconds (default: 0)")
    p_samp.add_argument("--label", default="", help="Optional label (e.g. idle, coding, browser)")
    p_samp.add_argument("--save", action="store_true", help="Save sample JSON under ~/.local/state/tamlinux/session-bench/")
    p_samp.add_argument("--json", action="store_true", help="Output structured JSON")

    p_cmp = sub.add_parser("compare", help="Compare Hyprland vs tam-pane startup and resource usage side-by-side")
    p_cmp.add_argument("--boot", default="0", help="Boot selector (default: 0)")
    p_cmp.add_argument("--boots", type=int, default=None, help="Compare across the last N boots")
    p_cmp.add_argument("--all-boots", action="store_true", help="Compare across all boots in the user journal")
    p_cmp.add_argument("--samples", action="store_true", help="Include saved timed sample runs even if no journal sessions exist")
    p_cmp.add_argument("--since", type=comparison_time, help="Include records from this ISO 8601 timestamp")
    p_cmp.add_argument("--label", help="Include only saved samples with this exact label")
    p_cmp.add_argument("--json", action="store_true", help="Output structured JSON")

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)

    if args.command == "now":
        snap = collect_live_snapshot()
        if args.json:
            print(json.dumps(snap, indent=2, sort_keys=True))
        else:
            sys.stdout.write(format_now_human(snap))
        return 0

    if args.command == "startup":
        entries = fetch_journal_entries(boot=args.boot, boots_count=args.boots, all_boots=args.all_boots)
        sessions = parse_journal_sessions(entries)
        merge_active_session_resources(sessions, collect_live_snapshot())
        if args.json:
            print(json.dumps({"sessions": sessions}, indent=2, sort_keys=True))
        else:
            sys.stdout.write(format_startup_human(sessions))
        return 0

    if args.command == "sample":
        duration_s = args.minutes * 60.0 if args.minutes is not None else args.seconds
        if duration_s <= 0 or args.interval <= 0 or args.settle < 0:
            print("tam-session-bench: duration and interval must be positive; settle must be >= 0", file=sys.stderr)
            return 2
        rec = run_timed_sample(duration_s=duration_s, interval_s=args.interval, settle_s=args.settle, label=args.label)
        saved_path = save_sample_record(rec) if args.save else None
        if args.json:
            if saved_path:
                rec["saved_path"] = str(saved_path)
            print(json.dumps(rec, indent=2, sort_keys=True))
        else:
            sys.stdout.write(format_sample_human(rec, saved_path=saved_path))
        return 0

    if args.command == "compare":
        entries = fetch_journal_entries(boot=args.boot, boots_count=args.boots, all_boots=args.all_boots)
        sessions = parse_journal_sessions(entries)
        merge_active_session_resources(sessions, collect_live_snapshot())
        saved = load_saved_samples()
        if args.since is not None:
            sessions = [s for s in sessions if at_or_after(s.get("started_utc", ""), args.since)]
            saved = [s for s in saved if at_or_after(s.get("timestamp_utc", ""), args.since)]
        if args.label is not None:
            saved = [s for s in saved if s.get("label") == args.label]
        agg = aggregate_comparison(sessions, saved_samples=saved)
        if args.json:
            print(json.dumps(agg, indent=2, sort_keys=True))
        else:
            sys.stdout.write(format_compare_human(agg))
        return 0

    return 2


if __name__ == "__main__":
    sys.exit(main())
