#!/bin/bash

# tam-toggle-input-device — enable, disable, or toggle a Hyprland input device.
#
#   tam-toggle-input-device <touchpad|touchscreen> [on|off|toggle]
#
# Ported from omarchy 4.0.4 (omarchy-toggle-input-device) for plan 18 R4.2;
# it shows the OSD through tam-osd and, since R4.15e, finds the device through
# tam-hw-touchpad or tam-hw-touchscreen. The disabled-device state file keeps
# its path, which config/hypr/tamlinux/disabled-input-device.lua reads.
#
