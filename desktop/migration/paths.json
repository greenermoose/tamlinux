      "root": "state",
      "source": "omarchy/toggles/skip-cursor-theme-changes",
      "target": "tamlinux/toggles/skip-cursor-theme-changes",
      "conversion": "bytes"
    },
    {
      "id": "touchpad-disabled-name",
      "root": "state",
      "source": "omarchy/toggles/hypr/touchpad-disabled-name",
      "target": "tamlinux/toggles/hypr/touchpad-disabled-name",
      "conversion": "device-name"
    },
    {
      "id": "touchscreen-disabled-name",
      "root": "state",
      "source": "omarchy/toggles/hypr/touchscreen-disabled-name",
      "target": "tamlinux/toggles/hypr/touchscreen-disabled-name",
      "conversion": "device-name"
