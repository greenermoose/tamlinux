#!/bin/bash

# tam-menu-tmux-keybindings — list the tmux keybindings, with their notes, in
# a searchable menu (Menu → Learn → Tmux, SUPER + ALT + K).
#
#   tam-menu-tmux-keybindings [--print|-p] [--config <path>]
#
# --print writes the list to stdout instead of opening the menu.
#
# Ported from Omarchy 4.0.4 (omarchy-menu-tmux-keybindings) for plan 18
# R4.15h. Changed: the menu is tam-menu-select. With no tmux config, it
# reports that and exits instead of reading the Omarchy package's default.
