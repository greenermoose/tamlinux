  "trigger.tests.disk-speedtest": {"icon":"󰋊","label":"Disk Speed Test","action":"tam-shell tamlinux.panels summon tamlinux.disk-speedtest"},
  "style.theme": {"icon":"󰸌","label":"Theme","aliases":["theme","themes"],"action":"theme=$(tam-theme-switcher); [[ -n $theme ]] && tam-theme-set \"$theme\""},
  "style.background": {"icon":"","label":"Background","aliases":["background","wallpaper"],"action":"background=$(tam-theme-bg-switcher); [[ -n $background ]] && tam-theme-bg-set \"$background\""},
  "style.unlock": {"icon":"󰟵","label":"Unlock","aliases":["unlock"],"action":"unlock=$(tam-plymouth-switcher); if [[ $unlock == default ]]; then tam-launch-floating-terminal-with-presentation omarchy-plymouth-reset; elif [[ -n $unlock ]]; then tam-launch-floating-terminal-with-presentation \"omarchy-plymouth-set-by-theme $(printf %q \"$unlock\")\"; fi"},
  "style.font": {"icon":"","label":"Font","provider":"fonts"},
  "style.bar": {"icon":"󰍜","label":"Menu Bar"},
  "style.bar.position": {"icon":"","label":"Position"},
  "style.bar.transparency": {"icon":"󰂵","label":"Transparency","action":"tam-shell tamlinux-shell toggleBarTransparency"},
  "style.hyprland": {"icon":"","label":"Hyprland","action":"tam-launch-config-editor \"$HOME/.config/hypr/looknfeel.lua\""},
  "style.screensaver": {"icon":"󱄄","label":"Screensaver"},
  "style.about": {"icon":"","label":"About"},
