    print("bottom bar checked")
    def drive_unsupported(env: dict, process: subprocess.Popen) -> None:
        def at_top() -> bool:
            return any(line.startswith("bar-created ") and line.endswith(" position=top") for line in evidence_lines(read_log(process)))

        if not wait_for(at_top, 10):
            raise SystemExit("a left bar was not drawn at the top:\n" + read_log(process)[-4000:])

    unsupported = run_session(state_root / "layout-left", scale, output, drive_unsupported, copies="1", extras=True, layout=True, position="left")
    expect(evidence_lines(unsupported), 'bar-position-unsupported "left"')
    print("unsupported position checked")
    print("selftest ok")
    print(f"scale {scale}")
    print(f"pinned {PINNED_REVISION}")
    for line in lines:
        if line.startswith(("ready ", "tooltip ", "settings-wrote ", "shell-id ")):
            print(line)


def main() -> None:
    parser = argparse.ArgumentParser(description="Run the isolated Tamlinux clock proof")
    parser.add_argument("--selftest", action="store_true")
    parser.add_argument("--plugins", action="store_true", help="load the seven plugins beside the clock")
    parser.add_argument("--layout", action="store_true", help="draw the default bar layout (shell widgets and all eight plugins); implies --plugins")
    parser.add_argument("--scale", default="1")
    parser.add_argument("--output", default="")
    parser.add_argument("--position", choices=("top", "bottom"), default=None, help="with --layout, the bar's edge (default top)")
    parser.add_argument("--compositor", choices=("hyprland", "sway"), default="hyprland")
    parser.add_argument("--timeout", type=int, default=120, help="seconds before the interactive proof stops; 0 waits until interrupted")
    args = parser.parse_args()
    runtime = os.environ.get("XDG_RUNTIME_DIR")
    if not runtime:
        raise SystemExit("XDG_RUNTIME_DIR is required")
    state_root = Path(runtime) / "tamlinux-clock-proof"
    state_root.mkdir(mode=0o700, exist_ok=True)
    os.chmod(state_root, 0o700)
    if args.selftest:
        try:
            if args.compositor == "sway":
                sway_selftest(args.scale, args.output, state_root / f"sway-{args.scale}")
            else:
                selftest(args.scale, args.output, state_root / f"selftest-{args.scale}")
        except SettingsError as exc:
            raise SystemExit(str(exc)) from exc
        return
    state = state_root / "interactive"
    extras = args.plugins or args.layout
    prepared = prepare(state, args.scale, args.output, extras=extras, compositor=args.compositor, layout=args.layout, position=args.position)
    if args.plugins and not args.layout:
        prepared["env"]["TAMLINUX_PLUGINS_ON_ALL"] = "1"
    process = spawn(prepared["env"])
    print(f"proof pid {process.pid}")
    print(f"state {state}")
    print("stop with Ctrl-C; the next launch replaces this isolated state")
    try:
        if args.timeout <= 0:
            process.wait()
        else:
            process.wait(timeout=args.timeout)
    except KeyboardInterrupt:
        stop(process)
    except subprocess.TimeoutExpired:
        stop(process)
        print("proof timed out and was stopped")


if __name__ == "__main__":
    main()
