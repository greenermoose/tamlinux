resolve_tam_bin() {
  local name=$1
  local local_bin=""
  if [[ -n ${HOME:-} ]]; then
    local_bin="$HOME/.local/bin/$name"
    if [[ -f $local_bin && -x $local_bin ]]; then
      printf '%s\n' "$local_bin"
      return 0
    fi
  fi
  printf '/usr/bin/tamlinux/%s\n' "$name"
}

if [[ $# == 1 && $1 == --tam-last ]]; then
  shell=$(resolve_tam_bin tam-clam)
  terminal=$(resolve_tam_bin tam-last)
  exec setsid uwsm-app -t service -- /usr/bin/env -C "$(tam-cmd-terminal-cwd)" \
    "SHELL=$shell" "$terminal" -e "$shell"
fi

exec setsid uwsm-app -t service -- xdg-terminal-exec --dir="$(tam-cmd-terminal-cwd)" "$@"
