#!/bin/bash

# tam-drive-password — set a new encryption password for a drive selected.
#
#   tam-drive-password
#
# Ported from Omarchy 4.0.4 (omarchy-drive-password) for plan 18 R4.15i.
# Changed: the drive picker is tam-drive-select.

