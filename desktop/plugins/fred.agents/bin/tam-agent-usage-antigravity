#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Antigravity usage into one display-ready JSON record.

Prompt and session counts come from local CLI history and summaries; live plan
usage and subscription tier come from Google's Cloud Code quota endpoints,
authorized with the OAuth access token agy keeps in the system keyring
(service=gemini, username=antigravity), read read-only. Nothing sensitive is
printed or written: the token exists only inside the Authorization header,
and the record and limits cache carry only percentages and reset times.

When the keyring token expires, the collector falls back to invoking agy
non-interactively (`agy --output-format json -p /usage`), which automatically
refreshes credentials and updates the keyring.
"""

import argparse
import datetime as _dt
import fcntl
import hashlib
import json
import os
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Start agy or sign in to restore live usage."
QUOTA_ENDPOINT = "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary"
LOAD_CODE_ASSIST_ENDPOINT = "https://daily-cloudcode-pa.googleapis.com/v1internal:loadCodeAssist"
PROBE_MIN_INTERVAL_SECONDS = 15

SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

MAX_FILE_BYTES = 128 * 1024 * 1024
VOID_TS = "0001-01-01"


def number(value):
  try:
    return int(value or 0)
  except Exception:
    return 0


def local_day_ms(value):
  try:
    ts = number(value)
    if ts > 10_000_000_000:
      ts = ts / 1000
    return datetime.fromtimestamp(ts).strftime("%Y-%m-%d")
  except Exception:
    return datetime.now().strftime("%Y-%m-%d")


def local_day_iso(value):
  if not value or not isinstance(value, str) or value.startswith(VOID_TS):
    return None
  try:
    dt = datetime.fromisoformat(value)
    if dt.tzinfo is not None:
      dt = dt.astimezone()
    return dt.strftime("%Y-%m-%d")
  except Exception:
    return None


def scan_history(prompts_by_day):
  """Count prompts from history.jsonl, skipping slash_command rows."""
  path = Path.home() / ".gemini" / "antigravity-cli" / "history.jsonl"
  if not path.is_file():
    return
  try:
    if path.stat().st_size > MAX_FILE_BYTES:
      print("tam-agent-usage-antigravity: history.jsonl exceeds size cap; skipping", file=sys.stderr)
      return
  except OSError:
    return
  for raw in open(path, errors="replace"):
    try:
      entry = json.loads(raw)
    except Exception:
      continue
    if not isinstance(entry, dict):
      continue
    if entry.get("type") == "slash_command":
      continue
    timestamp = entry.get("timestamp")
    if not isinstance(timestamp, (int, float)):
      continue
    day = local_day_ms(timestamp)
    prompts_by_day[day] = prompts_by_day.get(day, 0) + 1


def scan_conversation_summaries(sessions_by_day, all_session_ids):
  """Distinct conversations from conversation_summaries.db.

  Read-only and WAL-tolerant; any failure only skips this session source and
  never invalidates the history scan. A conversation whose day cannot be
  resolved still counts toward the session total.
  """
  db = Path.home() / ".gemini" / "antigravity-cli" / "conversation_summaries.db"
  if not db.is_file():
    return
  try:
    conn = sqlite3.connect(db.resolve().as_uri() + "?mode=ro", uri=True, timeout=2)
  except sqlite3.Error as exc:
    print(f"tam-agent-usage-antigravity: could not open conversation_summaries.db ({exc})", file=sys.stderr)
    return
  try:
    conn.execute("PRAGMA query_only = ON")
    for row in conn.execute("SELECT conversation_id, last_user_input_time, last_modified_time FROM conversation_summaries"):
      try:
        conversation_id, last_user, last_modified = row
        all_session_ids.add(conversation_id)
        day = local_day_iso(last_user) or local_day_iso(last_modified)
        if day is not None:
          sessions_by_day.setdefault(day, set()).add(conversation_id)
      except Exception:
        continue
  except sqlite3.Error as exc:
    print(f"tam-agent-usage-antigravity: conversation_summaries.db scan failed ({exc})", file=sys.stderr)
    return
  finally:
    try:
      conn.close()
    except Exception:
      pass


def cache_root():
  root = Path(os.environ.get("XDG_CACHE_HOME") or (Path.home() / ".cache")) / "omarchy" / "agent-usage"
  root.mkdir(parents=True, exist_ok=True)
  return root


def scan_cache_paths():
  home = Path.home()
  history = home / ".gemini" / "antigravity-cli" / "history.jsonl"
  db = home / ".gemini" / "antigravity-cli" / "conversation_summaries.db"
  digest = hashlib.sha1((str(home) + "\n" + str(history) + "\n" + str(db)).encode("utf-8")).hexdigest()[:16]
  root = cache_root()
  return root / f"antigravity-scan-{digest}.json", root / f"antigravity-scan-{digest}.lock"


def read_fresh_json(path, max_age_seconds):
  if max_age_seconds <= 0 or not path.exists():
    return None
  try:
    age = time.time() - path.stat().st_mtime
    if 0 <= age <= max_age_seconds:
      return json.loads(path.read_text(encoding="utf-8"))
  except Exception:
    return None
  return None


def write_json(path, payload):
  handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
  tmp = Path(tmp_name)
  try:
    with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
      handle.write(json.dumps(payload, separators=(",", ":")) + "\n")
    tmp.chmod(0o644)
    tmp.replace(path)
  except BaseException:
    tmp.unlink(missing_ok=True)
    raise


def read_cached_stats(cache_file, max_age_seconds):
  cached = read_fresh_json(cache_file, max_age_seconds)
  if not isinstance(cached, dict) or cached.get("schemaVersion") != 1:
    return None
  if cached.get("scanDate") != datetime.now().strftime("%Y-%m-%d"):
    return None
  stats = cached.get("stats")
  if not isinstance(stats, dict):
    return None
  for key in ("todayPrompts", "todaySessions", "todayTotalTokens", "recentDays", "totalPrompts", "totalSessions", "activeDays", "activeDates", "modelUsage"):
    if key not in stats:
      return None
  return stats


def write_cached_stats(cache_file, stats):
  try:
    write_json(cache_file, {"schemaVersion": 1, "scanDate": datetime.now().strftime("%Y-%m-%d"), "stats": stats})
  except Exception as exc:
    print(f"tam-agent-usage-antigravity: could not write usage cache ({exc})", file=sys.stderr)


def local_stats():
  prompts_by_day = {}
  scan_history(prompts_by_day)
  sessions_by_day = {}
  all_session_ids = set()
  scan_conversation_summaries(sessions_by_day, all_session_ids)

  now = datetime.now()
  today = now.strftime("%Y-%m-%d")
  recent_dates = [(now - _dt.timedelta(days=offset)).strftime("%Y-%m-%d") for offset in range(6, -1, -1)]
  active_dates = set(prompts_by_day.keys()) | set(sessions_by_day.keys())
  return {
    "todayPrompts": prompts_by_day.get(today, 0),
    "todaySessions": len(sessions_by_day.get(today, set())),
    "todayTotalTokens": 0,
    "todayTokensByModel": {},
    "recentDays": [{"date": day, "messageCount": prompts_by_day.get(day, 0)} for day in recent_dates],
    "totalPrompts": sum(prompts_by_day.values()),
    "totalSessions": len(all_session_ids),
    "activeDays": len(active_dates),
    "activeDates": sorted(active_dates),
    "modelUsage": {},
  }


def cached_local_stats(max_age):
  try:
    return _cached_local_stats(max_age)
  except Exception as exc:
    print(f"tam-agent-usage-antigravity: cache unavailable ({exc}); scanning directly", file=sys.stderr)
    return local_stats()


def _cached_local_stats(max_age):
  cache_file, lock_file = scan_cache_paths()

  cached = read_cached_stats(cache_file, max_age)
  if cached is not None:
    return cached

  with lock_file.open("w") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    cached = read_cached_stats(cache_file, max_age)
    if cached is not None:
      return cached
    stats = local_stats()
    write_cached_stats(cache_file, stats)
    return stats


# ---------------------------------------------------------------- live usage
#
# Antigravity plan limits and subscription tier come from Google's Cloud Code
# API, authorized with the OAuth token agy keeps in the system keyring.

def runtime_env():
  home = str(Path.home())
  path_parts = [
    os.environ.get("PATH", ""),
    f"{home}/.local/bin",
    f"{home}/.npm-global/bin",
    f"{home}/.local/share/mise/shims",
  ]
  env = os.environ.copy()
  env["PATH"] = os.pathsep.join(part for part in path_parts if part)
  return env


ENV = runtime_env()


def keyring_auth():
  """Read Antigravity's stored OAuth token from the system keyring.

  Returns (access_token, expires_at_ts).
  """
  try:
    proc = subprocess.run(
      ["secret-tool", "lookup", "service", "gemini", "username", "antigravity"],
      capture_output=True, text=True, timeout=3, env=ENV
    )
    if proc.returncode != 0 or not proc.stdout.strip():
      return "", 0
    data = json.loads(proc.stdout.strip())
    token_info = data.get("token", {})
    access_token = str(token_info.get("access_token") or "")
    expiry_str = str(token_info.get("expiry") or "")
    expiry_ts = 0
    if expiry_str:
      try:
        dt = datetime.fromisoformat(expiry_str)
        if dt.tzinfo is not None:
          expiry_ts = dt.timestamp()
      except Exception:
        pass
    return access_token, expiry_ts
  except Exception:
    return "", 0


def format_bucket_entry(gname, b):
  window = str(b.get("window") or "")
  rem = float(b.get("remainingFraction", b.get("remaining_fraction", 1.0)))
  used = round(max(0.0, min(1.0, 1.0 - rem)), 4)
  reset = str(b.get("resetTime", b.get("reset_time", "")) or "")
  bname = str(b.get("displayName", b.get("name", "")) or "")

  if "gemini" in gname.lower():
    prefix = "Gemini"
  elif "claude" in gname.lower() or "gpt" in gname.lower():
    prefix = "Claude & GPT"
  else:
    prefix = gname

  if window == "5h" or "5" in bname:
    wlabel = "5-hour"
  elif window == "weekly" or "week" in bname.lower():
    wlabel = "Weekly"
  else:
    wlabel = bname

  title = f"{prefix} {wlabel}"
  label = f"{prefix} ({wlabel})"
  return {
    "label": label,
    "title": title,
    "percent": used,
    "resetsAt": reset,
  }


def probe_limits_http(access_token):
  """Probe Google Cloud Code quota summary and subscription tier."""
  headers = {
    "Authorization": f"Bearer {access_token}",
    "Content-Type": "application/json",
    "User-Agent": "Antigravity",
  }

  quota_req = urllib.request.Request(
    QUOTA_ENDPOINT,
    data=json.dumps({"project": "default-cli-project"}).encode("utf-8"),
    headers=headers
  )
  try:
    with urllib.request.urlopen(quota_req, timeout=6) as resp:
      quota_data = json.loads(resp.read().decode("utf-8"))
  except urllib.error.HTTPError as err:
    return {"ok": False, "code": err.code, "helpText": f"Antigravity quota endpoint returned status {err.code}."}
  except Exception:
    return {"ok": False, "transport": True, "helpText": "Couldn't reach Antigravity quota endpoint."}

  limits = []
  for group in quota_data.get("groups", []):
    gname = str(group.get("displayName") or "")
    for b in group.get("buckets", []):
      limits.append(format_bucket_entry(gname, b))

  tier_label = ""
  tier_req = urllib.request.Request(
    LOAD_CODE_ASSIST_ENDPOINT,
    data=json.dumps({"metadata": {"ideType": "ANTIGRAVITY"}}).encode("utf-8"),
    headers=headers
  )
  try:
    with urllib.request.urlopen(tier_req, timeout=5) as resp:
      tier_data = json.loads(resp.read().decode("utf-8"))
      paid = tier_data.get("paidTier")
      if isinstance(paid, dict):
        tier_label = str(paid.get("name") or "")
      if not tier_label:
        curr = tier_data.get("currentTier")
        if isinstance(curr, dict):
          tier_label = str(curr.get("name") or "")
  except Exception:
    pass

  return {"ok": True, "limits": limits, "tierLabel": tier_label}


def probe_limits_cli():
  """Run agy non-interactively to refresh credentials and fetch limits."""
  agy_bin = shutil.which("agy", path=ENV.get("PATH"))
  if not agy_bin:
    return {"ok": False, "helpText": "agy CLI not found in PATH."}
  try:
    proc = subprocess.run(
      [agy_bin, "--output-format", "json", "-p", "/usage"],
      capture_output=True, text=True, timeout=12, env=ENV
    )
    if proc.returncode != 0 or not proc.stdout.strip():
      return {"ok": False, "helpText": "agy CLI failed to return usage."}
    data = json.loads(proc.stdout.strip())
    groups = data.get("command", {}).get("data", {}).get("groups", [])
    limits = []
    for group in groups:
      gname = str(group.get("name") or "")
      for b in group.get("buckets", []):
        limits.append(format_bucket_entry(gname, b))
    return {"ok": True, "limits": limits, "tierLabel": "Google AI Pro"}
  except Exception as exc:
    return {"ok": False, "helpText": f"agy CLI invocation error: {exc}"}


def limit_window_open(entry, now):
  raw = str(entry.get("resetsAt") or "")
  if raw == "":
    return True
  try:
    resets_at = datetime.fromisoformat(raw.replace("Z", "+00:00"))
  except Exception:
    return True
  if resets_at.tzinfo is None:
    resets_at = resets_at.replace(tzinfo=timezone.utc)
  return resets_at > now


def usable_cached_limits(cached):
  entries = cached.get("limits")
  if not isinstance(entries, list):
    return []
  now = datetime.now(timezone.utc)
  return [entry for entry in entries if isinstance(entry, dict) and limit_window_open(entry, now)]


def collect_limits(force):
  result = {"limits": [], "tierLabel": "", "usageStatusText": "", "authHelpText": AUTH_HELP}
  probe_cache = cache_root() / "antigravity-limits.json"
  cached = read_fresh_json(probe_cache, float("inf")) or {}
  fallback = usable_cached_limits(cached)
  tier_fallback = str(cached.get("tierLabel") or "")

  fetched_at = number(cached.get("fetchedAtMs")) / 1000
  if fallback and not force and time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS:
    result["limits"] = fallback
    result["tierLabel"] = tier_fallback
    return result

  access_token, expiry_ts = keyring_auth()

  # If access token exists and is valid for at least 60 more seconds, try fast HTTP probe
  if access_token and (expiry_ts == 0 or expiry_ts > time.time() + 60):
    probe = probe_limits_http(access_token)
    if probe.get("ok"):
      result["limits"] = probe["limits"]
      result["tierLabel"] = probe.get("tierLabel") or tier_fallback or "Google AI Pro"
      write_json(probe_cache, {
        "fetchedAtMs": round(time.time() * 1000),
        "limits": result["limits"],
        "tierLabel": result["tierLabel"]
      })
      return result
    if probe.get("code") not in (401, 403) and probe.get("transport"):
      # Network/DNS down
      if fallback:
        result["limits"] = fallback
        result["tierLabel"] = tier_fallback
        return result

  # Token expired, missing, or HTTP probe failed with 401/403: invoke CLI to refresh
  cli_probe = probe_limits_cli()
  if cli_probe.get("ok"):
    result["limits"] = cli_probe["limits"]
    result["tierLabel"] = cli_probe.get("tierLabel") or tier_fallback or "Google AI Pro"
    write_json(probe_cache, {
      "fetchedAtMs": round(time.time() * 1000),
      "limits": result["limits"],
      "tierLabel": result["tierLabel"]
    })
    return result

  # Fallback to cached limits if still open
  if fallback:
    result["limits"] = fallback
    result["tierLabel"] = tier_fallback
  else:
    result["usageStatusText"] = "Antigravity limits unavailable"
    result["authHelpText"] = cli_probe.get("helpText") or AUTH_HELP

  return result


def main():
  parser = argparse.ArgumentParser()
  parser.add_argument("--force", action="store_true")
  parser.add_argument("--limits-only", action="store_true")
  args = parser.parse_args()

  max_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else SCAN_REUSE_SECONDS)
  stats = cached_local_stats(max_age)
  limits_info = collect_limits(args.force)

  record = {
    "schemaVersion": 1,
    "id": AGENT_ID,
    "name": AGENT_NAME,
    "updatedAt": datetime.now(timezone.utc).isoformat(),
    "ready": True,
    "hasLocalStats": True,
    "tierLabel": limits_info["tierLabel"],
    "usageStatusText": limits_info["usageStatusText"],
    "authHelpText": limits_info["authHelpText"],
    "limits": limits_info["limits"],
    # Antigravity exposes no token ledger; the prompt-mode panel uses this to
    # show prompt charts where Claude/Codex show token charts.
    "tokensAvailable": False,
    "hasPromptStats": True,
    "scope": "device",
  }
  record.update(stats)
  print(json.dumps(record, separators=(",", ":")))


if __name__ == "__main__":
  main()