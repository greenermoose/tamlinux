#!/bin/bash

# tam-launch-tui — run a terminal program in its own terminal window.
#
#   tam-launch-tui [--app-id=<app-id>] <command> [args...]
#
# The window's app-id defaults to org.tamlinux.<command>, which the Hyprland
# terminal and floating rules match (config/hypr/tamlinux/apps/).
