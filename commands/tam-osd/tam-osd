#!/bin/bash

# tam-osd — show the on-screen display in the Tamlinux shell.
#
#   tam-osd [-i|--icon <icon>] [-m|--message <text>] [-p|--progress <0-100>] [-d|--duration <ms>]
#
# Ported from omarchy 4.0.4 (omarchy-osd) for plan 18 R4.2;
# it calls tam-shell instead of omarchy-shell.
#
