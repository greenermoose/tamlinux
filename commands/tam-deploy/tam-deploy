)


def generation_version(generation: Path | str) -> str | None:
    """Return the Tamlinux version stamped in a Home Manager generation, if known."""
    gen_path = Path(generation)
    version_file = gen_path / "home-files/.config/tamlinux/version"
    try:
        if version_file.is_file():
            value = version_file.read_text(encoding="utf-8").strip()
            if value and re.fullmatch(r"[A-Za-z0-9._+-]+", value):
                return value
    except OSError:
        pass
    activate_file = gen_path / "activate"
    try:
        if activate_file.is_file():
            text = activate_file.read_text(encoding="utf-8", errors="replace")
            match = re.search(r"\bTAMLINUX_VERSION=([A-Za-z0-9._+-]+)", text)
            if match:
                return match.group(1)
    except OSError:
        pass
    return None


def _is_hm_symlink(path: Path, relative_path: str) -> bool:
    """True when path is already a symlink into a Home Manager generation."""
    if not path.is_symlink():
        return False
    try:
        target = os.readlink(path)
    except OSError:
        return False
    normalized = Path(target).as_posix()
    store_root = Path(os.path.realpath("/nix/store")).as_posix()
    if (fnmatch.fnmatch(normalized, "/nix/store/*-home-manager-files/*")
            or fnmatch.fnmatch(normalized, f"{store_root}/*-home-manager-files/*")):
        return True
    if Path(target).is_absolute() and normalized.endswith(f"/home-files/{relative_path}"):
        return True
    return False


def find_home_file_conflicts(
    generation: Path | str,
    home: Path | None = None,
    version: str | None = None,
) -> list[dict]:
    """Return a deterministic sorted list of unmanaged $HOME paths that
    generation/home-files would overwrite."""
    gen_path = Path(generation)
    home_path = Path(home) if home is not None else Path.home()
    home_files = gen_path / "home-files"
    if not home_files.exists():
        return []
    resolved_version = (version.strip() if isinstance(version, str) and version.strip()
                        else generation_version(gen_path))
    suffix = f".pre-{resolved_version}" if resolved_version else ".pre-tamlinux"
    conflicts: dict[str, dict] = {}

    def record_conflict(rel: str, target: Path) -> None:
        if rel not in conflicts:
            backup = Path(f"{target}{suffix}")
            conflicts[rel] = {
                "path": str(target),
                "relativePath": rel,
                "backupPath": str(backup),
                "backupExists": os.path.lexists(backup),
            }

    def walk(directory: Path) -> None:
        try:
            entries = sorted(os.scandir(directory), key=lambda e: e.name)
        except OSError:
            return
        for entry in entries:
            entry_path = Path(entry.path)
            rel = entry_path.relative_to(home_files).as_posix()
            target = home_path / rel
            if entry.is_symlink() or entry.is_file(follow_symlinks=False):
                if os.path.lexists(target) and not _is_hm_symlink(target, rel):
                    record_conflict(rel, target)
            elif entry.is_dir(follow_symlinks=False):
                if (os.path.lexists(target)
                        and not _is_hm_symlink(target, rel)
                        and not target.is_dir()):
                    record_conflict(rel, target)
                else:
                    walk(entry_path)

    walk(home_files)
    return [conflicts[key] for key in sorted(conflicts)]


def command(*args: str, capture: bool = False, quiet: bool = False) -> str:
    result = subprocess.run(args, text=True, stdout=subprocess.PIPE if capture else None,
                            stderr=subprocess.PIPE if quiet else None, check=True)
    return result.stdout.strip() if capture else ""


def find_config_repo(home: Path) -> Path:
    """TAMLINUX_CONFIG_REPO, else the one ~/Code/tamlinux/* checkout whose
    flake.lock has a tamlinux-packages input."""
    if os.environ.get("TAMLINUX_CONFIG_REPO"):
        return Path(os.environ["TAMLINUX_CONFIG_REPO"])
    root = home / "Code/tamlinux"
    matches = []
    for lock in sorted(root.glob("*/flake.lock")) if root.is_dir() else []:
        try:
            inputs = json.loads(lock.read_text())["nodes"]["root"].get("inputs", {})
        except (OSError, ValueError, KeyError):
            continue
        if "tamlinux-packages" in inputs:
            matches.append(lock.parent)
    if len(matches) != 1:
        raise DeploymentError("set TAMLINUX_CONFIG_REPO to the Home Manager configuration checkout")
    return matches[0]


class Deployment:
    def __init__(self):
        self.home = Path.home()
        self.config = find_config_repo(self.home)
        self.hostname = os.uname().nodename
        host_path = self.config / "hosts" / self.hostname / "host.json"
        if (self.config / "hosts").is_dir():
            if not host_path.is_file():
                raise DeploymentError("local hostname has no registered host profile")
            host = json.loads(host_path.read_text())
            if host.get("hostname") != self.hostname or host.get("username") != getpass.getuser():
                raise DeploymentError("registered host identity does not match this account")
            expected_profile = f"{host['username']}@{self.hostname}"
            self.home_configuration = os.environ.get("TAMLINUX_HOME_CONFIGURATION") or expected_profile
            if self.home_configuration != expected_profile:
                raise DeploymentError("refusing another host's Home Manager profile")
        else:
            self.home_configuration = os.environ.get("TAMLINUX_HOME_CONFIGURATION") or getpass.getuser()
        self.workspace = Path(os.environ.get("TAMLINUX_WORKSPACE", self.home / "Code/tamlinux"))
        self.input = os.environ.get("TAMLINUX_PACKAGES_INPUT", "tamlinux-packages")
        self.owner = os.environ.get("TAMLINUX_GITHUB_OWNER", "greenermoose")
        data = Path(os.environ.get("XDG_DATA_HOME", self.home / ".local/share"))
        state = Path(os.environ.get("XDG_STATE_HOME", self.home / ".local/state"))
        config = Path(os.environ.get("XDG_CONFIG_HOME", self.home / ".config"))
        self.revision_file = data / "tamlinux/shell-revision"
        self.shell_link = data / "tamlinux/shell"
        self.plugins_dir = config / "tamlinux/plugins"
        self.bin_dir = self.home / ".local/bin"
        self.state_file = state / "tamlinux/deploy.json"
        self.transaction_file = state / 'tamlinux/deploy-transaction.json'
        self.profile = state / "nix/profiles/home-manager"
        self.lock = self.config / "flake.lock"
        self.host_pin = (self.config / "hosts" / self.hostname / "state/assembly"
                         if (self.config / "hosts").is_dir() else None)
        self.selection_file = data / "tamlinux/deployment-selection.json"
        self.system = os.environ.get("TAMLINUX_NIX_SYSTEM", os.uname().machine + "-linux")
        self._outputs = {}
        self._bundle_deliveries = {}

    # Records -----------------------------------------------------------

    def read_state(self) -> dict:
        return json.loads(self.state_file.read_text()) if self.state_file.exists() else {}

    def save_state(self, state: dict) -> None:
        atomic_json(self.state_file, state)

    @contextmanager
    def mutation_lock(self):
        """All CLI mutation paths use the same nonblocking host lock."""
        self.state_file.parent.mkdir(parents=True, exist_ok=True)
        with (self.state_file.parent / 'deploy.lock').open('a+') as stream:
            try:
                fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError as exc:
                raise DeploymentError('another deployment is already in progress') from exc
            try:
                yield
            finally:
                fcntl.flock(stream, fcntl.LOCK_UN)

    def baseline_token(self) -> str:
        value = {'assembly': self.locked(), 'generation': self.generation(),
                 'pinSha256': hashlib.sha256(self.pin_path.read_bytes()).hexdigest(),
                 'receiptSha256': hashlib.sha256(self.state_file.read_bytes()).hexdigest()}
        return hashlib.sha256(json.dumps(value, sort_keys=True).encode()).hexdigest()

    def check_requested_baseline(self) -> None:
        expected = getattr(self, '_requested_baseline', None)
        if expected is not None and self.baseline_token() != expected:
            raise DeploymentError('deployment baseline changed after confirmation; plan again')

    def recovery_snapshot(self, generation: str, assembly: str, pin: bytes) -> dict:
        state = self.read_state()
        if state.get('generation') != generation or state.get('packages') != assembly:
            raise DeploymentError('cannot record recovery without a matching baseline receipt')
        return {'generation': generation, 'assembly': assembly, 'state': state,
                'pinPath': str(self.pin_path), 'pin': base64.b64encode(pin).decode('ascii'),
                'outputs': self.expected_outputs(assembly), 'components': state['components']}

    def recover(self, transaction_id: str) -> None:
        """Recover only the current transaction using retained local package identities."""
        if not TRANSACTION_ID.fullmatch(transaction_id):
            raise DeploymentError('invalid recovery transaction ID')
        tx = json.loads(self.transaction_file.read_text())
        if (tx.get('id') != transaction_id or tx.get('host') != self.hostname
                or tx.get('user') != getpass.getuser() or tx.get('config') != str(self.config.resolve())):
            raise DeploymentError('stale or foreign recovery transaction; nothing changed')
        snapshot = tx.get('recovery')
        if not isinstance(snapshot, dict):
            raise DeploymentError('legacy transaction has no verified recovery snapshot; inspect manually')
        generation, assembly = snapshot['generation'], snapshot['assembly']
        if (not re.fullmatch(r'/nix/store/[a-z0-9]{32}-home-manager-generation', generation)
                or not (Path(generation) / 'activate').is_file()
                or not re.fullmatch(r'[0-9a-f]{40}', assembly)
                or snapshot['pinPath'] != str(self.pin_path)
                or tx.get('baselineGeneration') != generation or tx.get('baselineAssembly') != assembly):
            raise DeploymentError('recorded recovery generation or pin is unavailable; nothing changed')
        pin = base64.b64decode(snapshot['pin'], validate=True)
        active = self.generation()
        if active not in (generation, tx.get('targetGeneration')):
            raise DeploymentError('active generation is unrelated to this transaction; nothing changed')
        if self.locked() not in (assembly, tx.get('targetAssembly')):
            raise DeploymentError('consumer pin is unrelated to this transaction; nothing changed')
        current_pin = self.pin_path.read_bytes()
        target_hash = tx.get('targetPinSha256')
        if current_pin != pin and hashlib.sha256(current_pin).hexdigest() != target_hash:
            raise DeploymentError('consumer pin was edited after deployment; nothing changed')
        # verify() uses the recorded immutable outputs, without Nix evaluation or Git.
        self._outputs[assembly] = snapshot['outputs']
        pins = snapshot['components']
        if not isinstance(pins, dict) or not pins.get('tamlinux') or not snapshot['outputs']:
            raise DeploymentError('recovery snapshot lacks endpoint identities')
        try:
            already_restored = active == generation and current_pin == pin
            if already_restored:
                already_restored = not self.verify(pins, assembly)
                if already_restored:
                    self.verify_active(generation, pins)
            self.transaction(phase='recovering')
            if not already_restored:
                if self.graphical_active():
                    self.require_unlocked_sessions()
                self.activation_validators(generation)
                atomic_bytes(self.pin_path, pin)
                command(str(Path(generation) / 'activate'))
                self.restart_if_graphical()
            self.restore_home_file_backups(tx.get('backedUp', []), target_generation=generation, strict=True)
            problems = self.verify(pins, assembly)
            if problems:
                raise DeploymentError('recovered endpoints do not match baseline: ' + '; '.join(problems))
            self.verify_active(generation, pins)
            if self.locked() != assembly:
                raise DeploymentError('consumer pin does not identify the recovered assembly')
            files = [self.pin_file()] + self.update_bom(snapshot['state'])
            self.record(f'deploy: recover transaction {transaction_id}', files)
            self.save_state(snapshot['state'])
            self.transaction(phase='recovered', recoveryError=None)
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as exc:
            self.transaction(phase='partial', recoveryError=str(exc))
            raise DeploymentError(f'recovery incomplete: {exc}; retain transaction {transaction_id}') from exc
        print(f'Recovered transaction {transaction_id}; verified baseline {assembly}.')

    def installed(self) -> str:
        return self.revision_file.read_text().strip() if self.revision_file.exists() else "not installed"

    def host_pinned(self) -> bool:
        """True when this host records its own assembly revision."""
        if self.host_pin is None or not os.path.lexists(self.host_pin):
            return False
        if any(p.is_symlink() for p in [self.host_pin, *self.host_pin.parents]
               if p != self.config and p.is_relative_to(self.config)):
            raise DeploymentError("refusing a symlink host assembly pin")
        return True

    @property
    def pin_path(self) -> Path:
        """The file whose content selects the assembly: host pin or lock."""
        return self.host_pin if self.host_pinned() else self.lock

    def pin_file(self) -> str:
        return str(self.pin_path.relative_to(self.config))

    def locked(self) -> str:
        if self.host_pinned():
            revision = self.host_pin.read_text()
            if not re.fullmatch(r"[0-9a-f]{40}\n?", revision):
                raise DeploymentError(f"invalid host assembly pin: {self.pin_file()}")
            return revision.strip()
        document = json.loads(self.lock.read_text())
        node = document["nodes"]["root"]["inputs"].get(self.input)
        if not node:
            raise DeploymentError(f"configuration has no {self.input} input")
        return document["nodes"][node]["locked"]["rev"]

    def generation(self) -> str:
        if not self.profile.is_symlink():
            raise DeploymentError(f"Home Manager profile not found: {self.profile}")
        return str(self.profile.resolve(strict=True))

    # Repositories --------------------------------------------------------

    def repo(self, name: str) -> Path:
        path = self.workspace / name
        if not (path / ".git").exists():
            raise DeploymentError(f"checkout not found: {path}")
        return path

    def git(self, name: str, *args: str) -> str:
        return command("git", "-C", str(self.repo(name)), *args, capture=True)

    def on_branch(self, name: str, revision: str, branch: str) -> bool:
        return subprocess.run(["git", "-C", str(self.repo(name)), "merge-base", "--is-ancestor",
                               revision, f"origin/{branch}"]).returncode == 0

    def resolve(self, ref: str) -> str:
        self.git("tamlinux-packages", "fetch", "-q", "origin")
        return self.git("tamlinux-packages", "rev-parse", "--verify", "--end-of-options", ref + "^{commit}")

    def components(self, revision: str) -> dict[str, str]:
        """Tamlinux component revisions pinned by an assembly's lock file."""
        bundle = self.bundle_delivery(revision)
        if bundle is not None:
            return dict(bundle['components'])
        lock = json.loads(self.git("tamlinux-packages", "show", f"{revision}:flake.lock"))
        pins = {}
        for node in lock["nodes"].values():
            locked = node.get("locked", {})
            if locked.get("type") == "github" and locked.get("owner") == self.owner:
                pins[locked["repo"]] = locked["rev"]
        if "tamlinux" not in pins:
            raise DeploymentError(f"assembly {revision[:12]} does not pin tamlinux")
        return pins

    def bundle_delivery(self, revision: str) -> dict | None:
        cache = getattr(self, '_bundle_deliveries', {})
        if revision in cache:
            return cache[revision]
        repository = self.repo('tamlinux-packages')
        def read_field(path, limit, source_revision=revision):
            object_name = source_revision + ':' + path
            size = subprocess.run(['git', '-C', str(repository), 'cat-file', '-s', object_name],
                                  text=True, capture_output=True)
            if size.returncode:
                return None
            if not size.stdout.strip().isdigit() or int(size.stdout.strip()) > limit:
                raise DeploymentError('delivery metadata exceeds its size limit')
            return subprocess.check_output(['git', '-C', str(repository), 'show', object_name],
                                           text=True, stderr=subprocess.PIPE).strip()
        version = read_field('VERSION', 128)
        text = None
        if version and re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', version):
            text = read_field('deliveries/tamlinux-' + version + '.json', 1024 * 1024)
        if text is None:
            cache[revision] = None
            self._bundle_deliveries = cache
            return None
        if len(text) > 1024 * 1024:
            raise DeploymentError('delivery record exceeds its metadata limit')
        def unique(pairs):
            value = {}
            for name, item in pairs:
                if name in value:
                    raise DeploymentError('repeated delivery field: ' + name)
                value[name] = item
            return value
        value = json.loads(text, object_pairs_hook=unique)
        if not isinstance(value, dict):
            raise DeploymentError('delivery record must be an object')
        if value.get('backend') in (None, 'nix'):
            cache[revision] = None
            self._bundle_deliveries = cache
            return None
        fields = {'format', 'backend', 'version', 'recipeAssembly', 'components',
                  'rootstock', 'minimumTool', 'artifact'}
        if (set(value) != fields or type(value['format']) is not int or value['format'] != 1 or
                value['backend'] != 'tam-bundle' or value['version'] != version or
                value['rootstock'] != 'arch-systemd' or
                not isinstance(value['recipeAssembly'], str) or
                not re.fullmatch(r'[0-9a-f]{40}', value['recipeAssembly']) or
                not isinstance(value['minimumTool'], str) or
                not re.fullmatch(r'[0-9]+\.[0-9]+\.[0-9]+', value['minimumTool'])):
            raise DeploymentError('unsupported bundle delivery record')
        pins = value['components']
        if not isinstance(pins, dict) or 'tamlinux' not in pins or any(
                not re.fullmatch(r'[a-z0-9][a-z0-9-]*', name) or
                not isinstance(commit, str) or not re.fullmatch(r'[0-9a-f]{40}', commit)
                for name, commit in pins.items()):
            raise DeploymentError('invalid bundle component revisions')
        artifact = value['artifact']
        if (not isinstance(artifact, dict) or
                set(artifact) != {'name', 'sha256', 'bundleHash', 'bundleId'} or
                not all(isinstance(item, str) for item in artifact.values()) or
                not re.fullmatch(r'[0-9a-f]{64}', artifact['sha256']) or
                not re.fullmatch(r'sha256:[0-9a-f]{64}', artifact['bundleHash'])):
            raise DeploymentError('invalid bundle artifact identity')
        expected = 'tamlinux-' + version + '-' + artifact['bundleHash'][7:19]
        if artifact['bundleId'] != expected or artifact['name'] != expected + '.tbundle':
            raise DeploymentError('bundle name differs from its recorded identity')
        result = subprocess.run(['git', '-C', str(self.repo('tamlinux-packages')),
                                 'merge-base', '--is-ancestor', value['recipeAssembly'], revision],
                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
        if result.returncode:
            raise DeploymentError('frozen recipe is outside the delivery history')
        if read_field('VERSION', 128, value['recipeAssembly']) != version:
            raise DeploymentError('delivery version differs from the frozen recipe')
        lock = read_field('recipes/workstation/tamlinux.lock', 1024 * 1024,
                          value['recipeAssembly'])
        if lock is None:
            raise DeploymentError('frozen bundle recipe lock is missing')
        lines = lock.splitlines()
        actual = {}
        if not lines or lines[0] != 'format 1':
            raise DeploymentError('unsupported frozen bundle recipe lock')
        for line in lines[1:]:
            if not line.strip() or line.lstrip().startswith('#'):
                continue
            entry = line.split()
            if len(entry) != 4 or entry[0] != 'component' or entry[1] in actual:
                raise DeploymentError('invalid frozen bundle recipe lock')
            actual[entry[1]] = entry[3]
        if actual != pins:
            raise DeploymentError('delivery components differ from the frozen recipe')
        cache[revision] = value
        self._bundle_deliveries = cache
        return value

    def bundle_command(self, *arguments: str) -> str:
        return command('/usr/bin/tam-bundle', *map(str, arguments), capture=True)

    def bundle_artifact(self, delivery: dict) -> Path:
        cache = Path(os.environ.get('XDG_CACHE_HOME', self.home / '.cache'))
        archive = cache / 'tamlinux/bundles' / (delivery['artifact']['sha256'] + '.tbundle')
        fd = os.open(archive, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
        with os.fdopen(fd, 'rb') as stream:
            before = os.fstat(stream.fileno())
            if not stat.S_ISREG(before.st_mode):
                raise DeploymentError('cached bundle must be a regular archive')
            actual = hashlib.file_digest(stream, 'sha256').hexdigest()
            if actual != delivery['artifact']['sha256']:
                raise DeploymentError('cached bundle bytes differ from the frozen delivery')
            self.bundle_command('verify', str(archive))
            stream.seek(0)
            text = None
            with tarfile.open(fileobj=stream, mode='r|*') as packed:
                for entry in packed:
                    if entry.name == 'capture' or entry.name.startswith('capture/'):
                        raise DeploymentError('public delivery contains a private settings capture')
                    if entry.name != 'BUNDLE':
                        continue
                    if text is not None or not entry.isfile() or entry.size > 1024 * 1024:
                        raise DeploymentError('invalid carried bundle metadata')
                    text = packed.extractfile(entry).read().decode('utf-8')
            if text is None:
                raise DeploymentError('carried bundle metadata is missing')
            after = os.fstat(stream.fileno())
            named = archive.stat(follow_symlinks=False)
            identity = lambda item: (item.st_dev, item.st_ino, item.st_size, item.st_ctime_ns)
            if identity(before) != identity(after) or identity(before) != identity(named):
                raise DeploymentError('cached bundle changed during verification')
        values = {}
        sources = {}
        for line in text.splitlines():
            name, separator, item = line.partition(' ')
            if not separator:
                raise DeploymentError('invalid carried bundle record')
            if name == 'source':
                component, commit = item.split()
                if component in sources:
                    raise DeploymentError('repeated carried component')
                sources[component] = commit
            elif name in ('name', 'version', 'hash'):
                if name in values:
                    raise DeploymentError('repeated carried bundle identity')
                values[name] = item
        if (values != {'name': 'tamlinux', 'version': delivery['version'],
                       'hash': delivery['artifact']['bundleHash']} or
                sources != dict(delivery['components'], packaging=delivery['recipeAssembly'])):
            raise DeploymentError('carried bundle differs from the selected assembly')
        return archive

    def preflight_bundle(self, revision: str, delivery: dict) -> None:
        self.check_clean()
        baseline = self.require_consistent()
        text = self.bundle_command('--version')
        found = re.fullmatch(r'tam-bundle ([0-9]+\.[0-9]+\.[0-9]+) \(record format 2\)', text)
        if not found or int(command('/usr/bin/vercmp', found[1], delivery['minimumTool'], capture=True)) < 0:
            raise DeploymentError('this delivery requires tam-bundle >= ' + delivery['minimumTool'])
        archive = self.bundle_artifact(delivery)
        self.bundle_command('needs', str(archive))
        self._prepared_bundle_report = {
            'backend': 'tam-bundle', 'assembly': revision, 'version': delivery['version'],
            'recipeAssembly': delivery['recipeAssembly'], 'bundleId': delivery['artifact']['bundleId'],
            'artifact': str(archive), 'artifactSha256': delivery['artifact']['sha256'],
            'baselineGeneration': baseline['profileGeneration'],
            'baselineAssembly': baseline['assembly'],
        }

    def require_on(self, branch: str, revision: str, pins: dict[str, str]) -> None:
        if not self.on_branch("tamlinux-packages", revision, branch):
            raise DeploymentError(f"tamlinux-packages {revision[:12]} is not on {branch}")
        for name, rev in pins.items():
            self.git(name, "fetch", "-q", "origin")
            if not self.on_branch(name, rev, branch):
                raise DeploymentError(f"{name} {rev[:12]} pinned by the assembly is not on {branch}")

    # Activation ----------------------------------------------------------

    def live_paths(self) -> list[str]:
        """Repository-relative files listed in the consumer's system/live-paths."""
        source = self.config / LIVE_PATHS_FILE
        try:
            text = source.read_text(encoding="utf-8")
        except FileNotFoundError:
            return []
        if len(text) > 16384:
            raise DeploymentError(f"{LIVE_PATHS_FILE} is too large")
        paths = []
        for raw in text.splitlines():
            entry = raw.strip()
            if not entry or entry.startswith("#"):
                continue
            parts = entry.split("/")
            if (not LIVE_PATH_RE.fullmatch(entry) or ".." in parts or "." in parts
                    or entry == LIVE_PATHS_FILE or entry.startswith(".git/") or entry == ".git"):
                raise DeploymentError(f"invalid entry in {LIVE_PATHS_FILE}: {entry!r}")
            paths.append(entry)
        return paths

    def live_digests(self) -> dict:
        """SHA-256 of each live path as deployed (None when absent)."""
        digests = {}
        for entry in self.live_paths():
            target = self.config / entry
            digests[entry] = hashlib.sha256(target.read_bytes()).hexdigest() if target.is_file() else None
        return digests

    def _excluded_config_pathspecs(self) -> list[str]:
        excluded = [":(exclude)system/bom.json", ":(exclude)system/plugin-runs"]
        excluded += [f":(exclude){entry}" for entry in NON_CONSUMER_PATHS]
        excluded += [f":(exclude,literal){entry}" for entry in self.live_paths()]
        return excluded

    def check_clean(self) -> None:
        # Reject dirty deployment inputs so a generation has an identifiable
        # config commit. Deployment records may accumulate after activation,
        # live paths change while the session runs (recorded by digest), and
        # non-consumer paths outside Nix inputs are ignored with a note.
        excluded = self._excluded_config_pathspecs()
        dirty = command("git", "-C", str(self.config), "status", "--porcelain", "--untracked-files=all",
                        "--", ".", *excluded, capture=True)
        if dirty:
            raise DeploymentError("commit config changes before deploying:\n" + dirty)
        ignored = command("git", "-C", str(self.config), "status", "--porcelain", "--untracked-files=all",
                          "--", *NON_CONSUMER_PATHS, capture=True)
        if ignored:
            paths = [line[3:].strip() for line in ignored.splitlines() if len(line) > 3]
            print("tam-deploy: ignoring unrelated uncommitted paths: " + ", ".join(paths), file=sys.stderr)

    def preparation_identity(self, revision: str, baseline: str) -> dict:
        excluded = self._excluded_config_pathspecs()
        tree = command('git', '-C', str(self.config), 'ls-files', '-s', '--', '.', *excluded, capture=True)
        return {'assembly': revision, 'baseline': baseline,
                'consumer': hashlib.sha256(tree.encode()).hexdigest(),
                'live': self.live_digests(), 'host': self.home_configuration,
                'pin': hashlib.sha256(self.pin_path.read_bytes()).hexdigest(),
                'receipt': hashlib.sha256(self.state_file.read_bytes()).hexdigest(),
                'operator': hashlib.sha256(Path(__file__).read_bytes()).hexdigest()}

    def preflight(self, revision: str | None = None) -> None:
        if revision is not None:
            bundle = self.bundle_delivery(revision)
            if bundle is not None:
                self.preflight_bundle(revision, bundle)
                return
        self.check_clean()
        if self.transaction_file.exists():
            transaction = json.loads(self.transaction_file.read_text())
            if transaction.get('phase') not in ('complete', 'recovered'):
                raise DeploymentError(f'incomplete deployment transaction ({transaction.get("phase")}); inspect status before retrying')
        if revision is not None:
            report = self.require_consistent()
            before = (self.pin_path.read_bytes(), self.state_file.read_bytes(), report['profileGeneration'])
            identity = self.preparation_identity(revision, report['profileGeneration'])
            cache = self.state_file.parent / 'prepared-generation.json'
            saved = json.loads(cache.read_text()) if cache.is_file() else {}
            generation = saved.get('generation', '')
            if (saved.get('identity') == identity
                    and re.fullmatch(r'/nix/store/[a-z0-9]{32}-home-manager-generation', generation)
                    and (Path(generation) / 'activate').is_file()):
                self._prepared_generation = generation
            else:
                self._prepared_generation = self.build_generation(revision)
            self._prepared_conflicts = self.find_home_file_conflicts(self._prepared_generation)
            self.activation_validators(report['profileGeneration'])
            self.activation_validators(self._prepared_generation)
            self.check_clean()
            if before != (self.pin_path.read_bytes(), self.state_file.read_bytes(), self.generation()):
                raise DeploymentError('deployment baseline changed during preparation; prepare again')
            if self.preparation_identity(revision, report['profileGeneration']) != identity:
                raise DeploymentError('consumer inputs changed during preparation; prepare again')
            cache.parent.mkdir(parents=True, exist_ok=True)
            temporary = cache.with_suffix('.tmp')
            temporary.write_text(json.dumps({'identity': identity, 'generation': self._prepared_generation}) + '\n')
            temporary.replace(cache)
        if self.graphical_active():
            self.require_unlocked_sessions()
        else:
            session = os.environ.get("XDG_SESSION_ID")
            if session and command("loginctl", "show-session", session, "-p", "LockedHint", "--value", capture=True) == "yes":
                raise DeploymentError("unlock the session before deploying")

    def require_unlocked_sessions(self) -> None:
        """A VT can coexist with a locked graphical session of this user."""
        try:
            listing = command("loginctl", "list-sessions", "--json=short", capture=True)
            if len(listing) > 65536:
                raise ValueError("session list is too large")
            sessions = json.loads(listing)
            if not isinstance(sessions, list):
                raise ValueError("invalid session list")
            checked = 0
            for session in sessions:
                if not isinstance(session, dict) or type(session.get("uid")) is not int:
                    raise ValueError("invalid session entry")
                if session["uid"] != os.getuid():
                    continue
                category, identifier = session.get("class"), session.get("session")
                if not isinstance(category, str) or not isinstance(identifier, str) or not re.fullmatch(r"[A-Za-z0-9_-]+", identifier):
                    raise ValueError("invalid session identity")
                if category in ("manager", "manager-early"):
                    continue
                locked = command("loginctl", "show-session", identifier, "-p", "LockedHint", "--value", capture=True)
                if locked == "yes":
                    raise DeploymentError("unlock all of this user's sessions before deploying")
                if locked != "no":
                    raise ValueError("unknown session lock state")
                checked += 1
            if not checked:
                raise ValueError("no user session found")
        except (OSError, subprocess.CalledProcessError, ValueError) as exc:
            raise DeploymentError(f"cannot verify session lock state: {exc}") from exc

    def graphical_active(self) -> bool:
        result = subprocess.run(["systemctl", "--user", "is-active", "graphical-session.target"],
                                text=True, capture_output=True)
        state = result.stdout.strip()
        if result.returncode == 0 and state == "active":
            return True
        if result.returncode == 3 and state == "inactive":
            return False
        raise DeploymentError("cannot determine graphical session state; check the user systemd service")

    def restart_if_graphical(self) -> None:
        if self.graphical_active():
            self.require_unlocked_sessions()
            command("tam-restart-shell")
            self.wait_ready()

    def pin(self, revision: str) -> None:
        """Lock the configuration's input to an exact assembly revision,
        keeping the input's declared source. A host pin is rewritten instead."""
        if self.host_pinned():
            if not re.fullmatch(r"[0-9a-f]{40}", revision):
                raise DeploymentError("host assembly pin must be a full revision")
            temporary = self.host_pin.with_name(".assembly.tmp")
            temporary.write_text(revision + "\n")
            temporary.replace(self.host_pin)
            return
        document = json.loads(self.lock.read_text())
        node = document["nodes"]["root"]["inputs"][self.input]
        original = document["nodes"][node]["original"]
        command("nix", "flake", "lock", "--update-input", self.input, "--override-input", self.input,
                f"github:{self.owner}/tamlinux-packages/{revision}", str(self.config))
        document = json.loads(self.lock.read_text())
        document["nodes"][document["nodes"]["root"]["inputs"][self.input]]["original"] = original
        self.lock.write_text(json.dumps(document, indent=2) + "\n")

    def build_generation(self, revision: str | None = None) -> str:
        started = time.monotonic()
        args = ['nix', 'build', '--no-link', '--print-out-paths', '--no-write-lock-file']
        target = f'{self.config}#homeConfigurations.{self.home_configuration}.activationPackage'
        if revision and self.host_pinned():
            # The flake reads the tracked pin file; stage it only for this build.
            before = self.host_pin.read_bytes()
            try:
                self.pin(revision)
                result = command(*args, target, capture=True)
            finally:
                self.host_pin.write_bytes(before)
        else:
            if revision:
                args += ['--override-input', self.input, f'github:{self.owner}/tamlinux-packages/{revision}']
            result = command(*args, target, capture=True)
        if (not re.fullmatch(r'/nix/store/[a-z0-9]{32}-home-manager-generation', result)
                or not (Path(result) / 'activate').is_file()):
            raise DeploymentError('build did not return one activation generation')
        self._phase_times = getattr(self, '_phase_times', {})
        self._phase_times['realize'] = round(time.monotonic() - started, 3)
        return result

    def activation_validators(self, generation: str) -> None:
        registry = self.config / 'system/activation-preflight.json'
        if not registry.exists():
            return
        script = (Path(generation) / 'activate').read_text()
        for validator in json.loads(registry.read_text())['validators']:
            name = validator['scriptName']
            if not re.fullmatch(r'[a-z0-9-]+\.py', name):
                raise DeploymentError('invalid registered activation validator')
            source = (self.config / validator['source']).resolve(strict=True)
            if not source.is_relative_to(self.config.resolve()):
                raise DeploymentError('activation validator source escapes consumer')
            helpers = set(re.findall(r'/nix/store/[a-z0-9]{32}-' + re.escape(name), script))
            if not helpers:
                raise DeploymentError(f'registered activation validator missing: {name}')
            for helper in sorted(helpers):
                command(sys.executable, helper, str(source), capture=True)

    def find_home_file_conflicts(self, generation: Path | str, version: str | None = None) -> list[dict]:
        return find_home_file_conflicts(generation, home=self.home, version=version)

    def conflicts(self, generation: Path | str, json_output: bool = False) -> list[dict]:
        gen_path = Path(generation)
        if not gen_path.exists():
            raise DeploymentError(f"generation not found: {generation}")
        items = self.find_home_file_conflicts(gen_path)
        if json_output:
            print(json.dumps({
                "generation": str(gen_path),
                "version": generation_version(gen_path),
                "conflicts": items,
            }, indent=2))
        else:
            for item in items:
                suffix = " (backup exists)" if item["backupExists"] else ""
                print(f"{item['path']} -> {item['backupPath']}{suffix}")
        return items

    def _record_transaction_fields(self, **fields) -> None:
        if not self.transaction_file.exists():
            return
        self.transaction(**fields)

    def backup_home_file_conflicts(self, generation: Path | str, version: str | None = None) -> list[dict]:
        items = self.find_home_file_conflicts(generation, version=version)
        for item in items:
            if item["backupExists"]:
                raise DeploymentError(
                    f"backup already exists and would be clobbered: {item['backupPath']} (for {item['path']})"
                )
        # Publish intent before the first rename. Recovery skips backups that
        # do not exist, including when interruption precedes their rename.
        self._backed_up = [{k: item[k] for k in ('path', 'relativePath', 'backupPath')} for item in items]
        if items:
            self._record_transaction_fields(backedUp=list(self._backed_up))
        backed_up: list[dict] = []
        try:
            for item in items:
                os.rename(item["path"], item["backupPath"])
                backed_up.append({
                    "path": item["path"],
                    "relativePath": item["relativePath"],
                    "backupPath": item["backupPath"],
                })
        except OSError as exc:
            for done in reversed(backed_up):
                try:
                    os.rename(done["backupPath"], done["path"])
                except OSError:
                    pass
            raise DeploymentError(f"failed to back up conflicting home file: {exc}") from exc
        self._backed_up = backed_up
        if backed_up:
            self._record_transaction_fields(backedUp=list(backed_up))
        return backed_up

    def restore_home_file_backups(
        self,
        backups: list[dict] | None = None,
        target_generation: Path | str | None = None,
        strict: bool = False,
    ) -> list[dict]:
        entries = list(getattr(self, "_backed_up", []) if backups is None else backups)
        restored: list[dict] = []
        conflicts: list[str] = []
        for item in reversed(entries):
            path = Path(item["path"])
            backup = Path(item["backupPath"])
            rel = item.get("relativePath") or path.relative_to(self.home).as_posix()
            if target_generation is not None and os.path.lexists(Path(target_generation) / "home-files" / rel):
                continue
            if not os.path.lexists(backup):
                continue
            if os.path.lexists(path):
                if path.is_symlink() and _is_hm_symlink(path, rel):
                    path.unlink()
                else:
                    conflicts.append(str(path))
                    continue
            os.rename(backup, path)
            restored.append(item)
        if restored:
            self._record_transaction_fields(restoredBackups=list(reversed(restored)))
        if backups is None:
            self._backed_up = []
        if strict and conflicts:
            raise DeploymentError('later user files preserved; original backups need review: ' + ', '.join(conflicts))
        return list(reversed(restored))

    def activate(self) -> None:
        generation = getattr(self, '_prepared_generation', None) or self.build_generation()
        # HM CLI switch changes the profile BEFORE prerequisite checks. Direct
        # activation uses driver 0: its own writeBoundary moves the profile only
        # after read-only checks pass. Never pass --driver-version 1 here.
        version = generation_version(generation)
        backup_ext = f"pre-{version}" if version else "pre-tamlinux"
        self.backup_home_file_conflicts(generation, version=version)
        started = time.monotonic()
        previous_ext = os.environ.get("HOME_MANAGER_BACKUP_EXT")
        os.environ["HOME_MANAGER_BACKUP_EXT"] = backup_ext
        try:
            command(str(Path(generation) / 'activate'))
            if self.generation() != generation:
                raise DeploymentError('candidate generation was not activated')
            self._phase_times = getattr(self, '_phase_times', {})
            self._phase_times['activate'] = round(time.monotonic() - started, 3)
            restart_started = time.monotonic()
            self.restart_if_graphical()
            self._phase_times['shellRestart'] = round(time.monotonic() - restart_started, 3)
        except Exception:
            if not getattr(self, "_in_install_transaction", False):
                self.restore_home_file_backups()
            raise
        finally:
            if previous_ext is None:
                os.environ.pop("HOME_MANAGER_BACKUP_EXT", None)
            else:
                os.environ["HOME_MANAGER_BACKUP_EXT"] = previous_ext

    def wait_ready(self) -> None:
        for _ in range(40):
            try:
                if command("tam-shell", "reminders", "ping", capture=True, quiet=True) == "pong":
                    palette = json.loads(command("tam-shell", "theme", "current", capture=True, quiet=True))
                    if isinstance(palette, dict) and all(
                        isinstance(palette.get(key), str) and
                        re.fullmatch(r"#[0-9a-fA-F]{6}", palette[key])
                        for key in ("foreground", "background", "accent", "muted")
                    ):
                        return
            except (subprocess.CalledProcessError, ValueError):
                pass
            time.sleep(0.2)
        raise DeploymentError("deployed shell did not become ready with a valid theme palette through tam-shell")

    def expected_outputs(self, revision: str) -> dict:
        """Evaluate the committed assembly, never the changing checkout or lock."""
        if revision not in self._outputs:
            expression = '''p: {
              shell = toString p.tamlinux-shell;
              plugins = toString p.tamlinux-plugins;
              commands = toString p.tamlinux-commands;
              tam = toString p.tam;
              tools = toString p.tamlinux-tools;
              pluginIds = p.tamlinux-plugins.passthru.ids;
              commandNames = p.tamlinux-commands.passthru.names;
              features = p.tamlinux-shell.passthru.features;
              selectionRecord = p.tamlinux-shell.passthru.deploymentSelectionRecord or false;
              manWrapper = p.tam.passthru.features.manWrapper or false;
            }'''
            self._outputs[revision] = json.loads(command(
                "nix", "eval", "--json", "--no-write-lock-file",
                f"git+file://{self.repo('tamlinux-packages')}?rev={revision}#packages.{self.system}",
                "--apply", expression, capture=True))
        return self._outputs[revision]

    def verify(self, pins: dict[str, str], revision: str | None = None) -> list[str]:
        """Differences between the installed endpoints and the assembly."""
        expected = self.expected_outputs(revision or self.locked())
        problems = []
        if self.installed() != pins["tamlinux"]:
            problems.append(f"shell revision {self.installed()} is not {pins['tamlinux']}")

        def endpoint(label: str, path: Path, target: str) -> None:
            if not path.exists():
                problems.append(f"{label} is missing or its link is broken: {path}")
            elif os.path.realpath(path) != target:
                problems.append(f"{label} resolves to {os.path.realpath(path)}, expected {target}")

        endpoint("shell", self.shell_link, expected["shell"] + "/share/tamlinux/shell")
        selected = expected["pluginIds"]
        if expected["selectionRecord"]:
            try:
                record = json.loads(self.selection_file.read_text())
                selected = record["plugins"]
                if (record["revision"] != pins["tamlinux"] or not isinstance(selected, list)
                        or any(not isinstance(p, str) or p not in expected["pluginIds"] for p in selected)
                        or len(selected) != len(set(selected))):
                    raise ValueError("invalid product revision or plugin selection")
            except (OSError, ValueError, KeyError, TypeError) as exc:
                problems.append(f"deployment selection record is missing or invalid: {exc}")
                selected = expected["pluginIds"]
        for name in selected:
            endpoint(name, self.plugins_dir / name, expected["plugins"] + "/share/tamlinux/plugins/" + name)
        for plugin in self.plugins_dir.glob("fred.*"):
            if plugin.name not in selected:
                problems.append(f"unexpected installed plugin: {plugin.name}")
        for name in expected["commandNames"]:
            endpoint(name, self.bin_dir / name, expected["commands"] + "/bin/" + name)
        endpoint("tam", self.bin_dir / "tam", expected["tam"] + "/bin/tam")
        endpoint("tam-file-select", self.bin_dir / "tam-file-select", expected["tools"] + "/bin/tam-file-select")
        if expected["manWrapper"]:
            endpoint("tam-man", self.bin_dir / "tam-man", expected["tam"] + "/bin/tam-man")
        if expected["features"].get("menu"):
            endpoint("tam-menu", self.bin_dir / "tam-menu", expected["shell"] + "/bin/tam-menu")
            endpoint("menu defaults", self.plugins_dir.parent / "menu/default.jsonc",
                     expected["shell"] + "/share/tamlinux/menu/default.jsonc")
        return problems

    def record(self, message: str, files: list[str]) -> None:
        trailers = ""
        if os.environ.get("CODEX_THREAD_ID") or os.environ.get("CLAUDECODE"):
            detector = self.home / ".agents/skills/ai-provenance/scripts/detect-runtime.sh"
            trailers = "\n\n" + command(str(detector), "--trailers", capture=True)
        command("git", "-C", str(self.config), "add", "--", *files)
        changed = subprocess.run(["git", "-C", str(self.config), "diff", "--cached", "--quiet",
                                  "--", *files]).returncode
        if changed:
            command("git", "-C", str(self.config), "commit", "--only", "-m", message + trailers, "--", *files)

    def update_bom(self, entry: dict) -> list[str]:
        relative = (f"hosts/{self.hostname}/state/bom.json" if (self.config / "hosts").is_dir()
                    else "system/bom.json")
        bom_path = self.config / relative
        if (self.config / "hosts").is_dir() and any(
                p.is_symlink() for p in [bom_path, *bom_path.parents]):
            raise DeploymentError("refusing a symlink BOM destination")
        if not bom_path.exists():
            return []
        bom = json.loads(bom_path.read_text())
        bom.setdefault("components", {})["tamlinux"] = entry
        bom_path.write_text(json.dumps(bom, indent=2) + "\n")
        return [relative]

    # Commands ------------------------------------------------------------

    def runtime_state(self) -> dict:
        if not self.graphical_active():
            return {'graphical': False, 'revision': None}
        pid = command('systemctl', '--user', 'show', 'tamlinux-shell.service', '-p', 'MainPID', '--value', capture=True)
        if not pid.isdigit() or int(pid) <= 0:
            raise DeploymentError('graphical shell has no running service process')
        argv = (Path('/proc') / pid / 'cmdline').read_bytes().decode().split('\0')
        paths = [argv[i + 1] for i, argument in enumerate(argv[:-1]) if argument in ('-p', '--path')]
        if len(paths) != 1 or not re.fullmatch(r'/nix/store/[a-z0-9]{32}-[^/]+/share/tamlinux/shell', paths[0]):
            raise DeploymentError('cannot identify running shell package path')
        revision = (Path(paths[0]).parent / 'source-revision').read_text().strip()
        if not re.fullmatch(r'[0-9a-f]{40}', revision):
            raise DeploymentError('invalid running shell package revision')
        return {'graphical': True, 'pid': int(pid), 'revision': revision, 'shell': paths[0]}

    def generation_markers(self, generation: str) -> list[str]:
        problems = []
        files = Path(generation) / 'home-files'
        for relative in ('.local/share/tamlinux/shell', '.local/share/tamlinux/shell-revision',
                         '.config/systemd/user/tamlinux-shell.service'):
            installed, expected = self.home / relative, files / relative
            if not expected.exists() or not installed.exists() or installed.resolve() != expected.resolve():
                problems.append(f'{relative} does not match recorded generation')
        return problems

    def verify_active(self, generation: str, pins: dict) -> None:
        if self.generation() != generation:
            raise DeploymentError('active profile does not match expected generation')
        problems = self.generation_markers(generation)
        runtime = self.runtime_state()
        if runtime['graphical'] and runtime['revision'] != pins['tamlinux']:
            problems.append('running shell does not match expected revision')
        if problems:
            raise DeploymentError('active generation verification failed: ' + '; '.join(problems))

    def state_report(self) -> dict:
        locked, state = self.locked(), self.read_state()
        profile = self.generation()
        pins = self.components(locked)
        problems = list(self.verify(pins, locked))
        if not state or state.get('packages') != locked or state.get('components') != pins:
            problems.append('deployment receipt does not match lock/components')
        if state.get('generation') != profile:
            problems.append('profile generation does not match deployment receipt')
        if state.get('generation'):
            problems += self.generation_markers(state['generation'])
        runtime = {}
        try:
            runtime = self.runtime_state()
            if runtime['graphical'] and runtime['revision'] != pins['tamlinux']:
                problems.append('running shell does not match assembly revision')
        except (OSError, ValueError, subprocess.CalledProcessError, DeploymentError) as exc:
            problems.append(f'runtime identity unavailable: {exc}')
        transaction = json.loads(self.transaction_file.read_text()) if self.transaction_file.exists() else None
        if transaction and transaction.get('phase') not in ('complete', 'recovered'):
            problems.append(f'incomplete deployment transaction: {transaction.get("phase")}')
        return {'assembly': locked, 'components': pins, 'installedShell': self.installed(),
                'profileGeneration': profile, 'receiptGeneration': state.get('generation'),
                'receipt': state, 'runtime': runtime, 'transaction': transaction, 'problems': problems}

    def require_consistent(self) -> dict:
        report = self.state_report()
        if report['problems']:
            raise DeploymentError('deployment state disagrees; reconcile before retrying:\n  ' + '\n  '.join(report['problems']))
        return report

    def status(self, json_output: bool = False) -> None:
        report = self.state_report()
        if json_output:
            print(json.dumps(report, indent=2))
            if report['problems']:
                raise DeploymentError('deployment state is inconsistent')
            return
        locked = self.locked()
        state = self.read_state()
        print(f"assembly: tamlinux-packages {locked}")
        try:
            pins = self.components(locked)
        except (subprocess.CalledProcessError, DeploymentError) as exc:
            print(f"components: unavailable ({exc})")
            pins = {}
        for name, rev in sorted(pins.items()):
            print(f"  {name}: {rev}")
        print(f"installed shell: {self.installed()}")
        print("stage: " + (state.get("stage", "unrecorded") if state.get("packages") == locked else "unrecorded"))
        print(f"generation: {self.generation()}")
        print(f"receipt generation: {report['receiptGeneration']}")
        print('runtime: ' + json.dumps(report['runtime'], sort_keys=True))
        problems = report['problems']
        for problem in problems:
            print(f"mismatch: {problem}")
        if problems:
            raise DeploymentError("deployment state is inconsistent")

    def reconcile_plan(self) -> dict:
        """Only a profile pointer may disagree. All other evidence must agree."""
        report = self.state_report()
        if report['problems'] != ['profile generation does not match deployment receipt']:
            raise DeploymentError('reconcile requires a proven profile-only mismatch; mixed or unknown state needs explicit recovery')
        target = report['receiptGeneration']
        if not (Path(target) / 'activate').is_file():
            raise DeploymentError('recorded generation is unavailable')
        plan = {'profile': str(self.profile), 'from': report['profileGeneration'], 'to': target,
                'assembly': report['assembly'], 'receiptSha256': hashlib.sha256(self.state_file.read_bytes()).hexdigest(),
                'lockSha256': hashlib.sha256(self.pin_path.read_bytes()).hexdigest(), 'runtime': report['runtime']}
        return plan

    def reconcile(self, digest: str | None = None) -> None:
        plan = self.reconcile_plan()
        actual = hashlib.sha256(json.dumps(plan, sort_keys=True).encode()).hexdigest()
        if digest is None:
            print(json.dumps({'plan': plan, 'digest': actual}, indent=2))
            return
        if digest != actual:
            raise DeploymentError('reconcile digest changed; inspect and plan again')
        command('nix-env', '--profile', str(self.profile), '--set', plan['to'])
        if self.state_report()['problems']:
            raise DeploymentError('profile reconciliation did not restore consistent state')
        print('Profile reconciled; no activation, receipt or settings restoration performed.')

    def transaction(self, **fields) -> None:
        current = (json.loads(self.transaction_file.read_text())
                   if self.transaction_file.exists() and fields.get('phase') != 'prepared' else {})
        if fields.get('phase') == 'prepared':
            current.update(id=getattr(self, '_requested_transaction', None) or uuid.uuid4().hex,
                           host=self.hostname, user=getpass.getuser(), config=str(self.config.resolve()))
        current.update(fields)
        # History first: current remains the authoritative recovery selector.
        if TRANSACTION_ID.fullmatch(current.get('id', '')):
            atomic_json(self.state_file.parent / 'deploy-transactions' / (current['id'] + '.json'), current)
        atomic_json(self.transaction_file, current)
        print('deploy phase: ' + str(current.get('phase')), flush=True)

    def fetch_all(self, pins: dict[str, str]) -> None:
        for name in ["tamlinux-packages", *sorted(pins)]:
            self.git(name, "fetch", "-q", "origin")

    def stage_of(self, name: str, revision: str) -> str:
        """The furthest-promoted branch holding a revision: main, test,
        develop, or untracked (another branch or none)."""
        for branch in ("main", "test", "develop"):
            if self.on_branch(name, revision, branch):
                return branch
        return "untracked"

    def follows_main(self, name: str, revision: str) -> bool:
        """True when main can fast-forward to the revision."""
        return subprocess.run(["git", "-C", str(self.repo(name)), "merge-base", "--is-ancestor",
                               "origin/main", revision]).returncode == 0

    def install(self, revision: str, pins: dict[str, str], stage: str) -> tuple[str, str]:
        """Pin, switch and verify an assembly; on failure restore the lock
        and the previous generation. Returns (previous generation, previous pin)."""
        if self.bundle_delivery(revision) is not None:
            raise DeploymentError('bundle activation integration is incomplete')
        self._phase_times = {}
        self.check_requested_baseline()
        install_started = time.monotonic()
        preflight_started = time.monotonic()
        self.preflight(revision)
        self.check_requested_baseline()
        self._phase_times['preflight'] = round(time.monotonic() - preflight_started, 3)
        previous = self.generation()
        previous_pin = self.rollback_pin(previous)
        pin_path = self.pin_path
        before = pin_path.read_bytes()
        recovery = self.recovery_snapshot(previous, previous_pin, before)
        self.transaction(phase='prepared', baselineGeneration=previous, baselineAssembly=previous_pin,
                         targetAssembly=revision, targetGeneration=getattr(self, '_prepared_generation', None),
                         recovery=recovery)
        activation_attempted = False
        self._backed_up = []
        self._in_install_transaction = True
        try:
            self.transaction(phase='pinning')
            self.pin(revision)
            self.transaction(targetPinSha256=hashlib.sha256(pin_path.read_bytes()).hexdigest())
            self.transaction(phase='activating')
            activation_attempted = True
            self.activate()
            verify_started = time.monotonic()
            problems = self.verify(pins, revision)
            if problems:
                raise DeploymentError("installed endpoints do not match the assembly:\n  " + "\n  ".join(problems))
            self.verify_active(getattr(self, '_prepared_generation', previous), pins)
            self._phase_times['verify'] = round(time.monotonic() - verify_started, 3)
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as exc:
            try:
                self.transaction(phase='recovering', deploymentError=str(exc))
                atomic_bytes(pin_path, before)
                if self.generation() != previous or activation_attempted:
                    if self.graphical_active():
                        self.require_unlocked_sessions()
                    command(str(Path(previous) / "activate"))
                    if self.generation() != previous:
                        raise DeploymentError("previous generation was not restored")
                    self.restart_if_graphical()
                self.restore_home_file_backups(target_generation=previous, strict=True)
                previous_pins = self.components(previous_pin)
                problems = self.verify(previous_pins, previous_pin)
                if problems:
                    raise DeploymentError("recovered endpoints do not match the previous assembly:\n  " + "\n  ".join(problems))
                self.verify_active(previous, previous_pins)
                self.transaction(phase='recovered')
            except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as recovery:
                self.transaction(phase='partial', recoveryError=str(recovery))
                raise DeploymentError(
                    f"deployment failed: {exc}; recovery also failed: {recovery}; "
                    "inspect tam-deploy status, the active generation and the consumer lock before retrying"
                ) from recovery
            raise
        finally:
            self._in_install_transaction = False
        try:
            self.transaction(phase='recording')
            generation = self.generation()
            files = [self.pin_file()] + self.update_bom({"packages": revision, "tamlinux": pins["tamlinux"],
                                                         "stage": stage, "generation": generation})
            self.record(f"deploy: {stage} tamlinux-packages {revision[:12]}", files)
            self._phase_times['total'] = round(time.monotonic() - install_started, 3)
            state_record = {"stage": stage, "packages": revision, "components": pins,
                            "generation": generation, "previousGeneration": previous,
                            "previousPin": previous_pin, "livePaths": self.live_digests(),
                            "phaseTimes": dict(self._phase_times)}
            if self._backed_up:
                state_record["backedUp"] = list(self._backed_up)
            self.save_state(state_record)
            self.transaction(phase='complete', phaseTimes=dict(self._phase_times))
            print(
                "deploy phases: "
                + " ".join(f"{name}={seconds}s" for name, seconds in self._phase_times.items()),
                flush=True,
            )
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as exc:
            self.transaction(phase='partial', recordingError=str(exc))
            raise DeploymentError(
                f"activation succeeded but deployment recording failed: {exc}; "
                "inspect tam-deploy status, the active generation and the consumer lock before retrying"
            ) from exc
        return previous, previous_pin

    def init(self, ref: str | None = None, test: bool = False) -> None:
        """Initialize an account without pretending it has a rollback generation.

        The package command can be invoked with nix shell on a fresh account.
        Activation uses the configuration's built generation, not a checkout
        payload or an ambient home-manager executable. Login is a later step.
        """
        self.check_clean()
        if not (self.config / "hosts" / self.hostname / "host.json").is_file():
            raise DeploymentError("first installation requires a registered local host profile")
        if (os.path.lexists(self.profile) or os.path.lexists(self.shell_link)
                or self.installed() != "not installed" or self.state_file.exists()):
            raise DeploymentError("existing installation found; use test/run with its rollback generation")
        attempt = self.state_file.with_name("first-install.json")
        if attempt.exists():
            raise DeploymentError(f"review the previous first-install attempt before retrying: {attempt}")
        revision = self.resolve(ref or self.locked())
        if self.bundle_delivery(revision) is not None:
            raise DeploymentError('bundle activation integration is incomplete')
        pins = self.components(revision)
        self.require_on("test" if test else "main", revision, pins)
        pin_path = self.pin_path
        before = pin_path.read_bytes()
        started = False
        try:
            self.pin(revision)
            generation = command("nix", "build", "--no-link", "--print-out-paths",
                                 f"{self.config}#homeConfigurations.{self.home_configuration}.activationPackage",
                                 capture=True)
            if (not generation.startswith("/nix/store/") or "\n" in generation
                    or not (Path(generation) / "activate").is_file()):
                raise DeploymentError("build did not return one activation generation")
            attempt.parent.mkdir(parents=True, exist_ok=True)
            details = {"packages": revision, "components": pins, "generation": generation,
                       "profile": self.home_configuration, "previousGeneration": None,
                       "status": "activating", "previousLock": before.decode()}
            attempt.write_text(json.dumps(details, indent=2) + "\n")
            started = True
            command(str(Path(generation) / "activate"))
            if self.generation() != generation:
                raise DeploymentError("activated Home Manager profile does not match the built generation")
            problems = self.verify(pins, revision)
            if problems:
                raise DeploymentError("first-install endpoints do not match the assembly:\n  " + "\n  ".join(problems))
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError):
            if started:
                details["status"] = "failed; inspect partial activation before recovery"
                attempt.write_text(json.dumps(details, indent=2) + "\n")
            else:
                pin_path.write_bytes(before)
            raise
        stage = "test" if test else "run"
        files = [self.pin_file()] + self.update_bom({"packages": revision, "tamlinux": pins["tamlinux"],
                                                   "stage": stage, "generation": generation})
        self.record(f"deploy: first install tamlinux-packages {revision[:12]}", files)
        self.save_state({"stage": stage, "packages": revision, "components": pins,
                         "generation": generation, "previousGeneration": None, "previousPin": None,
                         "firstInstall": True, "livePaths": self.live_digests()})
        details["status"] = "installed; physical console and optional desktop not yet verified"
        attempt.write_text(json.dumps(details, indent=2) + "\n")
        print(f"Installed {self.home_configuration} from {revision}; no branches moved.")
        print("No previous generation exists. Verify text login and console tools; start graphics only with tam-desktop.")

    def rollback_pin(self, generation: str) -> str:
        """Identify the active assembly, even when the consumer lock is staged."""
        state = self.read_state()
        if state.get("generation") == generation and state.get("packages"):
            revision = state["packages"]
        else:
            revision = self.locked()
        if self.components(revision)["tamlinux"] != self.installed():
            raise DeploymentError("cannot identify the active assembly for rollback; "
                                  "restore a matching deployment record or consumer lock before deploying")
        return revision

    def test(self, ref: str = "origin/test") -> None:
        revision = self.resolve(ref)
        pins = self.components(revision)
        self.require_on("test", revision, pins)
        self.install(revision, pins, "test")
        self.status()

    def follow(self, ref: str, transaction_id: str | None = None, baseline_token: str | None = None) -> None:
        """Install an accepted Run assembly on a follower host (plan 47).

        Records stage label `follow`, not `test`, so shared Test records stay
        with the stage host.
        """
        if transaction_id is not None:
            if not TRANSACTION_ID.fullmatch(transaction_id) or not re.fullmatch(r'[0-9a-f]{64}', baseline_token or ''):
                raise DeploymentError('transaction binding requires an ID and baseline token')
            if (self.state_file.parent / 'deploy-transactions' / (transaction_id + '.json')).exists():
                raise DeploymentError('transaction ID has already been used')
            self._requested_transaction = transaction_id
            self._requested_baseline = baseline_token
            self.check_requested_baseline()
        revision = self.resolve(ref)
        pins = self.components(revision)
        self.fetch_all(pins)
        if self.stage_of("tamlinux-packages", revision) != "main" and not self.follows_main(
                "tamlinux-packages", revision):
            # Accept an exact main commit or a Test assembly already accepted for Run.
            acceptances = self.config / "system" / "acceptances"
            accepted = False
            if acceptances.is_dir():
                for path in acceptances.glob("*.json"):
                    try:
                        data = json.loads(path.read_text())
                    except (OSError, ValueError):
                        continue
                    if data.get("assemblyRevision") == revision and data.get("stage") in ("run", "Run", "release"):
                        accepted = True
                        break
            if not accepted:
                raise DeploymentError(
                    f"{revision[:12]} is not on main and has no Run acceptance; "
                    "followers only install accepted or main assemblies"
                )
        self.install(revision, pins, "follow")
        self.status()

    def run(self, ref: str | None = None, untested: bool = False) -> None:
        self.require_consistent()
        installed = self.locked()
        if ref is None:
            revision = installed
            self.git("tamlinux-packages", "fetch", "-q", "origin")
        else:
            try:
                revision = self.resolve(ref)
            except subprocess.CalledProcessError:
                raise DeploymentError(f"no tamlinux-packages commit matches {ref}") from None
        pins = self.components(revision)
        self.fetch_all(pins)
        repos = {"tamlinux-packages": revision, **pins}
        stages = {name: self.stage_of(name, rev) for name, rev in repos.items()}
        needs_install = revision != installed or bool(self.verify(pins, revision))

        if all(stage == "main" for stage in stages.values()):
            if not needs_install:
                print(f"Already running main commit {revision}.")
                return
            # An older or newer main commit: install it; no branch moves.
            self.install(revision, pins, "run")
            print(f"Running main commit {revision}; no promotion needed.")
            self.status()
            return

        unready = sorted(name for name, stage in stages.items() if stage in ("develop", "untracked"))
        if unready:
            listing = ", ".join(f"{name} {repos[name][:12]} ({stages[name]})" for name in unready)
            if not untested:
                raise DeploymentError(f"not tested yet: {listing}. To run it anyway, "
                                      "rerun with --untested.")
            print(f"warning: running untested commits: {listing}", file=sys.stderr)
        blocked = sorted(name for name, stage in stages.items()
                         if stage != "main" and not self.follows_main(name, repos[name]))
        if blocked:
            raise DeploymentError("main cannot fast-forward to: "
                                  + ", ".join(f"{name} {repos[name][:12]}" for name in blocked))

        if needs_install:
            self.install(revision, pins, "run")
        # Components first, so main of tamlinux-packages never pins a
        # component revision that is not on that component's main. An
        # untested commit moves test too, keeping main within test.
        for name in [*sorted(pins), "tamlinux-packages"]:
            if stages[name] == "main":
                continue
            if stages[name] in ("develop", "untracked"):
                self.git(name, "push", "-q", "origin", f"{repos[name]}:refs/heads/test")
            self.git(name, "push", "-q", "origin", f"{repos[name]}:refs/heads/main")
        files = self.update_bom({"packages": revision, "tamlinux": pins["tamlinux"],
                                 "stage": "run", "generation": self.generation()})
        if files:
            self.record(f"deploy: run tamlinux-packages {revision[:12]}", files)
        self.save_state(dict(self.read_state(), stage="run", packages=revision, components=pins))
        print(f"Promoted tamlinux-packages {revision[:12]} to main.")
        self.status()

    def back(self) -> None:
        self.require_consistent()
        state = self.read_state()
        previous, previous_pin = state.get("previousGeneration"), state.get("previousPin")
        if not previous or not previous_pin:
            raise DeploymentError("no recorded previous deployment")
        target = Path(previous)
        if not str(target).startswith("/nix/store/") or not (target / "activate").is_file():
            raise DeploymentError("previous generation was removed or is invalid")
        current = self.generation()
        current_pin = self.rollback_pin(current)
        # Refuse before changing generations if session state is unavailable.
        # Recheck after activation because it can change during the switch.
        if self.graphical_active():
            self.require_unlocked_sessions()
        self.activation_validators(previous)
        self.transaction(phase='prepared', baselineGeneration=current, baselineAssembly=current_pin,
                         targetGeneration=previous, targetAssembly=previous_pin)
        try:
            self.transaction(phase='activating')
            command(str(target / "activate"))
            restored = self.generation()
            if restored != previous:
                raise DeploymentError("previous generation was not activated")
            if state.get("backedUp"):
                self.restore_home_file_backups(state["backedUp"], target_generation=previous, strict=True)
            self.restart_if_graphical()
            pins = self.components(previous_pin)
            problems = self.verify(pins, previous_pin)
            if problems:
                raise DeploymentError("restored endpoints do not match the previous assembly:\n  " + "\n  ".join(problems))
            self.pin(previous_pin)
            files = [self.pin_file()] + self.update_bom({"packages": previous_pin, "stage": "restored",
                                                      "generation": restored})
            self.record(f"deploy: back to tamlinux-packages {previous_pin[:12]}", files)
            self.save_state({"stage": "restored", "packages": previous_pin,
                             "generation": restored, "components": pins,
                             "previousGeneration": current,
                             "previousPin": current_pin})
            self.transaction(phase='complete')
            self.status()
        except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as exc:
            self.transaction(phase='partial', deploymentError=str(exc))
            raise DeploymentError(
                f"rollback may be incomplete after activation was attempted: {exc}; "
                "inspect tam-deploy status, the active generation and the consumer lock before retrying"
            ) from exc


USAGE = ("usage: tam-deploy status [--json] | preflight <assembly> [--json] | "
         "conflicts <generation> [--json] | reconcile [--digest HASH] | "
         "init [revision] [--test] | test [revision] | run [revision] [--untested] | "
         "follow <revision> [--transaction ID --expect-baseline SHA256] | recover ID | back")


def parse(argv: list[str]) -> tuple[str, list, dict] | None:
    if not argv:
        return None
    name, rest = argv[0], argv[1:]
    if name in ("status", "back") and not rest:
        return name, [], {}
    if name == 'status' and rest == ['--json']:
        return name, [], {'json_output': True}
    if name == 'preflight':
        flags = [a for a in rest if a.startswith('-')]
        args = [a for a in rest if not a.startswith('-')]
        if set(flags) <= {'--json'} and len(args) == 1 and re.fullmatch(r'[0-9a-f]{40}', args[0]):
            return name, args, {}
    if name == 'conflicts':
        flags = [a for a in rest if a.startswith('-')]
        args = [a for a in rest if not a.startswith('-')]
        if set(flags) <= {'--json'} and len(args) == 1 and args[0]:
            return name, args, {'json_output': '--json' in flags}
    if name == 'reconcile':
        if not rest:
            return name, [], {}
        if len(rest) == 2 and rest[0] == '--digest' and re.fullmatch(r'[0-9a-f]{64}', rest[1]):
            return name, [rest[1]], {}
    if name == "test" and len(rest) <= 1 and not any(a.startswith("-") for a in rest):
        return name, rest, {}
    if name == "follow" and len(rest) == 1 and not rest[0].startswith("-"):
        return name, rest, {}
    if name == 'follow' and len(rest) == 5 and not rest[0].startswith('-'):
        options = dict(zip(rest[1::2], rest[2::2]))
        if (set(options) == {'--transaction', '--expect-baseline'}
                and TRANSACTION_ID.fullmatch(options['--transaction'])
                and re.fullmatch(r'[0-9a-f]{64}', options['--expect-baseline'])):
            return name, [rest[0]], {'transaction_id': options['--transaction'],
                                     'baseline_token': options['--expect-baseline']}
    if name == 'recover' and len(rest) == 1 and TRANSACTION_ID.fullmatch(rest[0]):
        return name, rest, {}
    if name == "run":
        flags = [a for a in rest if a.startswith("-")]
        args = [a for a in rest if not a.startswith("-")]
        if set(flags) <= {"--untested"} and len(args) <= 1:
            return name, args, {"untested": "--untested" in flags}
    if name == "init":
        flags = [a for a in rest if a.startswith("-")]
        args = [a for a in rest if not a.startswith("-")]
        if set(flags) <= {"--test"} and len(args) <= 1:
            return name, args, {"test": "--test" in flags}
    return None


def main(argv: list[str]) -> int:
    if argv in (["--help"], ["-h"]):
        print(__doc__)
        return 0
    parsed = parse(argv)
    if parsed is None:
        print(USAGE, file=sys.stderr)
        return 2
    name, args, options = parsed
    try:
        deployment = Deployment()
        lock = deployment.mutation_lock() if name != 'status' else nullcontext()
        with lock:
            getattr(deployment, name)(*args, **options)
            if name == 'preflight':
                if hasattr(deployment, '_prepared_bundle_report'):
                    print(json.dumps(deployment._prepared_bundle_report))
                else:
                    print(json.dumps({'generation': deployment._prepared_generation,
                                  'baselineGeneration': deployment.read_state()['generation'],
                                  'conflicts': getattr(deployment, '_prepared_conflicts', [])}))
    except (OSError, ValueError, KeyError, subprocess.CalledProcessError, DeploymentError) as exc:
        print(f"tam-deploy: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
