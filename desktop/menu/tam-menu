#!/bin/bash

# tam-menu — open, close, or reload the command menu in the Tamlinux shell.
#
#   tam-menu [toggle|summon|close|refresh|ping|status] [route]
#
# Ported from omarchy 4.0.4 (omarchy-menu) for plan 18 R4.7; it calls the
# host's menu target through tam-shell instead of omarchy-shell.
#
# Copyright (c) David Heinemeier Hansson
#
