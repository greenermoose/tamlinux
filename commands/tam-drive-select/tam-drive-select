#!/bin/bash

# tam-drive-select — select a drive from a list with info that includes space
# and brand.
#
#   tam-drive-select [/dev/drive...]
#
# Ported from Omarchy 4.0.4 (omarchy-drive-select) for plan 18 R4.15i.
# Changed: the info for each drive comes from tam-drive-info. Update → Drive
# Encryption (tam-drive-password) and the Bash `drives` function use it to pick
# the drive.

