# Export the current theme's gum styling so gum widgets match the active theme
# even after a theme switch (the inherited environment is captured at login).
gum_env="${XDG_STATE_HOME:-$HOME/.local/state}/tamlinux/current/theme/gum_env.lua"
if [[ -f $gum_env ]]; then
  while IFS=$'\t' read -r gum_key gum_value; do
    [[ -n $gum_key && -n $gum_value ]] && export "$gum_key=$gum_value"
  done < <(awk -F'"' '/hl\.env\("[A-Z0-9_]+", "[^"]+"\)/ { print $2 "\t" $4 }' "$gum_env")
fi
unset gum_env gum_key gum_value

if (($# == 0)); then
  echo "Usage: tam-launch-floating-terminal-with-presentation <command> [args...]" >&2
  exit 1
fi

# A single argument is the existing shell-expression interface used by menus.
# Multiple arguments are an argv interface; never concatenate their contents.
if (($# == 1)); then
  mode=expression
else
  mode=argv
fi
exec setsid uwsm-app -- xdg-terminal-exec --app-id=org.tamlinux.terminal --title=Tamlinux -e bash -c '
  tam-show-logo
  mode=$1
  shift
  if [[ $mode == expression ]]; then
    bash -c "$1"
  else
    "$@"
  fi
  status=$?
  if ((status != 130)); then tam-show-done; fi
  exit "$status"
' tamlinux-presentation "$mode" "$@"
