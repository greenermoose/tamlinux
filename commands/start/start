# ANSI styling helpers (disabled when stdout is not a tty or NO_COLOR is set)
USE_COLOR = sys.stdout.isatty() and "NO_COLOR" not in os.environ and os.environ.get("TERM") != "dumb"

def _c(seq: str, text: str) -> str:
    return f"\033[{seq}m{text}\033[0m" if USE_COLOR else text

def bold(text: str) -> str:
    return _c("1", text)

def dim(text: str) -> str:
    return _c("2", text)

def green(text: str) -> str:
    return _c("32", text)

def yellow(text: str) -> str:
    return _c("33", text)

def cyan(text: str) -> str:
    return _c("36", text)

