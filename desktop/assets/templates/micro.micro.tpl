# Tamlinux generated scheme. Personal Micro schemes remain independent.
color-link default "{{ foreground }},{{ background }}"
color-link comment "{{ muted }},{{ background }}"
color-link identifier "{{ cyan }},{{ background }}"
# Shift these shades toward text so their 256-colour approximations remain
# readable as well as their true-colour values.
color-link constant "{{ mix yellow foreground 50% }},{{ background }}"
color-link statement "{{ mix green foreground 50% }},{{ background }}"
color-link symbol "{{ foreground }},{{ background }}"
color-link preproc "{{ blue }},{{ background }}"
color-link type "{{ mix green foreground 50% }},{{ background }}"
color-link special "{{ magenta }},{{ background }}"
color-link error "bold {{ red }},{{ background }}"
color-link todo "bold {{ mix yellow foreground 50% }},{{ background }}"
color-link selection "{{ selection_foreground }},{{ mix selection_background foreground 50% }}"
color-link hlsearch "{{ selection_foreground }},{{ mix selection_background foreground 50% }}"
color-link statusline "{{ background }},{{ foreground }}"
color-link tabbar "{{ background }},{{ foreground }}"
color-link line-number "{{ muted }},{{ background }}"
color-link current-line-number "{{ foreground }},{{ background }}"
color-link gutter-error "{{ red }},{{ background }}"
color-link gutter-warning "{{ mix yellow foreground 50% }},{{ background }}"
color-link message "{{ foreground }},{{ background }}"
color-link error-message "{{ red }},{{ background }}"
color-link match-brace "{{ selection_foreground }},{{ mix selection_background foreground 50% }}"
