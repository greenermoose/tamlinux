#!/usr/bin/python3 -I
"""Run the whole tamlinux test suite from a clean clone and report what it found.

    tests/check-all [--rev REVISION] [--proofs] [--report FILE]

Each unit runs alone with a time limit: every file in tests, make check
in every command, and the headless check-panels and check-theme. Uncommitted
edits are not tested, and session variables are removed, so a result does not
depend on the checkout or on running inside a desktop session.

It runs only when asked. Exit status: 0 passed, 1 a unit failed or a test left
a core dump, 2 the run itself could not start.

--proofs also enables the opt-in proofs. They start real programs under private
headless compositors, and a program may crash and leave a core dump, so warn
whoever is at the machine first. check-live is never run here: it drives the
real screens.
"""

from __future__ import annotations

import argparse
from concurrent.futures import FIRST_COMPLETED, ThreadPoolExecutor, wait
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import threading
import time

UNIT_LIMIT_SECONDS = 300
TAIL_LINES = 12
COREDUMP_MESSAGE_ID = "fc2e22bc6ee647b6b90729ab34a250b1"
COREDUMP_SETTLE_SECONDS = 2
SESSION_PREFIXES = ("TAMLINUX_", "HYPRLAND_", "WAYLAND_", "QT_", "QML", "SWAY", "WLR_", "XDG_SESSION_")
SESSION_NAMES = {"DISPLAY", "XAUTHORITY", "XDG_CURRENT_DESKTOP", "XDG_SEAT", "XDG_VTNR", "I3SOCK"}
PROOF_FLAGS = {"TAMLINUX_GTK_PROOF": "1", "TAMLINUX_DCONF_PROOF": "1"}
SKIP_LINE = re.compile(r"\.\.\. skipped (['\"])(?P<reason>.*)\1$")
SKIP_COUNT = re.compile(r"^(?:OK|FAILED) \(.*skipped=(?P<count>\d+)")


def clean_environment(environ, proofs=False):
    """Copy the environment without anything that belongs to a desktop session."""
    env = {name: value for name, value in environ.items()
           if name not in SESSION_NAMES and not name.startswith(SESSION_PREFIXES)}
    if proofs:
        env.update(PROOF_FLAGS)
    return env


def discover_units(clone):
    """Return (kind, name, directory, argv) for every unit in a checkout."""
    clone = Path(clone)
    units = []
    for path in sorted((clone / "tests").glob("test_*.py")):
        units.append(("desktop", path.stem, clone,
                      [sys.executable, "-B", "-m", "unittest", "discover", "-v",
                       "-s", "tests", "-p", path.name]))
    for script in ("check-panels", "check-theme"):
        if (clone / "tests" / script).is_file():
            units.append(("check", script, clone, [f"tests/{script}"]))
    for path in sorted((clone / "src/commands").glob("*/Makefile")):
        units.append(("command", path.parent.name, path.parent, ["make", "check"]))
    return units


def parse_skips(output):
    """Return skip reasons, naming any that the runner's output did not show."""
    reasons = [match["reason"] for match in map(SKIP_LINE.search, output.splitlines()) if match]
    counted = sum(int(match["count"]) for match in map(SKIP_COUNT.match, output.splitlines()) if match)
    reasons.extend(["reason not shown"] * max(0, counted - len(reasons)))
    return reasons


def run_unit(unit, env, limit=UNIT_LIMIT_SECONDS):
    kind, name, directory, argv = unit
    started = time.monotonic()
    try:
        done = subprocess.run(argv, cwd=directory, env=env, stdin=subprocess.DEVNULL,
                              stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                              start_new_session=True, text=True, errors="replace", timeout=limit)
        code, output = done.returncode, done.stdout
    except subprocess.TimeoutExpired as expired:
        partial = expired.stdout or ""
        if isinstance(partial, bytes):
            partial = partial.decode(errors="replace")
        code, output = "timeout", partial + f"\nstopped after {limit} seconds\n"
    return {"kind": kind, "name": name, "result": code,
            "seconds": round(time.monotonic() - started, 1),
            "skips": parse_skips(output),
            "tail": output.splitlines()[-TAIL_LINES:] if code != 0 else []}


def own_cgroup():
    try:
        return Path("/proc/self/cgroup").read_text().strip().rpartition("::")[2]
    except OSError:
        return None


def core_dumps_since(epoch, cgroup):
    """Return (ours, elsewhere) from the journal, or (None, None) if it cannot be read."""
    time.sleep(COREDUMP_SETTLE_SECONDS)
    try:
        done = subprocess.run(["journalctl", "--no-pager", "-o", "json", f"--since=@{int(epoch)}",
                               f"MESSAGE_ID={COREDUMP_MESSAGE_ID}"],
                              capture_output=True, text=True, timeout=30)
    except (OSError, subprocess.TimeoutExpired):
        return None, None
    if done.returncode != 0:
        return None, None
    ours, elsewhere = [], []
    for line in done.stdout.splitlines():
        entry = json.loads(line)
        record = {"pid": entry.get("COREDUMP_PID"), "exe": entry.get("COREDUMP_EXE"),
                  "signal": entry.get("COREDUMP_SIGNAL_NAME")}
        (ours if entry.get("COREDUMP_CGROUP") == cgroup else elsewhere).append(record)
    return ours, elsewhere


def clean_clone(repo, revision, parent):
    """Make a private checkout of one revision and return (path, full revision)."""
    git = ["git", "-c", "advice.detachedHead=false"]
    full = subprocess.run(git + ["-C", str(repo), "rev-parse", "--verify", f"{revision}^{{commit}}"],
                          capture_output=True, text=True, check=True).stdout.strip()
    clone = Path(parent) / "tamlinux"
    subprocess.run(git + ["clone", "-q", "--shared", "--no-checkout", str(repo), str(clone)], check=True)
    subprocess.run(git + ["-C", str(clone), "checkout", "-q", full], check=True)
    return clone, full


def summarize(report, stream=sys.stdout):
    failed = [unit for unit in report["units"] if unit["result"] != 0]
    print(f"\nrevision {report['revision']}", file=stream)
    print(f"{len(report['units'])} units, {len(failed)} failed, "
          f"{report['seconds']:.0f} seconds", file=stream)
    for unit in failed:
        print(f"\nFAILED {unit['kind']} {unit['name']} ({unit['result']})", file=stream)
        for line in unit["tail"]:
            print(f"  {line}", file=stream)
    skips = {}
    for unit in report["units"]:
        for reason in unit["skips"]:
            skips.setdefault((unit["name"], reason), 0)
            skips[(unit["name"], reason)] += 1
    if skips:
        print(f"\nskipped {sum(skips.values())}:", file=stream)
        for (name, reason), count in sorted(skips.items()):
            print(f"  {count} in {name}: {reason}", file=stream)
    if report["coreDumps"] is None:
        print("\ncore dumps: unknown, the journal could not be read", file=stream)
    else:
        print(f"\ncore dumps left by this run: {len(report['coreDumps'])}", file=stream)
        for core in report["coreDumps"]:
            print(f"  {core['signal']} {core['exe']} (PID {core['pid']})", file=stream)
        if report["coreDumpsElsewhere"]:
            print(f"core dumps elsewhere on this machine meanwhile: {len(report['coreDumpsElsewhere'])}",
                  file=stream)
    print("PASSED" if report["passed"] else "NOT PASSED", file=stream)


def usable_libtam_prefix(prefix):
    root = Path(prefix)
    return (root / "include/tam.h").is_file() and (root / "lib/pkgconfig/libtam-display.pc").is_file()


def prepare_libtam(repo, clone, parent, env):
    """Ensure C command checks have usable libtam headers and pkg-config metadata."""
    if env.get("LIBTAM_PREFIX") and usable_libtam_prefix(env["LIBTAM_PREFIX"]):
        return Path(env["LIBTAM_PREFIX"])
    probe = subprocess.run(["pkg-config", "--variable=prefix", "libtam-display"],
                           env=env, capture_output=True, text=True)
    if probe.returncode == 0 and probe.stdout.strip() and usable_libtam_prefix(probe.stdout.strip()):
        return None
    lock = clone / "components.lock"
    if not lock.is_file():
        return None
    revision = None
    for line in lock.read_text(encoding="utf-8").splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[0] == "libtam":
            revision = parts[1]
            break
    if not revision:
        return None
    arch = os.uname().machine
    cache_key = hashlib.sha256("\0".join(("v2", "libtam", revision, arch)).encode()).hexdigest()[:16]
    cached = repo / "scratch/source-install/cache/libtam" / cache_key
    if usable_libtam_prefix(cached):
        return cached
    libtam_repo = repo.parent / "libtam"
    if not (libtam_repo / ".git").exists():
        return None
    src = Path(parent) / "libtam-src"
    prefix = Path(parent) / "libtam"
    src.mkdir()
    with tempfile.TemporaryFile() as archive:
        subprocess.run(["git", "-C", str(libtam_repo), "archive", revision],
                       stdout=archive, check=True)
        archive.seek(0)
        with tarfile.open(fileobj=archive) as tree:
            tree.extractall(src, filter="data")
    jobs = f"-j{os.cpu_count() or 2}"
    subprocess.run(["make", "-C", str(src), jobs, "install", "install-display", "install-session",
                    f"PREFIX={prefix}"], env=env, stdout=subprocess.DEVNULL, check=True)
    return prefix if usable_libtam_prefix(prefix) else None


PRIORITY_UNITS = {
    ("desktop", "test_journal"): 0,
    ("command", "tam-monitor"): 1,
    ("desktop", "test_theme_ownership"): 2,
    ("command", "tam-shell"): 3,
    ("command", "tam-theme-set"): 4,
    ("desktop", "test_panel_models"): 5,
    ("check", "check-theme"): 6,
    ("check", "check-panels"): 7,
}

SHARDED_UNITS = {
    ("desktop", "test_theme_ownership"): 4,
}

COMPOSITOR_UNITS = frozenset({
    ("check", "check-panels"),
    ("check", "check-theme"),
    ("desktop", "test_start_menu"),
    ("desktop", "test_menu_jsonc"),
})


def run_sharded_unittest(unit, env, shards, limit=UNIT_LIMIT_SECONDS):
    """Run a large unittest file across parallel shard processes as one report unit."""
    kind, name, directory, _ = unit
    started = time.monotonic()
    list_code = (
        "import sys, unittest\n"
        "sys.path.insert(0, 'tests')\n"
        f"s = unittest.defaultTestLoader.loadTestsFromName({name!r})\n"
        "def walk(x):\n"
        "  for i in x:\n"
        "    if isinstance(i, unittest.TestSuite): yield from walk(i)\n"
        "    else: yield i.id()\n"
        "print('\\n'.join(walk(s)))\n"
    )
    listed = subprocess.run([sys.executable, "-B", "-c", list_code], cwd=directory, env=env,
                            stdin=subprocess.DEVNULL, capture_output=True, text=True,
                            start_new_session=True, timeout=30)
    if listed.returncode != 0:
        return run_unit(unit, env, limit=limit)
    test_ids = [line.strip() for line in listed.stdout.splitlines() if line.strip()]
    if len(test_ids) < shards:
        return run_unit(unit, env, limit=limit)
    buckets = [test_ids[i::shards] for i in range(shards)]
    shard_env = dict(env)
    shard_env["PYTHONPATH"] = f"{directory / 'tests'}:{shard_env['PYTHONPATH']}" if shard_env.get("PYTHONPATH") else str(directory / "tests")
    outputs = []
    code = 0
    with ThreadPoolExecutor(max_workers=shards) as pool:
        futs = [
            pool.submit(subprocess.run, [sys.executable, "-B", "-m", "unittest", "-v", *bucket],
                        cwd=directory, env=shard_env, stdin=subprocess.DEVNULL,
                        stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                        start_new_session=True, text=True, errors="replace", timeout=limit)
            for bucket in buckets if bucket
        ]
        for fut in futs:
            try:
                done = fut.result()
                outputs.append(done.stdout)
                if done.returncode != 0 and code == 0:
                    code = done.returncode
            except subprocess.TimeoutExpired as expired:
                partial = expired.stdout or ""
                if isinstance(partial, bytes):
                    partial = partial.decode(errors="replace")
                outputs.append(partial + f"\nstopped after {limit} seconds\n")
                code = "timeout"
    combined = "\n".join(outputs)
    return {"kind": kind, "name": name, "result": code,
            "seconds": round(time.monotonic() - started, 1),
            "skips": parse_skips(combined),
            "tail": combined.splitlines()[-TAIL_LINES:] if code != 0 else []}


def run_units(units, env, jobs):
    """Run units in parallel, ordering command tam-launch-journal after desktop test_journal."""
    total = len(units)
    results = [None] * total
    if jobs <= 1 or total <= 1:
        for idx, unit in enumerate(units):
            result = run_unit(unit, env)
            results[idx] = result
            if result["result"] != 0:
                print(f"[{idx + 1}/{total}] FAILED {unit[0]} {unit[1]}", flush=True)
        return results

    compositor_gate = threading.Semaphore(1)

    def dispatch(unit):
        key = (unit[0], unit[1])
        shards = SHARDED_UNITS.get(key)
        if shards and jobs >= 4:
            return run_sharded_unittest(unit, env, min(shards, jobs))
        if key in COMPOSITOR_UNITS:
            with compositor_gate:
                return run_unit(unit, env)
        return run_unit(unit, env)

    has_journal_desktop = any(u[0] == "desktop" and u[1] == "test_journal" for u in units)
    deferred = []
    ready = []
    for idx, unit in enumerate(units):
        if has_journal_desktop and unit[0] == "command" and unit[1] == "tam-launch-journal":
            deferred.append((idx, unit))
        else:
            ready.append((idx, unit))
    ready.sort(key=lambda item: (PRIORITY_UNITS.get((item[1][0], item[1][1]), 100), item[0]))

    workers = max(1, min(jobs, total))
    with ThreadPoolExecutor(max_workers=workers) as pool:
        pending = {pool.submit(dispatch, unit): (idx, unit) for idx, unit in ready}
        while pending:
            done_set, _ = wait(pending, return_when=FIRST_COMPLETED)
            for future in done_set:
                idx, unit = pending.pop(future)
                result = future.result()
                results[idx] = result
                if result["result"] != 0:
                    print(f"[{idx + 1}/{total}] FAILED {unit[0]} {unit[1]}", flush=True)
                if unit[0] == "desktop" and unit[1] == "test_journal" and deferred:
                    for d_idx, d_unit in deferred:
                        pending[pool.submit(dispatch, d_unit)] = (d_idx, d_unit)
                    deferred.clear()
    return results


def main(argv=None):
    os.umask(0o022)
    parser = argparse.ArgumentParser(description="Run the whole tamlinux test suite from a clean clone.")
    parser.add_argument("--rev", default="HEAD", help="revision to test (default: HEAD)")
    parser.add_argument("--proofs", action="store_true", help="also enable the opt-in proofs")
    parser.add_argument("--report", type=Path, help="write the results to this JSON file")
    parser.add_argument("-j", "--jobs", type=int, default=os.cpu_count() or 1,
                        help="parallel worker count (default: CPU count)")
    args = parser.parse_args(argv)
    repo = Path(__file__).resolve().parents[1]
    started, epoch = time.monotonic(), time.time()
    with tempfile.TemporaryDirectory(prefix="tamlinux-check-all-") as parent:
        try:
            clone, revision = clean_clone(repo, args.rev, parent)
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"check-all: cannot check out {args.rev}: {error}", file=sys.stderr)
            return 2
        env = clean_environment(os.environ, args.proofs)
        env.pop("PWD", None)
        env["TAM_CHECK_ALL"] = "1"
        try:
            libtam = prepare_libtam(repo, clone, parent, env)
        except (OSError, subprocess.CalledProcessError) as error:
            print(f"check-all: cannot prepare libtam: {error}", file=sys.stderr)
            return 2
        if libtam is not None:
            env["LIBTAM_PREFIX"] = str(libtam)
            existing = env.get("PKG_CONFIG_PATH", "")
            env["PKG_CONFIG_PATH"] = f"{libtam / 'lib/pkgconfig'}:{existing}" if existing else str(libtam / "lib/pkgconfig")
        units = discover_units(clone)
        results = run_units(units, env, max(1, args.jobs))
    ours, elsewhere = core_dumps_since(epoch, own_cgroup())
    report = {"revision": revision, "proofs": args.proofs, "units": results,
              "seconds": time.monotonic() - started, "coreDumps": ours,
              "coreDumpsElsewhere": elsewhere,
              "passed": bool(results) and all(unit["result"] == 0 for unit in results) and not ours}
    summarize(report)
    if args.report:
        args.report.write_text(json.dumps(report, indent=1) + "\n", encoding="utf-8")
    return 0 if report["passed"] else 1


if __name__ == "__main__":
    sys.exit(main())
